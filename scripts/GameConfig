-- Fusion (phase 2, replaces dust-evolution): combine reqByTier[t] copies of a
-- form into ONE copy of the next form (0 BASE -> 1 ASCENDED -> 2 CELESTIAL).
-- Same requirement for both stages: a SECRET final form is 9 copies total.
GameConfig.Fusion = {
	reqByTier = { 10, 10, 7, 5, 3 }, -- COMMON..SECRET, per fusion stage
}

-- Effective copies needed for one fusion step: Forge Mastery (forgeReqAdd,
-- survives Rebirth) discounts COMMON/RARE recipes only, floor 8. Server
-- doCombine/CombineAll AND every client forge surface must use this — the
-- button, the count label and the actual consume can never disagree.
function GameConfig.forgeReq(get, tier)
	local req = GameConfig.Fusion.reqByTier[tier]
	if not req then return nil end
	if get and tier <= 2 then
		req = math.max(8, req + GameConfig.statTotal(get, "forgeReqAdd"))
	end
	return req
end

-- Star Dust sink: craft +1 BASE copy of any DISCOVERED planet.
