-- id -> node lookup (built once).
GameConfig.TreeById = {}
for i = 1, #GameConfig.UpgradeTree do
	local node = GameConfig.UpgradeTree[i]
	GameConfig.TreeById[node.id] = node
end

function GameConfig.treeCost(node, lv)
	return math.floor(node.base * node.ratio ^ lv + 0.5)
end

-- ========================================================================
-- ZONES / REBIRTH
-- ========================================================================

GameConfig.Zones = {
	reqs = { 0, 1, 2, 4, 6, 9, 13, 18 }, -- rebirths required per zone index
	mults = { 1, 2, 4, 8, 16, 32, 64, 128 }, -- ticket multiplier per zone
}

GameConfig.MaxRebirth = 50
GameConfig.RebirthBase = 2000
GameConfig.RebirthBands = { -- step s (1-based) uses the first band with s <= maxStep
	{ maxStep = 1, ratio = 2.5 },
	{ maxStep = 5, ratio = 3.5 },
	{ maxStep = 10, ratio = 2.6 },
	{ maxStep = 18, ratio = 1.7 },
	{ maxStep = 25, ratio = 1.4 },
	{ maxStep = 35, ratio = 1.2 },
	{ maxStep = 49, ratio = 1.28 },
}
GameConfig.RebirthCosts = {} -- [n+1] = cost to rebirth when Rebirth == n
do
	local cost = GameConfig.RebirthBase
	for s = 0, GameConfig.MaxRebirth - 1 do
		GameConfig.RebirthCosts[s + 1] = math.floor(cost + 0.5)
		local r = 1.28
		for i = 1, #GameConfig.RebirthBands do
			local band = GameConfig.RebirthBands[i]
			if (s + 1) <= band.maxStep then
				r = band.ratio
				break
			end
		end
		cost = cost * r
	end
end

function GameConfig.rebirthCost(n)
	if n >= GameConfig.MaxRebirth then
		return nil -- maxed out
	end
	return GameConfig.RebirthCosts[n + 1]
end

function GameConfig.rebirthTicketMult(n)
	return 1 + 0.75 * n
end

-- The PERSISTENT ticket multiplier a raw reward is scaled by: zone x throne
-- x tree x rebirth x TicketMult attr x group perk. Transient terms (fever,
-- timed boosts, the 2x pass) stay in creditTickets on top of this — labels
-- use this so a claim never pays LESS than its label.
function GameConfig.ticketScale(get, zoneIndex)
	local throne = GameConfig.throneOf(get("ThroneLevel") or 0)
	return (GameConfig.Zones.mults[zoneIndex] or 1)
		* (throne and throne.tixMult or 1)
		* GameConfig.ticketTreeMult(get)
		* GameConfig.rebirthTicketMult(get("Rebirth") or 0)
		* (get("TicketMult") or 1)
		* (get("GroupPerk") and 1.25 or 1)
end

