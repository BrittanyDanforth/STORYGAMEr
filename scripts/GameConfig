	costByTier = { 25, 75, 300, 1500, 6000 }, -- COMMON..SECRET
}

-- Display prefixes by form (index = form + 1): "ASCENDED CUSTARD" etc.
GameConfig.FormNames = { "", "ASCENDED", "CELESTIAL" }

-- Payout of a base-payout ball at form 0/1/2.
function GameConfig.fusionPayout(base, form)
	if form == 1 then
		return math.ceil(base * 1.5)
	elseif form == 2 then
		return math.ceil(base * 2.5)
	end
	return base
end

