--[[
	GameConfig — single source of truth for ALL shared game data + formulas.
	ModuleScript in ReplicatedStorage, required by ServerInit (authoritative)
	and PusherClient (display). PLAIN LUA ONLY: no `+=`, no `continue` — this
	file may be executed by the offline theme-lab pipeline alongside
	PusherMachine.luau.

	Contract doc: docs/specs/final-contract.md. Do not re-declare any of these
	tables elsewhere — the whole point is that client and server can never
	drift again.
]]

local GameConfig = {}

-- ========================================================================
-- UPGRADE TREE
-- Node contract:
--   id       = player attribute name (int level, absent = 0)
--   cost(lv) = math.floor(base * ratio^lv + 0.5), lv = CURRENT level
--   effect   = { key, perLv } -> server contribution = perLv * lv
--   requires = { {id, lv}, ... } -> node renders as "?" until ALL satisfied
--   gate     = { rebirth = N } or { zone = N } -> visible but locked until met
--   pos      = px on the 1400x900 pannable canvas (START hub at 700,450)
-- ========================================================================

-- Canvas grew 1820x1400 -> 2100x1480 for the DROP LAB / DEEP LUCK /
-- COLLECTION / LANES & CORE expansion regions (right and down only, so
-- every existing node keeps its position).
GameConfig.TreeCanvas = { w = 2100, h = 1480, start = { x = 910, y = 585 } }

