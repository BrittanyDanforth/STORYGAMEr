}

-- ======================================================================
-- DROPPER SWEEP — the carriage sweeps on rails by itself; dropping is a
-- TIMING game. Deterministic from server time + the player's own
-- SweepQuick attribute, so the client draw, the server's validation
-- clamp, and server-side auto-drop all agree without any sync traffic.
-- Per-player: each client draws the carriage from ITS OWN attributes.
-- ======================================================================
GameConfig.Sweep = {
	limit = 4.15, -- carriage travel (head edge clears the hanger uprights at +-4.91)
	period = 5.2, -- seconds per full left-right-left cycle at STEADY
	quickMult = 1.6, -- QUICK mode: faster sweep, tighter timing, faster lane coverage
	tolerance = 1.2, -- server accepts a drop this far from its own sample (latency slack)
}
function GameConfig.sweepX(now, quick)
	local s = GameConfig.Sweep
	local period = s.period / (quick and s.quickMult or 1)
	return s.limit * math.sin((now % period) / period * 2 * math.pi)
end

