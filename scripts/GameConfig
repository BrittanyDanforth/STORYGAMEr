-- ========================================================================
-- SHARED FORMULAS
-- `get(name)` returns the player attribute (or nil). Client passes a getter
-- over LocalPlayer; server passes one over the Player instance. These are
-- THE formulas — display and simulation can never disagree.
-- ========================================================================

-- Sum of perLv * level over all tree nodes with the given effect key.
function GameConfig.statTotal(get, key)
	local total = 0
	for i = 1, #GameConfig.UpgradeTree do
		local node = GameConfig.UpgradeTree[i]
		if node.effect and node.effect.key == key then
			local lv = get(node.id) or 0
			if lv > 0 then
				total = total + node.effect.perLv * lv
			end
		end
	end
	return total
end

function GameConfig.throneOf(level)
	return GameConfig.Spine[level] -- nil when level 0
end

-- FREE luck L (rolls AND index display): tree + pity heat + throne + perks.
-- The PAID boost is NOT in here any more (phase 2): it is a tier-scoped
-- magnitude B, read via boostMagOf and passed to rollOnce/planetChances as a
-- separate argument (PusherMachine caps it per tier).
function GameConfig.computeLuck(get)
	local base = 1 + GameConfig.statTotal(get, "luckAdd")
	local pityPct = GameConfig.statTotal(get, "pityLuckPct")
	local pityMult = 1 + pityPct * (get("Pity") or 0)
	local throne = GameConfig.throneOf(get("ThroneLevel") or 0)
	local throneLuck = throne and throne.luckMult or 1
	local lm = get("LuckMult") or 1
	local gp = (get("GroupPerk") and 1.25) or 1
	return base * pityMult * throneLuck * lm * gp
end

-- Roll luck: computeLuck plus the ROLL branch bonus. Used by rollOnce AND the Index.
-- feverOn: pass whether METEOR RUSH is running (server: feverActive();
-- client: its fever mirror) so Fever Fortune only counts during the rush.
-- The stack/streak attrs (MomentumStacks / CommonStreak) are display mirrors
-- maintained by the server's roll resolver — same numbers both sides.
function GameConfig.computeRollLuck(get, feverOn)
	return GameConfig.computeLuck(get)
		* (1 + GameConfig.statTotal(get, "rollLuckPct"))
		* (1 + GameConfig.statTotal(get, "momentumPct") * (get("MomentumStacks") or 0))
		* (1 + GameConfig.statTotal(get, "dryLuckPct") * math.min(get("CommonStreak") or 0, 25))
		* (feverOn and (1 + GameConfig.statTotal(get, "feverLuckAdd")) or 1)
end

-- Personal paid boost magnitude B (0 = none). LuckBoost stores 100/1000/3500.
-- Callers take max() with the server-wide SrvLuckMag window themselves
-- (strongest B wins — same-type boosts never multiply).
function GameConfig.boostMagOf(get)
	local untilT = get("LuckBoostUntil") or 0
	if untilT > workspace:GetServerTimeNow() then
		return get("LuckBoost") or 0
	end
	return 0
end

-- Product of the three ticket branches: (1+a)(1+b)(1+c).
function GameConfig.ticketTreeMult(get)
	return (1 + GameConfig.statTotal(get, "ticketPct1"))
		* (1 + GameConfig.statTotal(get, "ticketPct2"))
		* (1 + GameConfig.statTotal(get, "ticketPct3"))
end

-- Seconds between allowed drops (before the QuickCharge window halving).
function GameConfig.dropCooldown(get)
	return math.max(0.10, 0.22 + GameConfig.statTotal(get, "dropCooldownAdd"))
end

function GameConfig.dropCount(get)
	return math.min(5, 1 + GameConfig.statTotal(get, "dropCountAdd"))
end

function GameConfig.autoRollInterval(get)
	return math.max(GameConfig.Roll.minInterval,
		GameConfig.Roll.autoInterval + GameConfig.statTotal(get, "autoRollAdd"))
end

return GameConfig
