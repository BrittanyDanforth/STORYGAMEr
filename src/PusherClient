		title.Position = UDim2.new(0, 16, 0, 244)
		title.Size = UDim2.new(1, -32, 0, 44)
		title.TextWrapped = true
		title.ZIndex = 49
		local payLine = label(card, ("PAYS %d PER COLLECT"):format(newPayout or 0),
