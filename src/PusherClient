local function formatCommas(n)
	local s = tostring(math.floor(tonumber(n) or 0))
	local formatted = s:reverse():gsub("(%d%d%d)", "%1,"):reverse()
	return (formatted:gsub("^,", ""))
end

-- K/M/B short form for rank rows 4-25 (podium + pinned YOU stay exact).
local function shortValue(n)
	n = math.floor(tonumber(n) or 0)
	-- T band: rebirth costs pass 12T near the cap; "10049.4B" is not a number
	-- a kid can read.
	if n >= 1e12 then
		return string.format("%.1fT", n / 1e12)
	elseif n >= 1e9 then
		return string.format("%.1fB", n / 1e9)
	elseif n >= 1e6 then
		return string.format("%.1fM", n / 1e6)
	elseif n >= 1e3 then
		return string.format("%.1fK", n / 1e3)
	end
	return tostring(n)
end

local function fmtClock(secs)
	secs = math.max(0, math.floor(secs))
	if secs >= 3600 then
		return string.format("%dh %02dm", secs / 3600, (secs % 3600) / 60)
	end
	return string.format("%dm %02ds", secs / 60, secs % 60)
end

local function fmtShortTime(secs)
	if secs >= 3600 then return math.floor(secs / 3600) .. "H" end
	if secs >= 60 then return math.floor(secs / 60) .. "M" end
	return secs .. "S"
end

