	local function fillNodeCard(def)
		local ui = treeNodes[def.id]
		local state = ui and ui.state or 0
		local lv = player:GetAttribute(def.id) or 0
		if state == 1 then
			-- Hidden "?" node: never leak what it is.
			cardName.Text = "???"
			cardDesc.Text = "Buy the upgrade before this one to reveal it."
		else
			cardName.Text = def.name .. "   Lv " .. lv .. "/" .. def.maxLv
			cardDesc.Text = def.desc or ""
		end
		local buyable = state == 3 or state == 4
		cardBuy.Visible = buyable
		cardState.Visible = not buyable
		if buyable then
			local cost = GameConfig.treeCost(def, lv)
			cardBuyText.Text = (state == 4 and "BUY  " or "NEED  ") .. tostring(cost)
			cardBuyPlate.ImageColor3 = pixelTint(state == 4 and UI_GREEN
				or Color3.fromRGB(120, 60, 60))
		elseif state == 5 then
			cardState.Text = "MAXED OUT"
			cardState.TextColor3 = UI_GOLD
		elseif state == 2 and ui and ui.gateLabel.Text ~= "" then
			cardState.Text = ui.gateLabel.Text
			cardState.TextColor3 = UI_SUB
		else
			cardState.Text = "LOCKED"
			cardState.TextColor3 = UI_SUB
		end
	end
	local function refreshNodeCard()
		local def = cardDef or cheapestNode
		shownDef = def
		if def then
			fillNodeCard(def)
			nodeCard.Visible = true
		else
			nodeCard.Visible = false
		end
	end
	showNodeCard = function(def)
		cardDef = def
		refreshNodeCard()
	end
