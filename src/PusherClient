-- Roll flow (§5). Choreography: windup → accelerate → sustain → decelerate
-- past the mark → snap-back settle, audible rate-limited ticks whose pitch
-- rises through the deceleration, the land pulse on the winning card, THEN
-- the reveal card. The reel is built ONLY after PlanetRolled arrives; the
-- old 2s "Bubblegum" fallback LIE is deleted — no result in 8s just
-- un-spins. `spinning` stays true until the reveal fully finishes, so the
-- auto-roll queue (single slot, newest wins) can never start mid-reveal.
do
	local spinning = false
	local pendingRoll = nil
	local skipRequested = false
	local queuedRoll = nil -- single-slot queue for auto rolls landing mid-reveal
	local startReveal -- forward: needs buildReelTiles/runBallReel below

	local tickSound = Instance.new("Sound")
	tickSound.SoundId = "rbxasset://sounds/button.wav"
	tickSound.Volume = 0.35
	tickSound.Parent = gui
	local winSound = Instance.new("Sound")
	winSound.SoundId = "rbxasset://sounds/electronicpingshort.wav"
	winSound.Volume = 0.5
	winSound.Parent = gui

	-- PlanetRolled(name, oneIn, tier, isAuto, dustGained). Manual rolls feed the
	-- click-started waiter via pendingRoll; auto rolls arrive with no client
	-- request and self-start the (shortened, for commons) reveal.
	if rolledRemote then
		rolledRemote.OnClientEvent:Connect(function(name, oneIn, tier, isAuto, dustGained)
			local won = {
				name = name, oneIn = oneIn, tier = tier or 1,
				auto = isAuto == true, dust = dustGained or 0,
			}
			local key = name .. "|" .. (tier or 1)
			pullCounts[key] = (pullCounts[key] or 0) + 1
			-- A tier-4 pull is the "I could get luckier" moment — pitch luck.
			if won.tier >= 4 and S.pitchOffer then
				S.pitchOffer("Luck100")
			end
			if won.auto then
				-- Cross-guard (loop-forge §4): auto rolls also never start while
				-- the forge cinematic is celebrating — they queue (newest wins)
				-- and the cinematic pokes the queue on cleanup.
				if spinning or (S.isCelebrating and S.isCelebrating()) then
					queuedRoll = won -- newest wins
				elseif startReveal then
					startReveal(won)
				end
			else
				pendingRoll = won
			end
		end)
	end

	-- Forge-cinematic cross-guard hooks (§C guards): the cinematic never
	-- starts mid-spin, and it releases any auto roll it made queue.
	function S.rollerSpinning()
		return spinning
	end
	function S.pokeRollQueue()
		if queuedRoll and not spinning then
			local nextWon = queuedRoll
			queuedRoll = nil
			task.delay(0.35, function()
				if not spinning and not (S.isCelebrating and S.isCelebrating())
					and startReveal then
					startReveal(nextWon)
				end
			end)
		end
	end

	-- Runs once the reveal card has fully closed: only NOW may a queued
	-- auto roll start its own spin.
	local function concludeRoll()
		spinning = false
		if queuedRoll and not (S.isCelebrating and S.isCelebrating()) then
			local nextWon = queuedRoll
			queuedRoll = nil
			task.delay(0.35, function()
				if not spinning and not (S.isCelebrating and S.isCelebrating())
					and startReveal then
					startReveal(nextWon)
				end
			end)
		end
	end

	local function finishRoll(won)
		if won.tier >= 3 then
			winSound.PlaybackSpeed = won.tier >= 4 and 0.7 or 0.9
			winSound:Play()
			goldFlash()
		end
		-- Rarer pulls hold their reveal longer; the "+N DUST" line and the
		-- MAXED badge live on the card itself now.
		local hold = won.tier >= 4 and 2.6 or won.tier == 3 and 1.8
			or (won.auto and 1.0 or 1.4)
		S.showReveal(won, hold, concludeRoll)
	end

	local function runBallReel(won, compressed)
		local winH = reelWindowH()
		local finalY = winH / 2 - TILE_H / 2 - (ROLL_TARGET - 1) * TILE_H
		skipRequested = false

		-- Tick as each card crosses the win line: rate-limited, pitch rising
		-- once the deceleration starts (the slowdown is audible).
		local decelStart = nil
		local lastIdx, lastTickAt = nil, 0
		local tickConn = RunService.Heartbeat:Connect(function()
			local stackY = reelStack.Position.Y.Offset
			local idx = math.floor((winH / 2 - stackY) / TILE_H)
			if idx ~= lastIdx then
				lastIdx = idx
				local nowT = os.clock()
				if nowT - lastTickAt >= 0.03 then
					lastTickAt = nowT
					local pitch = 1.0
					if decelStart then
						pitch = 0.9 + math.clamp((nowT - decelStart) / 1.6, 0, 1) * 0.55
					end
					tickSound.PlaybackSpeed = pitch + math.random() * 0.05
					tickSound:Play()
				end
			end
		end)

		-- Travel plan: sustain length varies (auto commons take a short haul).
		local accelTiles = 3
		local sustainTiles = compressed and 2 or 6 + math.random(0, 4)
		local decelTiles = 9
		local sustainDur = compressed and 0.1 or 0.1 + sustainTiles * 0.045
		local startY = finalY - (accelTiles + sustainTiles + decelTiles) * TILE_H
		reelStack.Position = UDim2.fromOffset(0, startY)

		local windup = TweenService:Create(reelStack,
			TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
			{ Position = UDim2.fromOffset(0, startY - 12) })
		local accel = TweenService:Create(reelStack,
			TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Position = UDim2.fromOffset(0, finalY - (sustainTiles + decelTiles) * TILE_H) })
		local sustain = TweenService:Create(reelStack,
			TweenInfo.new(sustainDur, Enum.EasingStyle.Linear),
			{ Position = UDim2.fromOffset(0, finalY - decelTiles * TILE_H) })
		local decel = TweenService:Create(reelStack,
			TweenInfo.new(1.6, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
			{ Position = UDim2.fromOffset(0, finalY + 14) })
		local settle = TweenService:Create(reelStack,
			TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Position = UDim2.fromOffset(0, finalY) })

		local function waitOrSkip(tween, duration)
			if skipRequested then return end
			tween:Play()
			local waited = 0
			while waited < duration and not skipRequested do
				task.wait(0.05)
				waited = waited + 0.05
			end
			if skipRequested then tween:Cancel() end
		end

		task.spawn(function()
			waitOrSkip(windup, 0.1)
			waitOrSkip(accel, 0.35)
			waitOrSkip(sustain, sustainDur)
			decelStart = os.clock()
			waitOrSkip(decel, 1.6)
			if skipRequested then
				reelStack.Position = UDim2.fromOffset(0, finalY)
			else
				settle:Play()
				settle.Completed:Wait()
			end
			tickConn:Disconnect()
			-- Land pulse: the winning card locks centered and pulses twice.
			if wonCardPulse and wonCardPulse.Parent then
				for _ = 1, 2 do
					local up = TweenService:Create(wonCardPulse,
						TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
						{ Scale = 1.12 })
					up:Play()
					up.Completed:Wait()
					local down = TweenService:Create(wonCardPulse,
						TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
						{ Scale = 1 })
					down:Play()
					down.Completed:Wait()
				end
			end
			task.wait(won.tier >= 4 and 0.4 or 0.15)
			finishRoll(won)
		end)
	end

	-- Shared reveal entry: manual waits use it after RollBall answers; auto
	-- rolls call it straight from the PlanetRolled handler.
	function startReveal(won)
		spinning = true
		spinButtonLabel.Text = "ROLLING..."
		spinButtonLabel.TextSize = 22
		S.setRollBreathing(false)
		buildReelTiles(won.name, won.tier)
		runBallReel(won, won.auto and won.tier <= 2)
	end

	reelWindow.InputBegan:Connect(function(input)
		if spinning and input.UserInputType == Enum.UserInputType.MouseButton1 then
			skipRequested = true
		end
	end)

	-- The reel is never empty: fill it with catalog balls at rest, centered on
	-- the win line, until the first real roll replaces them.
	task.spawn(function()
		task.wait(0.4)
		if not spinning and #reelStack:GetChildren() == 0 then
			buildReelTiles(nil)
			local winH = reelWindowH()
			reelStack.Position = UDim2.fromOffset(0,
				winH / 2 - TILE_H / 2 - (ROLL_TARGET - 1) * TILE_H)
		end
	end)

	-- A resize moves the win line: re-centre the resting reel on it, or the
	-- last winner would drift off the band until the next roll.
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		if spinning then return end
		task.defer(function()
			if spinning then return end
			local winH = reelWindowH()
			reelStack.Position = UDim2.fromOffset(0,
				winH / 2 - TILE_H / 2 - (ROLL_TARGET - 1) * TILE_H)
		end)
	end)

	spinButton.MouseButton1Click:Connect(function()
		if spinning then return end
		if workspace:GetServerTimeNow() < (player:GetAttribute("NextRollAt") or 0) then return end
		spinning = true
		pendingRoll = nil
		spinButtonLabel.Text = "ROLLING..."
		spinButtonLabel.TextSize = 22
		S.setRollBreathing(false)
		if rollRemote then rollRemote:FireServer() end
		task.spawn(function()
			local waited = 0
			while not pendingRoll and waited < 8 do
				task.wait(0.05)
				waited = waited + 0.05
			end
			local won = pendingRoll
			pendingRoll = nil
			if not won then
				-- No result inside 8s: un-spin cleanly. NEVER fake a reveal.
				-- concludeRoll (not a bare spinning=false) so an auto roll
				-- that queued during the dead wait plays now instead of
				-- surfacing as a stale reveal minutes later.
				concludeRoll()
				return
			end
			buildReelTiles(won.name, won.tier)
			runBallReel(won, false)
		end)
	end)

	-- Roll cooldown ticker on the button: text + the draining dark fill +
	-- the breathing ready pulse.
	task.spawn(function()
		while spinButton.Parent do
			if not spinning then
				local now = workspace:GetServerTimeNow()
				local nextAt = player:GetAttribute("NextRollAt") or 0
				if now < nextAt then
					local interval = math.max(GameConfig.autoRollInterval(attrGet), 0.01)
					spinButtonLabel.Text = ("NEXT FREE ROLL IN %ds"):format(math.ceil(nextAt - now))
					spinButtonLabel.TextSize = 15
					spinButtonLabel.Font = Enum.Font.GothamBlack
					S.setRollCooldownFrac(math.clamp((nextAt - now) / interval, 0, 1))
					S.setRollBreathing(false)
				else
					spinButtonLabel.Text = "FREE ROLL"
					spinButtonLabel.TextSize = 24
					spinButtonLabel.Font = Enum.Font.FredokaOne
					S.setRollCooldownFrac(0)
					S.setRollBreathing(true)
				end
			else
				S.setRollCooldownFrac(0)
			end
			-- Honest header readout: the exact luck multiplier the server
			-- rolls with, plus the active paid boost tag.
			if S.luckReadout then
				local mag = currentBoostMag()
				S.luckReadout.Text = ("LUCK x%.2f%s"):format(currentLuck(),
					mag > 0 and (" ·" .. mag .. "X") or "")
			end
			task.wait(0.25)
		end
	end)

	-- 100X LUCK pill (§C): free claim fires SpinLuck exactly like the old
	-- button; after the free claim it becomes the paid entry (odds popup),
	-- or vanishes entirely for PaidRandomRestricted accounts.
	local function refreshLuckPill()
		if not player:GetAttribute("FreeSpinUsed") then
			S.luckState.Text = "CLAIM FREE!"
			luckPill.Visible = true
		elseif player:GetAttribute("PaidRandomRestricted") then
			luckPill.Visible = false
		else
			local luckProd = S.productInfo("Luck100")
			S.luckState.Text = ("R$%d"):format((luckProd and luckProd.robux) or 99)
			luckPill.Visible = true
		end
	end
	luckPill.MouseButton1Click:Connect(function()
		if not player:GetAttribute("FreeSpinUsed") then
			-- Server refuses the free claim until the first roll (tutorial
			-- order) — say so instead of gold-flashing over a silent no-op.
			if player:GetAttribute("TutorialDone") ~= true then
				if S.showToast then S.showToast("ROLL A PLANET FIRST — THEN CLAIM!") end
				return
			end
			if spinRemote then spinRemote:FireServer() end
			goldFlash()
		else
			S.openSpinPopup()
		end
	end)
	player:GetAttributeChangedSignal("FreeSpinUsed"):Connect(refreshLuckPill)
	player:GetAttributeChangedSignal("PaidRandomRestricted"):Connect(refreshLuckPill)
	refreshLuckPill()
	-- Pulse the PLATE while the free claim is still on the table (the
	-- button frame itself is transparent now).
	task.spawn(function()
		local hot = pixelTint(Color3.fromRGB(255, 236, 160))
		local base = pixelTint(UI_GOLD)
		while luckPill.Parent do
			if luckPill.Visible and not player:GetAttribute("FreeSpinUsed") then
				TweenService:Create(S.luckPlate, TweenInfo.new(0.5, Enum.EasingStyle.Quad),
					{ ImageColor3 = hot }):Play()
				task.wait(0.55)
				TweenService:Create(S.luckPlate, TweenInfo.new(0.5, Enum.EasingStyle.Quad),
					{ ImageColor3 = base }):Play()
				task.wait(0.55)
			else
				task.wait(1)
			end
		end
	end)
end

