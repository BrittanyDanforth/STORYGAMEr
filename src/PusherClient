		-- Pixel brick button. `live` bricks get the hover lift + press
		-- squash; dead ones (OWNED / SOON / can't afford) don't react.
		local function brick(parent, sizeU, posU, zindex, face, text, textColor, ink, textSize, live)
			local btn = Instance.new("TextButton")
			btn.Size = sizeU
			btn.Position = posU
			btn.BackgroundTransparency = 1
			btn.Text = ""
			-- promptProduct's SOON flash writes btn.Text; the face label is
			-- what reads, so the button's own text stays invisible.
			btn.TextTransparency = 1
			btn.AutoButtonColor = false
			btn.ZIndex = zindex
			btn.Parent = parent
			local plate = pixelPlate(btn, face, zindex, "btn", 3)
			local txt = label(btn, text, textSize or 16, textColor, Enum.Font.FredokaOne)
			txt.Position = UDim2.new(0, 6, 0, 0)
			txt.Size = UDim2.new(1, -12, 1, -6)
			txt.TextTruncate = Enum.TextTruncate.AtEnd
			if ink then
				txt.TextStrokeColor3 = ink
				txt.TextStrokeTransparency = 0.15
			end
			txt.ZIndex = zindex + 1
			if live then
				local pressScale = Instance.new("UIScale")
				pressScale.Parent = btn
				btn.MouseEnter:Connect(function()
					plate.ImageColor3 = pixelTint(face:Lerp(Color3.new(1, 1, 1), 0.12))
				end)
				btn.MouseLeave:Connect(function()
					plate.ImageColor3 = pixelTint(face)
				end)
				btn.MouseButton1Down:Connect(function()
					TweenService:Create(pressScale,
						TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
						{ Scale = 0.95 }):Play()
				end)
				btn.MouseButton1Up:Connect(function()
					TweenService:Create(pressScale,
						TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
						{ Scale = 1 }):Play()
				end)
			end
			return btn, txt
		end
		-- §3c PRICE BRICK — the ONLY place a price appears. The state is
		-- decided at render time: owned = dim gold "OWNED ✓" (no handler);
		-- SOON = dim, no handler (the PId_<key> attribute is 0 — kids never
		-- tap a live-looking dead button, and a dim one does nothing); else
		-- a green "R$ 99" brick. A product configured after render re-
		-- renders the open shop (the PId_ hook below), so it goes live.
		local function priceBrick(parent, key, sizeU, posU, zindex, owned, textSize)
			if owned then
				return (brick(parent, sizeU, posU, zindex, GOLD_DIM, "OWNED " .. CHECK_GLYPH,
					UI_GOLD, nil, textSize, false))
			end
			local live = S.productConfigured(key)
			local btn = brick(parent, sizeU, posU, zindex,
				live and UI_GREEN or LOCKED,
				live and prodPrice(key, PRICES[key]) or "SOON",
				live and Color3.new(1, 1, 1) or UI_SUB,
				live and GREEN_INK or nil, textSize, live)
			if live then
				btn.MouseButton1Click:Connect(function()
					S.promptProduct(key, btn)
				end)
			end
			return btn
		end
		-- §2 server-scope badge: glowOrb + ring hoop overlapping the family
