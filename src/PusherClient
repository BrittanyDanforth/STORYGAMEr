;(function() -- section scope: own register budget (main chunk hit Luau's 200-local cap live)
	local laneMutateRemote = remotes and remotes:WaitForChild("LaneMutate", 10)
	if not laneMutateRemote then return end
	local LOGICAL_SIGNS = { { 1 }, { 2 }, { 3, 5 }, { 6 }, { 7 } } -- sign 4 = the core assembly
	local MULT_COLOR = {
		[3] = Color3.fromRGB(72, 220, 255),
		[10] = Color3.fromRGB(255, 92, 200),
		[25] = Color3.fromRGB(255, 150, 70),
		[50] = Color3.fromRGB(255, 214, 90),
		[1000] = Color3.fromRGB(255, 244, 214),
	}
	local function multColor(m)
		return MULT_COLOR[m] or Color3.fromRGB(255, 214, 90)
	end
	local tick = Instance.new("Sound")
	tick.SoundId = "rbxasset://sounds/button.wav"
	tick.Volume = 0.35
	tick.Parent = gui
	local slam = Instance.new("Sound")
	slam.SoundId = "rbxasset://sounds/snap.mp3"
	slam.Volume = 0.6
	slam.Parent = gui

	-- Screen event strip (pixel brick, top-center under the Gold Rush chip).
	local eventStrip = Instance.new("Frame")
	eventStrip.AnchorPoint = Vector2.new(0.5, 0)
	eventStrip.Position = UDim2.new(0.5, 0, 0, 78)
	eventStrip.Size = UDim2.fromOffset(340, 34)
	eventStrip.BackgroundTransparency = 1
	eventStrip.Visible = false
	eventStrip.ZIndex = 30
	eventStrip.Parent = gui
	local eventPlate = pixelPlate(eventStrip, Color3.fromRGB(255, 150, 70), 30, "btn", 3)
	local eventText = label(eventStrip, "", 14, Color3.fromRGB(56, 30, 8), Enum.Font.FredokaOne)
	eventText.Size = UDim2.new(1, -12, 1, -8)
	eventText.Position = UDim2.fromOffset(6, 1)
	eventText.ZIndex = 32
	local stripToken = 0
	local function showStrip(text, tint, holdSec)
		stripToken += 1
		local myToken = stripToken
		eventPlate.ImageColor3 = pixelTint(tint)
		eventText.Text = text
		eventStrip.Visible = true
		if holdSec then
			task.delay(holdSec, function()
				if stripToken == myToken then eventStrip.Visible = false end
			end)
		end
	end
	local function hideStrip()
		stripToken += 1
		eventStrip.Visible = false
	end

	-- Paint one physical sign to a multiplier (text + tier color across the
	-- plate's bound parts; local SetAttribute keeps the hit-flash restore
	-- idiom landing on the mutated color).
	local function paintSign(signIdx, mult, text)
		local info = bound.headerPlates[signIdx]
		if info and info.tierLabel and info.tierLabel.Parent then
			info.tierLabel.Text = text or (tostring(mult) .. "X")
			info.tierLabel.TextColor3 = multColor(mult)
		end
		local c = multColor(mult)
		for _, framePart in ipairs(bound.headerFrames[signIdx] or {}) do
			if framePart.Parent then
				framePart.Color = c
				framePart:SetAttribute("BaseColor", c)
			end
		end
		local led = bound.laneLeds[signIdx]
		if led and led.Parent then
			led.Color = c
			led:SetAttribute("BaseColor", c)
		end
	end

	-- Countdown writer on a sign's CountLabel (restores the ×N tally after).
	local countdownToken = {}
	local function runCountdown(signIdx, untilAt, hitsMode)
		countdownToken[signIdx] = (countdownToken[signIdx] or 0) + 1
		local myToken = countdownToken[signIdx]
		task.spawn(function()
			while countdownToken[signIdx] == myToken do
				local info = bound.headerPlates[signIdx]
				local lbl = info and info.countLabel
				if lbl and lbl.Parent then
					if hitsMode then
						local hl = remotes:GetAttribute("JackpotHitsLeft") or 0
						lbl.Text = hl .. " HITS"
					else
						local left = math.max(0, untilAt - workspace:GetServerTimeNow())
						lbl.Text = ("0:%02d"):format(math.ceil(left))
						if left <= 0 then break end
					end
				end
				task.wait(0.25)
			end
		end)
	end
	local function stopCountdown(signIdx)
		countdownToken[signIdx] = (countdownToken[signIdx] or 0) + 1
		local info = bound.headerPlates[signIdx]
		if info and info.countLabel and info.countLabel.Parent then
			info.countLabel.Text = ""
		end
	end

	-- Integer count-up ladder: EVERY value appears; hop + squash + rising
	-- tick pitch; landing flash + bloom. Steps fit 0.35-0.6s total.
	local function countUpSign(signIdx, fromV, toV, stagger)
		task.spawn(function()
			if stagger and stagger > 0 then task.wait(stagger) end
			local info = bound.headerPlates[signIdx]
			local lbl = info and info.tierLabel
			if not (lbl and lbl.Parent) then
				paintSign(signIdx, toV)
				return
			end
			local steps = math.max(1, math.abs(toV - fromV))
			local stepDur = math.clamp(0.45 / steps, 0.02, 0.08)
			local dir = toV > fromV and 1 or -1
			local basePos = lbl.Position
			for v = fromV + dir, toV, dir do
				if not lbl.Parent then return end
				lbl.Text = tostring(v) .. (v == toV and "X" or "")
				lbl.Position = basePos - UDim2.fromOffset(0, 4)
				task.delay(stepDur * 0.6, function()
					if lbl.Parent then lbl.Position = basePos end
				end)
				local frac = math.abs(v - fromV) / steps
				tick.PlaybackSpeed = (dir > 0 and 0.9 + frac * 0.6 or 1.5 - frac * 0.6)
					+ math.random() * 0.04
				tick:Play()
				task.wait(stepDur)
			end
			paintSign(signIdx, toV)
			if dir > 0 then
				-- Landing: white flash + bloom + SURGED! beat.
				lbl.TextColor3 = Color3.new(1, 1, 1)
				task.delay(0.12, function()
					if lbl.Parent then lbl.TextColor3 = multColor(toV) end
				end)
				slam:Play()
				if info.light and info.light.Parent then
					TweenService:Create(info.light,
						TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true),
						{ Brightness = 6 }):Play()
					task.delay(0.5, function()
						if info.light.Parent then info.light.Brightness = 0 end
					end)
				end
			end
		end)
	end

	-- Snap every sign to the replicated truth (bind, rejoin, zone rebuild).
	local function repaintAll()
		local mults = {}
		for i = 1, 5 do
			mults[i] = remotes:GetAttribute("Lane" .. i .. "Mult") or ({ 3, 10, 25, 10, 3 })[i]
		end
		local jpState = remotes:GetAttribute("JackpotState") or "idle"
		for logical, signs in ipairs(LOGICAL_SIGNS) do
			for _, s in ipairs(signs) do
				if logical == 3 and jpState == "active" then
					paintSign(s, 50, "JACKPOT")
				elseif logical == 3 and jpState == "overload" then
					paintSign(s, 1000, "1000X")
				else
					paintSign(s, mults[logical])
				end
			end
		end
	end
	task.spawn(function()
		while true do
			repaintAll()
			task.wait(3) -- cheap reconcile: covers machine rebuilds/late binds
		end
	end)

	local lastSeq = 0
	laneMutateRemote.OnClientEvent:Connect(function(p)
		if type(p) ~= "table" or type(p.seq) ~= "number" then return end
		if p.seq <= lastSeq and p.kind ~= "jackpot_hit" then return end
		lastSeq = math.max(lastSeq, p.seq)
		if p.kind == "mutate" then
			-- Double surges vary deterministically by seq: wave (stagger) or slam.
			local wave = (#p.lanes > 1) and (p.seq % 2 == 0)
			for i, logical in ipairs(p.lanes) do
				local signs = LOGICAL_SIGNS[logical] or {}
				for _, s in ipairs(signs) do
					countUpSign(s, p.old[i], p.new[i], wave and (i - 1) * 0.12 or 0)
					runCountdown(s, p.expiresAt, false)
				end
			end
			-- Screen-right is world -X (the locked camera mirrors X), so
			-- logical lanes 1/2 render on the player's RIGHT.
			local sideWord = #p.lanes > 1 and "BOTH LANES"
				or (p.lanes[1] < 3 and "RIGHT LANE" or (p.lanes[1] > 3 and "LEFT LANE" or "CENTER"))
			showStrip(("%s SURGED! %dX → %dX"):format(sideWord, p.old[1], p.new[1]),
				multColor(p.new[1]), math.max(2, (p.expiresAt - p.serverNow)))
		elseif p.kind == "revert" then
			for i, logical in ipairs(p.lanes) do
				for _, s in ipairs(LOGICAL_SIGNS[logical] or {}) do
					countUpSign(s, p.old[i], p.new[i], 0) -- reverse ladder (fast: few steps at 0.45s budget)
					stopCountdown(s)
				end
			end
			hideStrip()
		elseif p.kind == "jackpot_open" then
			for _, s in ipairs(LOGICAL_SIGNS[3]) do
				-- Letters type in over ~0.3s.
				task.spawn(function()
					local info = bound.headerPlates[s]
					local lbl = info and info.tierLabel
					if not (lbl and lbl.Parent) then return end
					local word = "JACKPOT"
					for n = 1, #word do
						if not lbl.Parent then return end
						lbl.Text = word:sub(1, n)
						lbl.TextColor3 = Color3.fromRGB(255, 214, 90)
						task.wait(0.04)
					end
					paintSign(s, 50, "JACKPOT")
				end)
				runCountdown(s, p.expiresAt, true)
			end
			slam:Play()
			showStrip(("JACKPOT ACTIVE — %d HITS · %ds"):format(p.hitsLeft or 8,
				math.ceil((p.expiresAt or 0) - (p.serverNow or 0))),
				Color3.fromRGB(255, 214, 90))
			S.shakeUntil = os.clock() + 0.25
		elseif p.kind == "overload_open" then
			-- MILESTONE REVEAL: 25 -> 1000, deep pitch drops, escalating shake.
			for _, s in ipairs(LOGICAL_SIGNS[3]) do
				task.spawn(function()
					local info = bound.headerPlates[s]
					local lbl = info and info.tierLabel
					if not (lbl and lbl.Parent) then return end
					local miles = GameConfig.JackpotCore.overload.milestones
					for mi, v in ipairs(miles) do
						if not lbl.Parent then return end
						lbl.Text = tostring(v) .. "X"
						lbl.TextColor3 = Color3.new(1, 1, 1)
						tick.PlaybackSpeed = 1.3 - mi * 0.12
						tick:Play()
						if not S.reducedMotion then
							S.shakeAmp = 0.03 + mi * 0.015
							S.shakeUntil = os.clock() + 0.12
						end
						task.wait(0.09)
					end
					S.shakeAmp = nil
					paintSign(s, 1000, "1000X")
					slam:Play()
				end)
				runCountdown(s, p.expiresAt, true)
			end
			showStrip(("COSMIC OVERLOAD — 1000X · %d HITS — THE POT HOLDS"):format(p.hitsLeft or 2),
				Color3.fromRGB(255, 244, 214))
		elseif p.kind == "jackpot_hit" then
			showStrip((remotes:GetAttribute("JackpotState") == "overload"
				and "1000X HIT! %d LEFT" or "JACKPOT HIT! %d LEFT"):format(p.hitsLeft or 0),
				Color3.fromRGB(255, 214, 90), 2.5)
		elseif p.kind == "jackpot_close" or p.kind == "overload_close" then
			for _, s in ipairs(LOGICAL_SIGNS[3]) do
				stopCountdown(s)
				countUpSign(s, p.kind == "overload_close" and 50 or 50, 25, 0)
			end
			hideStrip()
			task.delay(0.6, repaintAll)
		end
	end)
end)()

