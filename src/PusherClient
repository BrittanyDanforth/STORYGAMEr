	local closeBtn = Instance.new("TextButton")
	closeBtn.AnchorPoint = Vector2.new(1, 0)
	closeBtn.Position = UDim2.new(1, 8, 0, -8)
	closeBtn.Size = UDim2.fromOffset(36, 36)
	closeBtn.Text = ""
	closeBtn.BackgroundTransparency = 1
	closeBtn.ZIndex = 47
	closeBtn.Parent = featured
	do
		local closeFace = Instance.new("Frame")
		closeFace.AnchorPoint = Vector2.new(0.5, 0.5)
		closeFace.Position = UDim2.fromScale(0.5, 0.5)
		closeFace.Size = UDim2.fromOffset(28, 28)
		closeFace.BackgroundColor3 = UI_BG
		closeFace.BackgroundTransparency = 0.35
		closeFace.BorderSizePixel = 0
		closeFace.ZIndex = 47
		closeFace.Parent = closeBtn
