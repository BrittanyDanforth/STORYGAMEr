		-- ===== STAGE 9 — HOLD (4.0s / 6.0s, Z49): UIScale breath; tap
		-- dismisses; FORGE MAX repeats surface as the rapid counter with
		-- mini burst pops.
		local breath = TweenService:Create(cardScale,
			TweenInfo.new(0.9, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
			{ Scale = 1.03 })
		breath:Play()
		local dismissed = false
		card.MouseButton1Click:Connect(function()
			dismissed = true
		end)
		dim.MouseButton1Click:Connect(function()
			dismissed = true
		end)
		local holdDur = stage2 and 6 or 4
		local shownCount = 1
