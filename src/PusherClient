-- number + the "REWARD READY" subline (the QuestChip's replacement).
function S.dailyReadyCount()
	local count = 0
	for i = 1, 4 do
		if player:GetAttribute("DailyR" .. i) and not player:GetAttribute("DailyC" .. i) then
			count += 1
		end
	end
	if player:GetAttribute("StreakReady") then count += 1 end
	local ready = player:GetAttribute("PlayReady") or 0
	local claimed = player:GetAttribute("PlayClaimed") or 0
	for i = 1, #PLAY_CFG.milestones do
		if maskBit(ready, i) and not maskBit(claimed, i) then count += 1 end
	end
	return count
end

-- Any planet with a forge affordable (FORGE badge + link rows).
local function anyForgeReady()
	for _, entry in ipairs(ownedBalls) do
		local req = GameConfig.forgeReq(attrGet, entry.t) or 10
		if (entry.c or 0) >= req or (entry.f1 or 0) >= req then return true end
	end
	return false
end
S.anyForgeReady = anyForgeReady

-- Deep links used by the loop's link rows + the forge page.
function S.openPanelPage(page)
	S.treePage.Visible = false
	if S.forgePage then S.forgePage.Visible = false end
	openPage = page
	panel.Visible = true
	renderPage()
end
function S.openIndexDetail(key, form)
	detailKey = key
	detailForm = form or 0
	S.openPanelPage("collection")
end

-- ============================ DAILY PAGE ================================

local function renderDailyPage()
	-- Ticket labels show what a claim actually pays: the server credits
	-- through creditTickets' persistent chain (zone/throne/tree/rebirth/
	-- attr/group = GameConfig.ticketScale), not the raw table value. Labels
	-- may still UNDERSTATE during fever/paid boosts (those stack on top at
	-- credit time) — never overstate. Dust stays flat.
	local function scaledTix(base)
		local zone = (remotes and remotes:GetAttribute("Zone")) or 1
		return math.floor((base or 0) * GameConfig.ticketScale(attrGet, zone))
	end
	panelTitle.Text = "DAILY"

	-- Built like RANKS / REBIRTH: pixel-brick plates, one pinned TODAY hero
	-- with a huge FredokaOne count, kid-word copy, giant claim bricks. Every
	-- claim still goes through the same remote with the same args, and every
	-- state reads ONLY the replicated attrs (never optimistic).

	-- ---- Shared readers. The TODAY brick, the tab badges and all three
	-- tabs read these same attrs, so the ready count and the CLAIM ALL list
	-- agree with the tabs by construction (S.dailyReadyCount's rules).
	local function questReady(i)
		return player:GetAttribute("DailyR" .. i) == true
			and player:GetAttribute("DailyC" .. i) ~= true
	end
	local function questClaimed(i)
		return player:GetAttribute("DailyC" .. i) == true
	end
	local questReadyList = {} -- 1..3 = missions, 4 = the all-3 chest
	for i = 1, 4 do
		if questReady(i) then table.insert(questReadyList, i) end
	end
	local streakReady = player:GetAttribute("StreakReady") == true
	local sDay = player:GetAttribute("StreakDay") or 0
	local sLast = player:GetAttribute("StreakLast") -- optional mirror
	local paused = sLast ~= nil and sLast > 0
		and (os.time() - sLast) > (STREAK_CFG.breakHours * 3600)
	local displayDay = sDay + (streakReady and 1 or 0)
	if paused and streakReady then displayDay = 1 end
	if displayDay < 1 then displayDay = 1 end
	local todaySlot = ((displayDay - 1) % 7) + 1
	local weeks = math.floor(math.max(displayDay - 1, 0) / 7)
	local mult = math.min(1 + 0.1 * weeks, STREAK_CFG.weekMultCap)
	local playSecs = player:GetAttribute("PlaySecs") or 0
	local playReadyMask = player:GetAttribute("PlayReady") or 0
	local playClaimedMask = player:GetAttribute("PlayClaimed") or 0
	local milestones = PLAY_CFG.milestones
	local playReadyList = {}
	local playClaimedCount = 0
	local nextReadyIdx, nextFutureIdx = nil, nil
	for i = 1, #milestones do
		local isClaimed = maskBit(playClaimedMask, i)
		if isClaimed then playClaimedCount += 1 end
		if maskBit(playReadyMask, i) and not isClaimed then
			table.insert(playReadyList, i)
			if not nextReadyIdx then nextReadyIdx = i end
		end
		if not isClaimed and not maskBit(playReadyMask, i) and not nextFutureIdx then
			nextFutureIdx = i
		end
	end
	local readyTotal = #questReadyList + (streakReady and 1 or 0) + #playReadyList

	-- ---- Clocks. PlaySecs mirrors 1x/30s; between mirrors the page ticks
	-- locally off the render stamp (the 30s re-render re-syncs it).
	local renderStamp = os.time()
	local function liveSecs()
		return playSecs + math.max(0, os.time() - renderStamp)
	end
	local function streakLeft() -- seconds until the next streak claim opens
		if streakReady or not sLast or sLast <= 0 then return nil end
		return (sLast + STREAK_CFG.minGapHours * 3600) - os.time()
	end
	local function playLeft() -- seconds until the next playtime station
		if not nextFutureIdx then return nil end
		return milestones[nextFutureIdx] - liveSecs()
	end
	-- The next thing coming: the sooner of streak / playtime, else the
	-- quest reset (UTC midnight, the same clock as the server rollover).
	local function nextUpText()
		local sl, pl = streakLeft(), playLeft()
		local nextDay = paused and 1 or (sDay + 1)
		local text = nil
		if sl then
			text = sl > 0 and ("STREAK DAY %d UNLOCKS IN %s"):format(nextDay, fmtClock(sl))
				or ("STREAK DAY %d ANY MINUTE..."):format(nextDay)
		end
		if pl and (not sl or pl < sl) then
			text = pl > 0 and ("PLAYTIME PRIZE IN %s"):format(fmtClock(pl))
				or "PLAYTIME PRIZE ANY SECOND..."
		end
		if not text then
			text = "NEW QUESTS IN " .. fmtClock(86400 - (os.time() % 86400))
		end
		return text
	end

	-- ---- Entrance fade (the RANKS / REBIRTH pattern), keyed on the TAB
	-- only. This page clear-rebuilds on every Tickets collect, on the 30s
	-- PlaySecs mirror and on each claim landing — a blink there reads as a
	-- glitch, so those re-renders build settled. Closing the panel, or
	-- leaving for another page (the title changes), clears the key so the
	-- next arrival fades again. Hooks connect once.
	if not S.dailyFadeHook then
		S.dailyFadeHook = true
		panel:GetPropertyChangedSignal("Visible"):Connect(function()
			if not panel.Visible then S.dailyFadeKey = nil end
		end)
		panelTitle:GetPropertyChangedSignal("Text"):Connect(function()
			if panelTitle.Text ~= "DAILY" then S.dailyFadeKey = nil end
		end)
	end
	local fadeKey = "daily|" .. tostring(dailyTab)
	local animateEntrance = S.dailyFadeKey ~= fadeKey
	S.dailyFadeKey = fadeKey
	local fadeOrder = 0
	local function fadeIn(block)
		if S.reducedMotion or not animateEntrance then return end
		local info = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out,
			0, false, fadeOrder * 0.02)
		fadeOrder = fadeOrder + 1
		local function fade(obj, prop)
			local target = obj[prop]
			if target >= 1 then return end
			obj[prop] = 1
			TweenService:Create(obj, info, { [prop] = target }):Play()
		end
		fade(block, "BackgroundTransparency")
		for _, obj in ipairs(block:GetDescendants()) do
			-- "Pulse" plates own a looping transparency tween; a second
			-- tween on the same property would cancel the breathing.
			if obj.Name ~= "Pulse" then
				if obj:IsA("TextLabel") or obj:IsA("TextButton") then
					fade(obj, "TextTransparency")
					fade(obj, "TextStrokeTransparency")
					fade(obj, "BackgroundTransparency")
				elseif obj:IsA("ImageLabel") then
					fade(obj, "ImageTransparency")
					fade(obj, "BackgroundTransparency")
				elseif obj:IsA("Frame") then
					fade(obj, "BackgroundTransparency")
				elseif obj:IsA("UIStroke") then
					fade(obj, "Transparency")
				end
			end
		end
	end

	-- ---- Palette + small builders (all local to this page).
	local INK = Color3.fromRGB(12, 13, 20) -- the one glyph-stroke colour
	local STAGE = Color3.fromRGB(16, 17, 26) -- dark brick behind heroes/rails
	local GOLD_CARD = Color3.fromRGB(58, 46, 18) -- hero plate (RANKS' YOU card)
	local GOLD_DIM = Color3.fromRGB(44, 38, 20) -- claimed plate
	local GOLD_SLOT = Color3.fromRGB(96, 74, 24) -- claimed calendar slot
	-- The row width in offset units (the panel is scale-sized, capped by
	-- panelSize, under hudScale): labels that share a row with fixed-width
	-- neighbours size or hide themselves from it instead of guessing.
	local rowW = panel.AbsoluteSize.X / math.max(hudScale.Scale, 0.01) - 34
	if rowW < 100 then rowW = panelSize.MinSize.X - 34 end
	local GREEN_CARD = Color3.fromRGB(22, 46, 28) -- ready plate
	local GREEN_INK = Color3.fromRGB(18, 74, 34)
	local LOCKED = Color3.fromRGB(40, 42, 58) -- unlit pip / station
	local MINT = Color3.fromRGB(120, 230, 140)
	local PALE_GOLD = Color3.fromRGB(255, 226, 150)
	local LILAC = Color3.fromRGB(210, 170, 255) -- dust
	local SALMON = Color3.fromRGB(235, 150, 120) -- paused streak
	local DARK_TEXT = Color3.fromRGB(30, 26, 14) -- text on solid gold

	-- Thin progress bar: dark track, coloured fill, frac 0..1.
	local function progressBar(parent, posU, sizeU, frac, color, zindex)
		local track = Instance.new("Frame")
		track.Position = posU
		track.Size = sizeU
		track.BackgroundColor3 = STAGE
		track.BorderSizePixel = 0
		track.ZIndex = zindex
		track.Parent = parent
		corner(track, 3)
		stroke(track, Color3.new(0, 0, 0), 1, 0.6)
		local fill = Instance.new("Frame")
		fill.Size = UDim2.new(math.clamp(frac, 0, 1), 0, 1, 0)
		fill.BackgroundColor3 = color
		fill.BorderSizePixel = 0
		fill.ZIndex = zindex + 1
		fill.Parent = track
		corner(fill, 3)
		return track
	end

	-- Breathing pixel halo behind a brick (the READY glow): a slightly
	-- larger plate whose transparency loops. Static at half under reduced
	-- motion. Sits at zindex (one under the brick's own plate).
	local function glow(parent, color, zindex)
		local halo = Instance.new("Frame")
		halo.Name = "Pulse"
		halo.Position = UDim2.new(0, -2, 0, -2)
		halo.Size = UDim2.new(1, 4, 1, 4)
		halo.BackgroundTransparency = 1
		halo.ZIndex = zindex
		halo.Parent = parent
		local plate = pixelPlate(halo, color, zindex, "card", 3)
		plate.Name = "Pulse"
		plate.ImageTransparency = 0.5
		if not S.reducedMotion then
			plate.ImageTransparency = 0.2
			TweenService:Create(plate,
				TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
				{ ImageTransparency = 0.75 }):Play()
		end
		return halo
	end

	-- Pixel-brick claim button (the REBIRTH button idiom) with the claim
	-- state set: ready (green, hover, squash), claimed (dark gold + check),
	-- disabled (dark, sub text). Callers restyle via setState; tickers
	-- write api.txt.
	local function brickButton(parent, sizeU, posU, zindex, textSize)
		local btn = Instance.new("TextButton")
		btn.Size = sizeU
		btn.Position = posU
		btn.BackgroundTransparency = 1
		btn.Text = ""
		btn.AutoButtonColor = false
		btn.ZIndex = zindex
		btn.Parent = parent
		local face = pixelPlate(btn, STAGE, zindex, "btn", 3)
		local txt = label(btn, "", textSize or 16, UI_SUB, Enum.Font.FredokaOne)
		txt.Position = UDim2.new(0, 6, 0, 0)
		txt.Size = UDim2.new(1, -12, 1, -6)
		txt.TextTruncate = Enum.TextTruncate.AtEnd
		txt.TextStrokeColor3 = INK
		txt.ZIndex = zindex + 1
		local pressScale = Instance.new("UIScale")
		pressScale.Parent = btn
		local api = { btn = btn, txt = txt }
		local state = "disabled"
		local hovering = false
		local function paint()
			if state == "ready" then
				face.ImageColor3 = pixelTint(hovering and Color3.fromRGB(104, 214, 124) or UI_GREEN)
				txt.TextColor3 = Color3.new(1, 1, 1)
				txt.TextStrokeColor3 = GREEN_INK
				txt.TextStrokeTransparency = 0.15
			elseif state == "claimed" then
				face.ImageColor3 = pixelTint(GOLD_DIM)
				txt.TextColor3 = UI_GOLD
				txt.TextStrokeTransparency = 1
			else
				face.ImageColor3 = pixelTint(LOCKED)
				txt.TextColor3 = UI_SUB
				txt.TextStrokeTransparency = 1
			end
		end
		btn.MouseEnter:Connect(function()
			hovering = true
			paint()
		end)
		btn.MouseLeave:Connect(function()
			hovering = false
			paint()
		end)
		btn.MouseButton1Down:Connect(function()
			if state == "ready" then
				TweenService:Create(pressScale,
					TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ Scale = 0.95 }):Play()
			end
		end)
		btn.MouseButton1Up:Connect(function()
			TweenService:Create(pressScale,
				TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ Scale = 1 }):Play()
		end)
		function api.setState(newState, text)
			state = newState
			if text then txt.Text = text end
			paint()
		end
		paint()
		return api
	end

	-- Small pixel chip (a stamp, not a button): FredokaOne text on a brick.
	local function chip(parent, posU, w, face, text, textColor, ink, zindex)
		local c = Instance.new("Frame")
		c.AnchorPoint = Vector2.new(1, 0)
		c.Position = posU
		c.Size = UDim2.fromOffset(w, 32)
		c.BackgroundTransparency = 1
		c.ZIndex = zindex
		c.Parent = parent
		pixelPlate(c, face, zindex, "btn", 2)
		local t = label(c, text, 13, textColor, Enum.Font.FredokaOne)
		t.Position = UDim2.new(0, 4, 0, 0)
		t.Size = UDim2.new(1, -8, 1, -5)
		t.TextTruncate = Enum.TextTruncate.AtEnd
		if ink then
			t.TextStrokeColor3 = ink
			t.TextStrokeTransparency = 0.2
		end
		t.ZIndex = zindex + 1
		return c
	end

	-- Hero brick: eyebrow, a bottom-aligned headline row (words around a
	-- huge FredokaOne number), and a sub line. Returns row, numRow, sub.
	local function heroCard(height, face, eyebrowText, chipW)
		local hero = makeRow(height)
		hero.BackgroundTransparency = 1
		pixelPlate(hero, face, 21, "card", 3)
		pixelDither(hero, 22, 0.4)
		-- The headline row stops where the hero's chip starts (chipW is
		-- the chip the caller draws at the right; 0 = none) and clips —
		-- a UIListLayout never truncates, so long words would otherwise
		-- run under the chip.
		local reserve = (chipW or 0) + 42
		local eyebrow = label(hero, eyebrowText, 12, UI_GOLD, Enum.Font.GothamBlack)
		eyebrow.Position = UDim2.new(0, 14, 0, 10)
		eyebrow.Size = UDim2.new(1, -reserve, 0, 14)
		eyebrow.TextTruncate = Enum.TextTruncate.AtEnd
		eyebrow.TextXAlignment = Enum.TextXAlignment.Left
		eyebrow.ZIndex = 23
		local numRow = Instance.new("Frame")
		numRow.BackgroundTransparency = 1
		numRow.Position = UDim2.new(0, 14, 0, 24)
		numRow.Size = UDim2.new(1, -reserve, 0, 46)
		numRow.ClipsDescendants = true
		numRow.ZIndex = 23
		numRow.Parent = hero
		local numLayout = Instance.new("UIListLayout")
		numLayout.FillDirection = Enum.FillDirection.Horizontal
		numLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
		numLayout.SortOrder = Enum.SortOrder.LayoutOrder
		numLayout.Padding = UDim.new(0, 8)
		numLayout.Parent = numRow
		local sub = label(hero, "", 12, PALE_GOLD, Enum.Font.GothamBold)
		sub.Position = UDim2.new(0, 14, 0, 72)
		sub.Size = UDim2.new(1, -28, 0, 16)
		sub.TextTruncate = Enum.TextTruncate.AtEnd
		sub.TextXAlignment = Enum.TextXAlignment.Left
		sub.ZIndex = 23
		return hero, numRow, sub
	end
	-- "[before] 42 [after]": the number sizes itself; words sit on its
	-- baseline. Returns the number label (tickers rewrite it).
	local function headline(numRow, before, bigText, after, bigColor, wordColor, bigSize)
		local order = 0
		local function word(text)
			if not text then return end
			order += 1
			local w = label(numRow, text, 14, wordColor, Enum.Font.GothamBlack)
			w.AutomaticSize = Enum.AutomaticSize.X
			w.Size = UDim2.new(0, 0, 0, 24)
			w.LayoutOrder = order
			w.ZIndex = 23
		end
		word(before)
		order += 1
		local num = label(numRow, bigText, bigSize or 40, bigColor, Enum.Font.FredokaOne)
		num.AutomaticSize = Enum.AutomaticSize.X
		num.Size = UDim2.new(0, 0, 1, 0)
		num.LayoutOrder = order
		num.TextStrokeColor3 = INK
		num.TextStrokeTransparency = 0.3
		num.ZIndex = 23
		word(after)
		return num
	end

	-- ---- TABS (shared pillTabBar) + a ready-count badge on tabs that have
	-- something to claim; the active chip wears real gold.
	local TABS = {
		{ id = "quests", label = "QUESTS", ready = #questReadyList },
		{ id = "streak", label = "STREAK", ready = streakReady and 1 or 0 },
		{ id = "playtime", label = "PLAYTIME", ready = #playReadyList },
	}
	local tabBar = pillTabBar(TABS, dailyTab, function(id)
		dailyTab = id
		renderPage()
	end)
	for _, pill in ipairs(tabBar:GetChildren()) do
		if pill:IsA("TextButton") then
			for _, tab in ipairs(TABS) do
				if tab.label == pill.Text then
					if tab.id == dailyTab then
						pill.BackgroundColor3 = Color3.fromRGB(78, 60, 20)
						local pillStroke = pill:FindFirstChildOfClass("UIStroke")
						if pillStroke then pillStroke.Transparency = 0.05 end
					end
					if tab.ready > 0 then
						local badge = Instance.new("Frame")
						badge.AnchorPoint = Vector2.new(1, 0.5)
						badge.Position = UDim2.new(1, -6, 0.5, 0)
						badge.Size = UDim2.fromOffset(22, 22)
						badge.BackgroundColor3 = UI_GREEN
						badge.BorderSizePixel = 0
						badge.ZIndex = 24
						badge.Parent = pill
						corner(badge, 11)
						stroke(badge, GREEN_INK, 1.5, 0.2)
						local bt = label(badge, tostring(tab.ready), 12, Color3.new(1, 1, 1), Enum.Font.GothamBlack)
						bt.Size = UDim2.fromScale(1, 1)
						bt.ZIndex = 25
					end
				end
			end
		end
	end

	-- ---- TODAY: "N REWARDS READY" huge. 2+ ready = one CLAIM ALL brick
	-- that fires every ready claim in order (the toast rail coalesces the
	-- spree). 0-1 ready = the next thing coming, ticking.
	do
		local showAll = readyTotal >= 2
		local hero, numRow, sub = heroCard(showAll and 150 or 94, GOLD_CARD, "TODAY", showAll and 0 or 170)
		headline(numRow, nil, tostring(readyTotal),
			readyTotal == 1 and "REWARD READY" or "REWARDS READY",
			readyTotal > 0 and Color3.new(1, 1, 1) or UI_SUB,
			readyTotal > 0 and UI_GOLD or UI_SUB, 44)
		if showAll then
			-- What the spree pays, summed from the same tables the tabs
			-- print (scaled tickets, flat dust — understates, never over).
			local tix, dust = 0, 0
			for _, qi in ipairs(questReadyList) do
				if qi <= 3 then
					local m = GameConfig.Daily.missions[qi]
					tix += scaledTix(m.tickets)
					dust += (m.dust or 0)
				else
					tix += scaledTix(DAILY_CHEST.tickets or 300)
					dust += (DAILY_CHEST.dust or 40)
				end
			end
			if streakReady then
				local dayCfg = STREAK_CFG.days[todaySlot] or {}
				tix += scaledTix(dayCfg.tickets)
				dust += (dayCfg.dust or 0)
			end
			for _, pi in ipairs(playReadyList) do
				tix += scaledTix(PLAY_CFG.tickets[pi])
				dust += (PLAY_CFG.dust[pi] or 0)
			end
			sub.Text = ("+%s TIX · +%s DUST WAITING FOR YOU"):format(formatCommas(tix), formatCommas(dust))
			local all = brickButton(hero, UDim2.new(1, -28, 0, 50), UDim2.new(0, 14, 0, 92), 23, 20)
			all.setState("ready", ("CLAIM ALL %d"):format(readyTotal))
			all.btn.MouseButton1Click:Connect(function()
				-- Same remotes, same args, same order the tabs fire:
				-- quests (missions then chest), the streak, then playtime.
				if claimQuestRemote then
					for _, qi in ipairs(questReadyList) do
						claimQuestRemote:FireServer(qi)
					end
				end
				if streakReady and claimStreakRemote then
					claimStreakRemote:FireServer()
				end
				if claimPlaytimeRemote then
					for _, pi in ipairs(playReadyList) do
						claimPlaytimeRemote:FireServer(pi)
					end
				end
				all.setState("disabled", "CLAIMING...")
			end)
		else
			bindTicker(sub, function(lbl)
				lbl.Text = nextUpText()
			end, 1)
			if readyTotal == 1 then
				-- Point at the one ready thing: its tab, or "below" if
				-- you're already on it.
				local whereId = #questReadyList > 0 and "quests" or streakReady and "streak" or "playtime"
				local whereText = "READY BELOW"
				if whereId ~= dailyTab then
					for _, tab in ipairs(TABS) do
						if tab.id == whereId then whereText = "READY ON " .. tab.label end
					end
				end
				chip(hero, UDim2.new(1, -14, 0, 14), 170, UI_GREEN, whereText,
					Color3.new(1, 1, 1), GREEN_INK, 23)
			end
		end
		fadeIn(hero)
	end

	if dailyTab == "quests" then
		-- ---- HERO: the ALL-3 BONUS CHEST on top (quest slot 4) — three
		-- pips for the missions, the chest reward, its claim brick. The gate
		-- is unchanged: DailyR4 (server flips it when r1..r3 are REACHED).
		do
			local chestReady = questReady(4)
			local chestClaimed = questClaimed(4)
			local hitCount = 0
			for i = 1, 3 do
				if player:GetAttribute("DailyR" .. i) == true then hitCount += 1 end
			end
			local row = makeRow(88)
			row.BackgroundTransparency = 1
			if chestReady then glow(row, UI_GREEN, 20) end
			pixelPlate(row, chestClaimed and GOLD_DIM or chestReady and GREEN_CARD or STAGE, 21, "card", 3)
			pixelDither(row, 22, chestReady and 0.35 or 0.5)
			local icon = Instance.new("ImageLabel")
			icon.Image = ACH_ICONS.crown
			icon.BackgroundTransparency = 1
			icon.Size = UDim2.fromOffset(44, 44)
			icon.Position = UDim2.new(0, 12, 0, 14)
			icon.ImageTransparency = chestClaimed and 0.4 or 0
			icon.ZIndex = 23
			icon.Parent = row
			local title = label(row, "ALL 3 DONE = BONUS CHEST", 14,
				chestClaimed and UI_SUB or UI_GOLD, Enum.Font.GothamBlack)
			title.Position = UDim2.new(0, 66, 0, 10)
			title.Size = UDim2.new(1, -206, 0, 18)
			title.TextTruncate = Enum.TextTruncate.AtEnd
			title.TextXAlignment = Enum.TextXAlignment.Left
			title.ZIndex = 23
			local reward = label(row,
				("+%s TIX · +%d DUST · +%d %s"):format(
					formatCommas(scaledTix(DAILY_CHEST.tickets or 300)),
