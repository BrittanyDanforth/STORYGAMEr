;(function() -- section scope: own register budget (main chunk hit Luau's 200-local cap live)
	-- One floating pointer that walks a brand-new player through the core
	-- loop: DROP -> ROLL -> CLAIM 100X -> ROLL AGAIN -> FORGE. Every step is
	-- derived from live state (persisted attributes + the inventory mirror),
	-- so a rejoin resumes at the right step with no saved cursor. The two
	-- flags below are the only client-local state — both err toward hiding.
	local tutorialSkipped = false
	local rolledDuringBoost = false -- rolled at least once while boosted
	local forgedOnce = false -- CombineDone fired this session
	-- WELCOME brick: up right now (coach hides behind it) / builder, defined
	-- after refresh() below because LET'S GO! hands straight off to it.
	local welcomeUp = false
	local showWelcome = nil

	-- Any ASCENDED (form-1) yet? Read off the main chunk's inventory mirror
	-- ({n,t,c,f1,f2} entries from InvSync). A CELESTIAL (f2) counts too —
	-- forging 10 ASCENDED consumes every f1, and a player that far along
	-- must never be coached to "forge their first ASCENDED".
	local function ownsAnyForm1()
		for _, entry in ipairs(ownedBalls) do
			if (entry.f1 or 0) > 0 or (entry.f2 or 0) > 0 then return true end
		end
		return false
	end

	-- Veteran gate: the coach exists for genuinely new players only. If the
	-- persisted flags say the whole loop is behind them AND the first inv
	-- sync shows an ASCENDED already forged, never show at all.
	local vetChecked = false
	local function veteranCheck()
		if vetChecked then return end
		vetChecked = true
		if attrGet("TutorialDone") == true and attrGet("FreeSpinUsed") == true
			and ownsAnyForm1() then
			tutorialSkipped = true
		end
	end
	if #ownedBalls > 0 then
		veteranCheck() -- a sync already landed during an earlier yield
	else
		invDirty.Event:Connect(veteranCheck)
	end

	-- The pointer: dark PIXEL BRICK + gold bobbing arrow on the target-facing
	-- edge — same nine-slice plate as every other control, hard corners (the
	-- first pass was a rounded pill and read as pasted-on next to the bricks).
	-- Active stays false everywhere except SKIP — the coach never eats input.
	local coach = Instance.new("Frame")
	coach.Name = "TutorialCoach"
	coach.Size = UDim2.fromOffset(270, 38)
	coach.BackgroundTransparency = 1
	coach.BorderSizePixel = 0
	coach.Visible = false
	coach.ZIndex = 38
	coach.Active = false
	coach.Parent = gui
	pixelPlate(coach, Color3.fromRGB(26, 27, 40), 38, "btn", 3)

	local arrow = Instance.new("ImageLabel")
	arrow.Image = UI_ARROW
	arrow.ImageColor3 = UI_GOLD
	arrow.BackgroundTransparency = 1
	arrow.Size = UDim2.fromOffset(26, 26)
	arrow.ZIndex = 39
	arrow.Parent = coach

	local msg = label(coach, "", 15, Color3.new(1, 1, 1), Enum.Font.GothamBlack)
	msg.Position = UDim2.fromOffset(12, 0)
	msg.Size = UDim2.new(1, -56, 1, 0)
	msg.TextXAlignment = Enum.TextXAlignment.Left
	msg.TextStrokeColor3 = Color3.fromRGB(10, 11, 18)
	msg.TextStrokeTransparency = 0.2
	-- Scaled with a floor, luckState's idiom: step copy varies and must
	-- never paint past the pill edge.
	msg.TextScaled = true
	msg.ZIndex = 39
	local msgFit = Instance.new("UITextSizeConstraint")
	msgFit.MinTextSize = 10
	msgFit.MaxTextSize = 15
	msgFit.Parent = msg

	local skipBtn = Instance.new("TextButton")
	skipBtn.AnchorPoint = Vector2.new(1, 0.5)
	skipBtn.Position = UDim2.new(1, -6, 0.5, 0)
	skipBtn.Size = UDim2.fromOffset(38, 22)
	skipBtn.BackgroundTransparency = 1
	skipBtn.Text = "SKIP"
	skipBtn.TextColor3 = UI_SUB
	skipBtn.TextSize = 11
	skipBtn.Font = Enum.Font.GothamBold
	skipBtn.ZIndex = 39
	skipBtn.Parent = coach
	skipBtn.MouseButton1Click:Connect(function()
		tutorialSkipped = true -- session-local: a rejoin resumes the coach
		coach.Visible = false
	end)

	-- Arrow home per placement mode (UI_ARROW's base art points RIGHT — the
	-- reel arrows rotate it 0/180 to grip, FREE AUTO -90 to point up). Bob
	-- runs +-4px along the pointing axis; S.reducedMotion parks it.
	local ARROW_SPEC = {
		above = { anchor = Vector2.new(0.5, 0), pos = UDim2.new(0.5, 0, 1, 4),
			rot = 90, bob = UDim2.fromOffset(0, 4) },
		leftOf = { anchor = Vector2.new(0, 0.5), pos = UDim2.new(1, 4, 0.5, 0),
			rot = 0, bob = UDim2.fromOffset(4, 0) },
		rightOf = { anchor = Vector2.new(1, 0.5), pos = UDim2.new(0, -4, 0.5, 0),
			rot = 180, bob = UDim2.fromOffset(-4, 0) },
	}
	local arrowMode = nil
	local bobTween = nil
	local function setArrowMode(mode)
		if arrowMode == mode then return end
		arrowMode = mode
		local spec = ARROW_SPEC[mode]
		if bobTween then
			bobTween:Cancel()
			bobTween = nil
		end
		arrow.AnchorPoint = spec.anchor
		arrow.Rotation = spec.rot
		arrow.Position = spec.pos
		if not S.reducedMotion then
			bobTween = TweenService:Create(arrow,
				TweenInfo.new(0.45, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
				{ Position = spec.pos + spec.bob })
			bobTween:Play()
		end
	end

	-- The step ladder, top to bottom — first unmet step wins. Returns
	-- (target, text); nil text means the tutorial is OVER (vs a nil target
	-- with text, which is a not-yet-built S handle and just hides a tick).
	-- A roll step must never nag an unpressable button: while the roll
	-- cooldown runs, the copy counts it down instead of shouting ROLL.
	local function rollAwaited(readyText)
		local wait = (attrGet("NextRollAt") or 0) - workspace:GetServerTimeNow()
		if wait > 0.5 then
			return ("GET READY — ROLL IN %ds!"):format(math.ceil(wait))
		end
		return readyText
	end

	local function currentStep()
		if (attrGet("TotalDrops") or 0) < 1 then
			return S.dropCluster, "TAP DROP PLANET — TIME THE SWEEP!"
		end
		if attrGet("TutorialDone") ~= true then
			return S.spinButton, rollAwaited("NOW ROLL YOUR FIRST PLANET — FREE!")
		end
		if attrGet("FreeSpinUsed") ~= true then
			return S.luckPill, "CLAIM YOUR FREE 100X LUCK!"
		end
		if rolledDuringBoost == false and (attrGet("LuckBoost") or 0) > 0
			and (attrGet("LuckBoostUntil") or 0) > workspace:GetServerTimeNow() then
			return S.spinButton, rollAwaited("ROLL AGAIN — 100X LUCKIER!")
		end
		if ownsAnyForm1() ~= true and forgedOnce ~= true then
			return S.forgeNavBtn, "FORGE 10 INTO 1 ASCENDED!"
		end
		return nil, nil
	end

	local function refresh()
		if tutorialSkipped then
			coach.Visible = false
			return
		end
		-- Nothing paints before the doc lands: attributes are nil during the
		-- DataStore load, which would read as "never dropped" and flash the
		-- DROP step at every RETURNING player for a few seconds.
		if attrGet("DataLoaded") ~= true then
			coach.Visible = false
			return
		end
		-- WELCOME brick (first-ever session, before the DROP step): the
		-- coach waits behind it, and it never opens over a page.
		if welcomeUp then
			coach.Visible = false
			return
		end
		if not S.welcomeShown and (attrGet("TotalDrops") or 0) < 1
			and attrGet("TutorialDone") ~= true and showWelcome
			and not (panel.Visible or (S.treePage and S.treePage.Visible)
				or (S.forgePage and S.forgePage.Visible)) then
			showWelcome()
			coach.Visible = false
			return
		end
		local target, text = currentStep()
		if text == nil then
			-- They forged (or already owned) an ASCENDED — over for good.
			tutorialSkipped = true
			coach.Visible = false
			return
		end
		-- Hide behind any open page — including the forge step the moment
		-- the forge page itself opens (they found it).
		if not target or panel.Visible
			or (S.treePage and S.treePage.Visible)
			or (S.forgePage and S.forgePage.Visible) then
			coach.Visible = false
			return
		end
		local ap, asz = target.AbsolutePosition, target.AbsoluteSize
		if asz.X <= 0 or asz.Y <= 0 then
			coach.Visible = false -- not laid out yet
			return
		end
		-- AbsolutePosition is post-HudScale screen pixels IN INSET SPACE, and
		-- this gui has IgnoreGuiInset, so its own origin sits at (0, -inset):
		-- convert into gui-local design units by subtracting gui's origin
		-- FIRST, then divide the HudScale back out. (Skipping the subtraction
		-- floated the whole coach ~36px off its target on the live build.)
		local s = math.max(hudScale.Scale, 0.01)
		local og = gui.AbsolutePosition
		local vp = camera.ViewportSize
		local tx = (ap.X - og.X) / s
		local ty = (ap.Y - og.Y) / s
		local tw = asz.X / s
		local th = asz.Y / s
		local cx = ap.X + asz.X / 2
		if cx >= vp.X * 0.6 then
			setArrowMode("leftOf")
			coach.AnchorPoint = Vector2.new(1, 0.5)
			coach.Position = UDim2.fromOffset(tx - 32, ty + th / 2)
		elseif cx <= vp.X * 0.4 then
			setArrowMode("rightOf")
			coach.AnchorPoint = Vector2.new(0, 0.5)
			coach.Position = UDim2.fromOffset(tx + tw + 32, ty + th / 2)
		else
			setArrowMode("above")
			coach.AnchorPoint = Vector2.new(0.5, 1)
			coach.Position = UDim2.fromOffset(tx + tw / 2, ty - 32)
		end
		msg.Text = text
		coach.Visible = true
	end

	-- WELCOME brick: the first thing a brand-new account sees. One centered
	-- pixel card over a tap-eating scrim; LET'S GO! hands off to the coach's
	-- DROP step. S.welcomeShown is the session flag so a page toggle never
	-- re-opens it; the attribute gate in refresh() keeps veterans out.
	function showWelcome()
		welcomeUp = true
		S.welcomeUp = true -- the drop input section gates Space/hold on this
		local scrim = Instance.new("Frame")
		scrim.Name = "WelcomeScrim"
		scrim.Size = UDim2.fromScale(1, 1)
		scrim.BackgroundColor3 = Color3.fromRGB(6, 7, 12)
		scrim.BackgroundTransparency = 0.55
		scrim.BorderSizePixel = 0
		scrim.ZIndex = 59
