function renderPage()
	clearContent()
	-- Owner order: INDEX is a major DESTINATION, not a popup widget — the
	-- shared panel goes near-fullscreen (~92% of the viewport, capped) for
	-- the collection and back to compact for the other pages.
	if openPage == "collection" then
		panel.Size = UDim2.new(0.94, 0, 0.92, 0)
		panelSize.MaxSize = Vector2.new(1380, 820)
		panelTitle.TextSize = 30
		panelTitle.Font = Enum.Font.FredokaOne
	else
		panel.Size = UDim2.new(0.55, 0, 0.78, 0)
		panelSize.MaxSize = Vector2.new(560, 529)
		panelTitle.TextSize = 22
		panelTitle.Font = Enum.Font.GothamBlack
	end
	if openPage == "collection" then
		-- Page key stays "collection" internally; the button and the title
		-- read INDEX — this page IS the collection book now (loop-index).
		panelTitle.Text = "INDEX"
		-- Shared fusion + odds context for both tabs and the detail view.
		-- Odds always take BOTH the free luck scalar and the paid boost
		-- magnitude (§1) — the odds you see are the odds you roll.
		-- Forge Mastery discounts recipes: effective req comes from
		-- GameConfig.forgeReq so counts/gates here match the server consume.
		local function reqOf(tier) return GameConfig.forgeReq(attrGet, tier) or 10 end
		local formNames = GameConfig.FormNames
		local equippedKey = player:GetAttribute("EquippedBall") or "Bubblegum|1"
		local equippedForm = player:GetAttribute("EquippedForm") or 0
		local dust = player:GetAttribute("StarDust") or 0
		local chanceByKey = {}
		pcall(function()
			for _, chance in ipairs(PusherMachine.planetChances(currentLuck(), currentBoostMag(), currentMods())) do
				chanceByKey[chance.name .. "|" .. chance.tier] = chance
			end
		end)
		local specialSource = {}
		for _, sp in ipairs(GameConfig.SpecialPlanets or {}) do
			specialSource[sp.n .. "|" .. sp.t] = sp.source
		end
		local function countsOf(entry)
			if not entry then return 0, 0, 0 end
			return entry.c or 0, entry.f1 or 0, entry.f2 or 0
		end
		-- Closest pending fusion for an entry: fromForm (0 feeds ASCENDED,
		-- 1 feeds CELESTIAL), have, req — nil when nothing is brewing.
		local function nextFusion(entry, tier)
			if not entry then return nil end
			local req = reqOf(tier)
			local c, f1 = countsOf(entry)
			if f1 >= c and f1 > 0 then return 1, f1, req end
			if c > 0 then return 0, c, req end
			return nil
		end
		local function canCombine(entry, tier)
			local req = reqOf(tier)
			local c, f1 = countsOf(entry)
			return c >= req or f1 >= req
		end
		local function formDisplayName(form, planetName)
			local formName = formNames[form + 1]
			return (formName ~= nil and formName ~= "" and (formName .. " ") or "") .. planetName
		end
		local function silhouette(iconHolder)
			for _, art in ipairs(iconHolder:GetChildren()) do
				if art:IsA("ImageLabel") then
					art.ImageColor3 = Color3.fromRGB(24, 26, 40)
				end
			end
		end

		if detailKey then
			-- ============ DETAIL VIEW (§7) — replaces the page ============
			local dName, dTierStr = detailKey:match("^(.*)|(%d+)$")
			local dTier = tonumber(dTierStr) or 1
			local spec = planetLookup[detailKey]
			local tierInfo = PusherMachine.Tiers[dTier] or PusherMachine.Tiers[1]
			local entry = invByKey[detailKey]
			local discovered = entry ~= nil
			local req = reqOf(dTier)
			local c, f1, f2 = countsOf(entry)
			local formCounts = { [0] = c, [1] = f1, [2] = f2 }
			local formUnlocked = { [0] = discovered, [1] = f1 > 0, [2] = f2 > 0 }
			if not spec then
				detailKey = nil
				renderPage()
				return
			end

			-- ====== FORM SHOWCASE + STAGE LADDER (judged redesign) ======
			-- One planet, one stage, three trophies: a giant hero card and
			-- exactly THREE stage cards (BASE/ASCENDED/CELESTIAL), each
			-- carrying its own preview, OWNED count, payout, recipe and
			-- action. The old tabs + ownership rows + cryptic ladder strings
			-- are gone — every fact lives exactly once. 13px text floor.
			-- Hero never shows a locked silhouette for a discovered planet.
			if not formUnlocked[detailForm] then
				detailForm = (f2 > 0 and 2) or (f1 > 0 and 1) or 0
			end
			local basePay = tierInfo.payout
			local sNow = math.max(hudScale.Scale, 0.01)
			local vpW = camera.ViewportSize.X / sNow
			local panelW = math.min(vpW * 0.94, 1380) - 28
			local wide = panelW >= 1000
			local INK = Color3.fromRGB(12, 13, 20) -- the one stroke color here
			local FORM_ACCENT = {
				[0] = UI_TEXT,
				[1] = Color3.fromRGB(210, 170, 255),
				[2] = UI_GOLD,
			}
			local function formWordOf(form)
				local n = formNames[form + 1]
				if n == nil or n == "" then n = "BASE" end
				return n
			end
			local chance = chanceByKey[detailKey]

			-- ---- ROW 1: back ----
			local backRow = makeRow(44)
			backRow.BackgroundTransparency = 1
			local backBtn = Instance.new("TextButton")
			backBtn.Size = UDim2.fromOffset(200, 40)
			backBtn.Position = UDim2.new(0, 0, 0, 2)
			backBtn.BackgroundTransparency = 1
			backBtn.Text = ""
			backBtn.ZIndex = 23
			backBtn.Parent = backRow
			pixelPlate(backBtn, UI_ROW, 22, "btn", 3)
			local backLbl = label(backBtn, "<  BACK TO INDEX", 14, Color3.new(1, 1, 1), Enum.Font.GothamBlack)
			backLbl.Size = UDim2.new(1, 0, 1, -6)
			backLbl.TextStrokeColor3 = INK
			backLbl.TextStrokeTransparency = 0.2
			backLbl.ZIndex = 24
			backBtn.MouseButton1Click:Connect(function()
				detailKey = nil
				renderPage()
			end)

			-- ---- hero card builder (shared) ----
			local function buildHero(parent, heroH, viewSize, nameSize)
				pixelPlate(parent, discovered and tierInfo.color:Lerp(UI_ROW, 0.7) or UI_ROW,
					21, "card", 4)
				pixelDither(parent, 22, 0.35)
				if discovered then
					local view = makePlanetView(parent, dName, dTier, viewSize, 23, true, detailForm)
					view.AnchorPoint = Vector2.new(0.5, 0)
					view.Position = UDim2.new(0.5, 0, 0, 24)
				else
					local sil = makePlanetIcon(parent, spec, math.floor(viewSize * 0.62), 23, 0)
					sil.AnchorPoint = Vector2.new(0.5, 0)
					sil.Position = UDim2.new(0.5, 0, 0, 60)
					silhouette(sil)
					local qq = label(parent, "ROLL THE MACHINE TO FIND THIS PLANET!", 15,
						Color3.new(1, 1, 1), Enum.Font.GothamBold)
					qq.Position = UDim2.new(0, 24, 0, viewSize - 26)
					qq.Size = UDim2.new(1, -48, 0, 20)
					qq.TextStrokeColor3 = INK
					qq.TextStrokeTransparency = 0.2
					qq.ZIndex = 23
				end
				local heroName = label(parent, discovered and dName:upper() or "???",
					nameSize, discovered and (dTier >= 2 and tierInfo.color or Color3.new(1, 1, 1))
						or UI_SUB, Enum.Font.FredokaOne)
				heroName.Position = UDim2.new(0, 24, 0, viewSize + 32)
				heroName.Size = UDim2.new(1, -48, 0, nameSize + 10)
				heroName.TextWrapped = true
				heroName.TextStrokeColor3 = INK
				heroName.TextStrokeTransparency = 0.2
				heroName.ZIndex = 23
				local rarBtn = Instance.new("Frame")
				rarBtn.AnchorPoint = Vector2.new(0.5, 0)
				rarBtn.Position = UDim2.new(0.5, 0, 0, viewSize + nameSize + 48)
				rarBtn.Size = UDim2.fromOffset(160, 32)
				rarBtn.BackgroundTransparency = 1
				rarBtn.ZIndex = 23
				rarBtn.Parent = parent
				pixelPlate(rarBtn, tierInfo.color, 23, "btn", 2)
				local rarLbl = label(rarBtn, tierInfo.name, 15,
					Color3.fromRGB(30, 26, 14), Enum.Font.GothamBlack)
				rarLbl.Size = UDim2.new(1, 0, 1, -6)
				rarLbl.ZIndex = 24
				local oddsText, oddsColor
				if spec.noRoll then
					oddsText = "SPECIAL PRIZE — CAN'T BE ROLLED"
					oddsColor = UI_GOLD
				elseif chance then
					oddsText = ("ROLL CHANCE: 1 IN %s"):format(
						formatCommas(math.floor(chance.oneIn + 0.5)))
					oddsColor = Color3.fromRGB(205, 210, 228)
				else
					oddsText = "ROLL THE MACHINE TO FIND IT"
					oddsColor = Color3.fromRGB(205, 210, 228)
				end
				local oddsLbl = label(parent, oddsText, 14, oddsColor, Enum.Font.GothamBold)
				oddsLbl.Position = UDim2.new(0, 24, 0, viewSize + nameSize + 90)
				oddsLbl.Size = UDim2.new(1, -48, 0, 20)
				oddsLbl.TextStrokeColor3 = INK
				oddsLbl.TextStrokeTransparency = 0.2
				oddsLbl.ZIndex = 23
				if discovered then
					local tag = Instance.new("Frame")
					tag.Position = UDim2.fromOffset(10, 10)
					tag.Size = UDim2.fromOffset(190, 24)
					tag.BackgroundColor3 = UI_GOLD
					tag.BorderSizePixel = 0
					tag.ZIndex = 24
					tag.Parent = parent
					corner(tag, 9)
					local tagLbl = label(tag, "NOW SHOWING: " .. formWordOf(detailForm), 12,
						Color3.fromRGB(70, 50, 12), Enum.Font.GothamBlack)
					tagLbl.Size = UDim2.fromScale(1, 1)
					tagLbl.ZIndex = 25
				end
				if equippedKey == detailKey then
					local strip = Instance.new("Frame")
					strip.Position = UDim2.new(0, 24, 1, -60)
					strip.Size = UDim2.new(1, -48, 0, 36)
					strip.BackgroundTransparency = 1
					strip.ZIndex = 23
					strip.Parent = parent
					pixelPlate(strip, UI_GOLD, 23, "btn", 2)
					local stripLbl = label(strip,
						"ON THE MACHINE RIGHT NOW: " .. formWordOf(equippedForm), 14,
						Color3.fromRGB(70, 50, 12), Enum.Font.GothamBlack)
					stripLbl.Size = UDim2.new(1, 0, 1, -6)
					stripLbl.ZIndex = 24
				end
			end

			-- ---- stage card builder (shared anatomy, both branches) ----
			local function buildFormCard(card, form, dims)
				local owned = formCounts[form] or 0
				local locked = discovered and owned == 0 and form >= 1
				local isSel = discovered and form == detailForm
				local isEquippedHere = equippedKey == detailKey and equippedForm == form
				local accent = FORM_ACCENT[form]
				local plateFace
				if not discovered then
					plateFace = Color3.fromRGB(24, 26, 38)
				elseif isSel then
					plateFace = tierInfo.color:Lerp(UI_ROW, 0.55):Lerp(Color3.new(1, 1, 1), 0.06)
				elseif owned > 0 or form == 0 then
					plateFace = tierInfo.color:Lerp(UI_ROW, 0.78)
				else
					plateFace = UI_ROW
				end
				pixelPlate(card, plateFace, 21, "card", 3)
				pixelDither(card, 22, 0.35)
				if isSel then
					local bar = Instance.new("Frame")
					bar.Position = UDim2.new(0, 10, 0, 6)
					bar.Size = UDim2.new(1, -20, 0, 4)
					bar.BackgroundColor3 = UI_GOLD
					bar.BorderSizePixel = 0
					bar.ZIndex = 25
					bar.Parent = card
				end
				-- Preview.
				local icon = makePlanetIcon(card, spec, dims.icon, 23,
					(discovered and owned > 0) and form or 0)
				icon.Position = UDim2.new(0, dims.iconX, 0.5, -dims.icon / 2)
				if not discovered or locked then
					silhouette(icon)
					local ll = label(card, discovered and "LOCKED" or "???", 12,
						UI_SUB, Enum.Font.GothamBlack)
					ll.Position = UDim2.new(0, dims.iconX, 1, -26)
					ll.Size = UDim2.fromOffset(dims.icon, 16)
					ll.ZIndex = 24
				end
				local textX = dims.iconX + dims.icon + 14
				local textW = -(textX + dims.brickW + 32)
				-- STAGE title.
				local title = label(card,
					("STAGE %d — %s"):format(form + 1, formWordOf(form)),
					dims.title, accent, Enum.Font.GothamBlack)
				title.Position = UDim2.new(0, textX, 0, 16)
				title.Size = UDim2.new(1, textW, 0, dims.title + 6)
				title.TextXAlignment = Enum.TextXAlignment.Left
				title.TextStrokeColor3 = INK
				title.TextStrokeTransparency = 0.2
				title.ZIndex = 23
				-- OWNED.
				if discovered then
					local ownLbl = label(card, ("OWNED: %d"):format(owned),
						dims.owned, UI_GOLD, Enum.Font.GothamBlack)
					ownLbl.Position = UDim2.new(0, textX, 0, 46)
					ownLbl.Size = UDim2.new(1, textW, 0, dims.owned + 4)
					ownLbl.TextXAlignment = Enum.TextXAlignment.Left
					ownLbl.TextStrokeColor3 = INK
					ownLbl.TextStrokeTransparency = 0.2
					ownLbl.ZIndex = 23
				end
				-- PAYOUT (always shown: the three cards read as the ladder).
				local payAmount = GameConfig.fusionPayout(basePay, form)
				local payLbl = label(card,
					("PAYS %d %s EACH"):format(payAmount, payAmount == 1 and "TICKET" or "TICKETS"),
					dims.pay, Color3.fromRGB(205, 210, 228), Enum.Font.GothamBold)
				payLbl.Position = UDim2.new(0, textX, 0, discovered and 72 or 46)
				payLbl.Size = UDim2.new(1, textW, 0, dims.pay + 4)
				payLbl.TextXAlignment = Enum.TextXAlignment.Left
				payLbl.TextStrokeColor3 = INK
				payLbl.TextStrokeTransparency = 0.2
				payLbl.ZIndex = 23
				-- RECIPE / PROGRESS zone.
				local function zoneLine(text, y, color, size)
					local zl = label(card, text, size or 13, color, Enum.Font.GothamBold)
					zl.Position = UDim2.new(0, textX, 0, y)
					zl.Size = UDim2.new(1, textW, 0, 18)
					zl.TextXAlignment = Enum.TextXAlignment.Left
					zl.TextWrapped = true
					zl.TextStrokeColor3 = INK
					zl.TextStrokeTransparency = 0.3
					zl.ZIndex = 23
					return zl
				end
				if not discovered then
					zoneLine("FIND THE PLANET FIRST!", 96, UI_SUB)
				elseif locked then
					local feederOwned = formCounts[form - 1] or 0
					zoneLine("HOW TO MAKE IT:", 96, Color3.fromRGB(185, 190, 210))
					local mk = zoneLine(("FORGE %d %s INTO 1 %s"):format(
						req, formWordOf(form - 1), formWordOf(form)),
						116, Color3.new(1, 1, 1), 14)
					mk.TextStrokeTransparency = 0.2
					local ready = feederOwned >= req
					zoneLine(ready and "READY TO FORGE!"
						or ("YOU HAVE %d OF %d %s"):format(feederOwned, req, formWordOf(form - 1)),
						140, ready and Color3.fromRGB(120, 230, 140) or Color3.fromRGB(185, 190, 210))
					local track = Instance.new("Frame")
					track.Position = UDim2.new(0, textX, 0, 164)
					track.Size = UDim2.new(1, textW, 0, 14)
					track.BackgroundColor3 = UI_BG
					track.BorderSizePixel = 0
					track.ZIndex = 24
					track.Parent = card
					local fill = Instance.new("Frame")
					fill.Size = UDim2.new(math.min(feederOwned / req, 1), 0, 1, 0)
					fill.BackgroundColor3 = UI_GOLD
					fill.BorderSizePixel = 0
					fill.ZIndex = 25
					fill.Parent = track
				elseif form == 2 then
					zoneLine("THIS IS THE FINAL FORM!", 96, UI_GOLD)
				elseif owned == 0 then
					zoneLine("ROLL THE MACHINE TO GET MORE", 96, Color3.fromRGB(185, 190, 210))
				else
					zoneLine(("FORGE %d OF THESE INTO 1 %s"):format(req, formWordOf(form + 1)),
						96, Color3.fromRGB(205, 210, 228))
					if owned >= req then
						zoneLine("READY TO FORGE!", 118, Color3.fromRGB(120, 230, 140))
					end
				end
				-- ACTION brick.
				local function actionBrick(text, face, textColor, strokeColor, onClick)
					local brick = Instance.new("TextButton")
					brick.AnchorPoint = Vector2.new(1, 0.5)
					brick.Position = UDim2.new(1, -16, 0.5, 0)
					brick.Size = UDim2.fromOffset(dims.brickW, dims.brickH)
					brick.BackgroundTransparency = 1
					brick.Text = ""
					brick.ZIndex = 24
					brick.Parent = card
					pixelPlate(brick, face, 23, "btn", 2)
					local bl = label(brick, text, 15, textColor, Enum.Font.GothamBlack)
					bl.Size = UDim2.new(1, 0, 1, -6)
					bl.ZIndex = 25
					if strokeColor then
						bl.TextStrokeColor3 = strokeColor
						bl.TextStrokeTransparency = 0.3
					end
					if onClick then
						brick.MouseButton1Click:Connect(onClick)
					else
						brick.AutoButtonColor = false
					end
					return brick
				end
				if discovered and isEquippedHere then
					actionBrick("EQUIPPED", UI_GOLD, Color3.fromRGB(70, 50, 12), nil, nil)
				elseif discovered and owned > 0 then
					local eqForm = form
					actionBrick("EQUIP", UI_GREEN, Color3.new(1, 1, 1),
						Color3.fromRGB(16, 60, 30), function()
							if equipRemote then
								equipRemote:FireServer(dName, dTier, eqForm)
							end
						end)
				elseif locked then
					actionBrick("GO TO FORGE", Color3.fromRGB(150, 90, 220),
						Color3.new(1, 1, 1), Color3.fromRGB(50, 25, 80), function()
							if S.openForge then
								S.openForge(dName, dTier)
							end
						end)
				end
				-- Whole-card select (owned/base forms only — the hero never
				-- shows a locked silhouette).
				if discovered and (owned > 0 or form == 0) and form ~= detailForm then
					local selForm = form
					card.MouseButton1Click:Connect(function()
						detailForm = selForm
						renderPage()
					end)
				end
			end

			-- ---- ROW 2: the showcase ----
			if wide then
				local showRow = makeRow(648)
				showRow.BackgroundTransparency = 1
				local hero = Instance.new("Frame")
				hero.Size = UDim2.new(0.42, -8, 1, 0)
				hero.BackgroundTransparency = 1
				hero.ZIndex = 21
				hero.Parent = showRow
				buildHero(hero, 648, 320, 34)
				for form = 0, 2 do
					local card = Instance.new("TextButton")
					card.Position = UDim2.new(0.42, 8, 0, form * 219)
					card.Size = UDim2.new(0.58, -8, 0, 210)
					card.BackgroundTransparency = 1
					card.Text = ""
					card.ZIndex = 21
					card.Parent = showRow
					buildFormCard(card, form, {
						icon = 110, iconX = 16, title = 18, owned = 16, pay = 14,
						brickW = 180, brickH = 52,
					})
				end
			else
				local heroRow = makeRow(460)
				heroRow.BackgroundTransparency = 1
				buildHero(heroRow, 460, 260, 28)
				for form = 0, 2 do
					local cardRow = makeRow(200)
					cardRow.BackgroundTransparency = 1
					local card = Instance.new("TextButton")
					card.Size = UDim2.fromScale(1, 1)
					card.BackgroundTransparency = 1
					card.Text = ""
					card.ZIndex = 21
					card.Parent = cardRow
					buildFormCard(card, form, {
						icon = 104, iconX = 14, title = 17, owned = 15, pay = 13,
						brickW = 170, brickH = 48,
					})
				end
			end

			-- ---- ROW 3: how to get ----
			do
				local srcRow = makeRow(48)
				srcRow.BackgroundTransparency = 1
				pixelPlate(srcRow, Color3.fromRGB(22, 24, 36), 21, "card", 3)
				pixelDither(srcRow, 22, 0.4)
				local prefix = label(srcRow, "HOW TO GET:", 14, UI_GOLD, Enum.Font.GothamBlack)
				prefix.Position = UDim2.new(0, 18, 0, 0)
				prefix.Size = UDim2.fromOffset(110, 48)
				prefix.TextXAlignment = Enum.TextXAlignment.Left
				prefix.TextStrokeColor3 = Color3.fromRGB(60, 40, 10)
				prefix.TextStrokeTransparency = 0.4
				prefix.ZIndex = 23
				local bodyText
				if spec.noRoll then
					bodyText = specialSource[detailKey] or "SPECIAL PRIZE"
				elseif chance then
					bodyText = ("ROLL THE MACHINE — 1 IN %s CHANCE"):format(
						formatCommas(math.floor(chance.oneIn + 0.5)))
				else
					bodyText = "ROLL THE MACHINE"
				end
				local body = label(srcRow, bodyText, 14, Color3.new(1, 1, 1), Enum.Font.GothamBold)
				body.Position = UDim2.new(0, 134, 0, 0)
				body.Size = UDim2.new(1, -152, 1, 0)
				body.TextXAlignment = Enum.TextXAlignment.Left
				body.TextWrapped = true
				body.TextStrokeColor3 = INK
				body.TextStrokeTransparency = 0.2
				body.ZIndex = 23
			end

			-- ---- ROW 4: forge handoff ----
			if discovered then
				local forgeRow = makeRow(64)
				forgeRow.BackgroundTransparency = 1
				local fBtn = Instance.new("TextButton")
				fBtn.AnchorPoint = Vector2.new(0.5, 0)
				fBtn.Position = UDim2.new(0.5, 0, 0, 4)
				fBtn.Size = wide and UDim2.fromOffset(520, 54) or UDim2.new(1, -24, 0, 54)
				fBtn.BackgroundTransparency = 1
				fBtn.Text = ""
				fBtn.ZIndex = 23
				fBtn.Parent = forgeRow
				pixelPlate(fBtn, Color3.fromRGB(150, 90, 220), 22, "btn", 3)
				local fLbl = label(fBtn, "OPEN THE FORGE", 18, Color3.new(1, 1, 1), Enum.Font.GothamBlack)
				fLbl.Size = UDim2.new(1, 0, 1, -6)
				fLbl.TextStrokeColor3 = Color3.fromRGB(50, 25, 80)
				fLbl.TextStrokeTransparency = 0.25
				fLbl.ZIndex = 24
				fBtn.MouseButton1Click:Connect(function()
					if S.openForge then
						S.openForge(dName, dTier)
					end
				end)
			end
			return
		end

		-- ================= THE COLLECTION BOOK (loop-index) =================
		-- The INVENTORY tab is dead — equipping lives in the detail panel.
		-- Header: discovered bar + search + rarity chips + sort chips, then
		-- the 3-col card grid. Undiscovered cards tease honestly (no ? walls).
		local totalSpecs, discoveredTotal = 0, 0
		local tierTotals, tierDiscovered = {}, {}
		for _, spec in ipairs(PusherMachine.Planets) do
			local tier = spec.t or 1
			totalSpecs += 1
			tierTotals[tier] = (tierTotals[tier] or 0) + 1
			if invByKey[spec.n .. "|" .. tier] then
				discoveredTotal += 1
				tierDiscovered[tier] = (tierDiscovered[tier] or 0) + 1
			end
		end

		local headerRow = makeRow(46)
		headerRow.BackgroundColor3 = Color3.fromRGB(16, 17, 26)
		local discLabel = label(headerRow,
			("DISCOVERED %d / %d"):format(discoveredTotal, totalSpecs), 14,
			UI_GOLD, Enum.Font.GothamBlack)
		discLabel.Position = UDim2.new(0, 14, 0, 6)
		discLabel.Size = UDim2.new(1, -130, 0, 18) -- leaves room for the OWNED toggle
		discLabel.TextXAlignment = Enum.TextXAlignment.Left
		discLabel.ZIndex = 22
		local discBar = Instance.new("Frame")
		discBar.Position = UDim2.new(0, 14, 0, 30)
		discBar.Size = UDim2.new(1, -130, 0, 8)
		discBar.BackgroundColor3 = UI_BG
		discBar.BorderSizePixel = 0
		discBar.ZIndex = 22
		discBar.Parent = headerRow
		corner(discBar, 4)
		local discFill = Instance.new("Frame")
		discFill.Size = UDim2.new(totalSpecs > 0 and discoveredTotal / totalSpecs or 0, 0, 1, 0)
		discFill.BackgroundColor3 = UI_GOLD
		discFill.BorderSizePixel = 0
		discFill.ZIndex = 23
		discFill.Parent = discBar
		corner(discFill, 4)
		-- OWNED toggle at the right end of the header: hides the NOT FOUND
		-- YET block so the book shows only what the player holds. Its state
		-- lives on S (the main chunk is at the local cap); nil = show all.
		local ownedOnly = S.indexOwnedOnly == true
		local ownedToggle = Instance.new("TextButton")
		ownedToggle.AnchorPoint = Vector2.new(1, 0.5)
		ownedToggle.Position = UDim2.new(1, -14, 0.5, 0)
		ownedToggle.Size = UDim2.fromOffset(92, 24)
		ownedToggle.BackgroundColor3 = ownedOnly and Color3.fromRGB(52, 42, 18) or UI_ROW
		ownedToggle.BorderSizePixel = 0
		ownedToggle.Font = Enum.Font.GothamBlack
		ownedToggle.TextSize = 11
		ownedToggle.TextColor3 = ownedOnly and UI_GOLD or UI_SUB
		ownedToggle.Text = ownedOnly and "SHOW ALL" or "OWNED ONLY"
		ownedToggle.ZIndex = 22
		ownedToggle.Parent = headerRow
		corner(ownedToggle, 8)
		stroke(ownedToggle, ownedOnly and UI_GOLD or Color3.fromRGB(60, 62, 82), 1.2,
			ownedOnly and 0.25 or 0.3)
		ownedToggle.MouseButton1Click:Connect(function()
			S.indexOwnedOnly = not ownedOnly
			renderPage()
		end)

		-- Search box: FocusLost re-renders (a per-keystroke rebuild would
		-- steal the box's focus); the text survives via the state local.
		local searchRow = makeRow(40)
		searchRow.BackgroundTransparency = 1
		local searchBox = Instance.new("TextBox")
		searchBox.Size = UDim2.new(1, 0, 1, -4)
		searchBox.BackgroundColor3 = Color3.fromRGB(16, 17, 26)
		searchBox.BorderSizePixel = 0
		searchBox.Font = Enum.Font.GothamBold
		searchBox.TextSize = 13
		searchBox.TextColor3 = UI_TEXT
		searchBox.PlaceholderText = "SEARCH PLANETS..."
		searchBox.PlaceholderColor3 = UI_SUB
		searchBox.Text = indexSearch
		searchBox.ClearTextOnFocus = false
		searchBox.TextXAlignment = Enum.TextXAlignment.Left
		searchBox.ZIndex = 22
		searchBox.Parent = searchRow
		corner(searchBox, 10)
		stroke(searchBox, Color3.fromRGB(60, 62, 82), 1.4, 0.3)
		do
			local pad = Instance.new("UIPadding")
			pad.PaddingLeft = UDim.new(0, 12)
			pad.Parent = searchBox
		end
		searchBox.FocusLost:Connect(function()
			local text = searchBox.Text or ""
			if text ~= indexSearch then
				indexSearch = text
				renderPage()
			end
		end)

		-- Rarity filter chips (tier-colored, counts inside).
		local filterRow = makeRow(36)
		filterRow.BackgroundTransparency = 1
		local FILTER_SHORT = { "COMMON", "RARE", "ULTRA", "LEGEND", "SECRET" }
		local chipCount = 1 + #PusherMachine.Tiers
		for fi = 0, #PusherMachine.Tiers do
			local isAll = fi == 0
			local tierInfo = not isAll and PusherMachine.Tiers[fi] or nil
			local chipColor = isAll and UI_TEXT or tierInfo.color
			local fchip = Instance.new("TextButton")
			fchip.Position = UDim2.new(fi / chipCount, fi == 0 and 0 or 2, 0, 2)
			fchip.Size = UDim2.new(1 / chipCount, -3, 1, -6)
			fchip.BackgroundColor3 = indexFilter == fi and chipColor:Lerp(UI_BG, 0.55)
				or UI_ROW
			fchip.BorderSizePixel = 0
			fchip.Text = ""
			fchip.ZIndex = 22
			fchip.Parent = filterRow
			corner(fchip, 8)
			if indexFilter == fi then stroke(fchip, chipColor, 1.4, 0.2) end
			-- One readable 12px line (the old stacked 8px pair was under the
			-- text floor): "COMMON — 1/130".
			local fname = label(fchip,
				(isAll and "ALL" or FILTER_SHORT[fi] or tierInfo.name) .. "  —  "
					.. (isAll and (discoveredTotal .. "/" .. totalSpecs)
						or ((tierDiscovered[fi] or 0) .. "/" .. (tierTotals[fi] or 0))),
				12, chipColor, Enum.Font.GothamBlack)
			fname.Size = UDim2.fromScale(1, 1)
			fname.TextStrokeColor3 = Color3.new(0, 0, 0)
			fname.TextStrokeTransparency = 0.5
			fname.ZIndex = 23
			if indexFilter ~= fi then
				fchip.MouseButton1Click:Connect(function()
					indexFilter = fi
					renderPage()
				end)
			end
		end

		-- Sort chips.
		local sortRow = makeRow(32)
		sortRow.BackgroundTransparency = 1
		-- Kid-clear labels; the ids are the state values and stay put.
		local SORTS = {
			{ id = "rarity", labelText = "RAREST" },
			{ id = "name", labelText = "A-Z" },
			{ id = "owned", labelText = "MOST COPIES" },
			{ id = "forge", labelText = "READY TO FORGE" },
			{ id = "equipped", labelText = "EQUIPPED" },
		}
		for si, sortDef in ipairs(SORTS) do
			local chipBtn = Instance.new("TextButton")
			chipBtn.Position = UDim2.new((si - 1) / #SORTS, si == 1 and 0 or 2, 0, 2)
			chipBtn.Size = UDim2.new(1 / #SORTS, -3, 1, -6)
			chipBtn.BorderSizePixel = 0
			chipBtn.Font = Enum.Font.GothamBlack
			chipBtn.TextSize = 12
			-- Scaled with a floor: five chips squeeze on 2-col phones and
			-- "READY TO FORGE" must never paint past the chip edge.
			chipBtn.TextScaled = true
			local chipFit = Instance.new("UITextSizeConstraint")
			chipFit.MinTextSize = 9
			chipFit.MaxTextSize = 12
			chipFit.Parent = chipBtn
			local chipPad = Instance.new("UIPadding")
			chipPad.PaddingLeft = UDim.new(0, 4)
			chipPad.PaddingRight = UDim.new(0, 4)
			chipPad.Parent = chipBtn
			chipBtn.Text = sortDef.labelText
			chipBtn.ZIndex = 22
			chipBtn.Parent = sortRow
			corner(chipBtn, 8)
			if indexSort == sortDef.id then
				chipBtn.BackgroundColor3 = Color3.fromRGB(52, 42, 18)
				chipBtn.TextColor3 = UI_GOLD
				stroke(chipBtn, UI_GOLD, 1.2, 0.25)
			else
				chipBtn.BackgroundColor3 = UI_ROW
				chipBtn.TextColor3 = UI_SUB
				local pick = sortDef.id
				chipBtn.MouseButton1Click:Connect(function()
					indexSort = pick
					renderPage()
				end)
			end
		end

		-- NEXT GOAL chip: closest pending forge, in forge language
		-- (loop-index §2); discovery goal when nothing is close.
		local bestKey, bestName, bestFrom, bestHave, bestReq, bestFrac = nil, nil, nil, 0, 0, nil
		for _, entry in ipairs(ownedBalls) do
			if (entry.f2 or 0) <= 0 then
				local fromForm, have, req = nextFusion(entry, entry.t)
				if fromForm ~= nil then
					local frac = have / req
					if bestFrac == nil or frac > bestFrac then
						bestFrac = frac
						bestKey = entry.n .. "|" .. entry.t
						bestName = entry.n
						bestFrom, bestHave, bestReq = fromForm, have, req
					end
				end
			end
		end
		if bestKey and bestFrac and bestFrac >= 0.5 then
			local goalRow = makeRow(32)
			goalRow.BackgroundTransparency = 1
			local goalBtn = Instance.new("TextButton")
			goalBtn.Size = UDim2.new(1, 0, 1, -4)
			goalBtn.BackgroundColor3 = Color3.fromRGB(40, 34, 18)
			goalBtn.BorderSizePixel = 0
			goalBtn.Font = Enum.Font.GothamBlack
			goalBtn.TextSize = 13
			goalBtn.TextColor3 = UI_GOLD
			goalBtn.Text = bestHave >= bestReq
				and ("NEXT: %s %d/%d → FORGE!"):format(bestName:upper(),
					math.min(bestHave, bestReq), bestReq)
				or ("NEXT: %s %d/%d → %s"):format(bestName:upper(),
					math.min(bestHave, bestReq), bestReq,
					GameConfig.FormNames[bestFrom + 2] or "?")
			goalBtn.ZIndex = 22
			goalBtn.Parent = goalRow
			corner(goalBtn, 8)
			stroke(goalBtn, UI_GOLD, 1.2, 0.4)
			local goalKey, goalForm = bestKey, bestFrom
			goalBtn.MouseButton1Click:Connect(function()
				detailKey = goalKey
				detailForm = goalForm
				renderPage()
			end)
		else
			local goalRow = makeRow(32)
			goalRow.BackgroundTransparency = 1
			local goalLbl = label(goalRow,
				("FIND SOMETHING NEW! %d/%d"):format(discoveredTotal, totalSpecs),
				13, UI_GOLD, Enum.Font.GothamBlack)
			goalLbl.Size = UDim2.new(1, 0, 1, -4)
			goalLbl.ZIndex = 22
		end

		-- Build + filter + sort the card list. Search never leaks
		-- undiscovered names (matching hidden planets would spoil them).
		local specs = {}
		local searchLower = indexSearch:lower()
		for _, spec in ipairs(PusherMachine.Planets) do
			local tier = spec.t or 1
			local key = spec.n .. "|" .. tier
			local entry = invByKey[key]
			local pass = indexFilter == 0 or tier == indexFilter
			-- OWNED ONLY drops unfound planets entirely (same discovered
			-- predicate as the DISCOVERED bar: presence in the inventory).
			if pass and ownedOnly then pass = entry ~= nil end
			if pass and searchLower ~= "" then
				pass = entry ~= nil and spec.n:lower():find(searchLower, 1, true) ~= nil
			end
			if pass then table.insert(specs, spec) end
		end
		local function totalOwnedOf(entry)
			local a, b, c2 = countsOf(entry)
			return a + b + c2
		end
		local function forgeFracOf(entry, tier)
			if not entry then return 0 end
			local fromForm, have, fReq = nextFusion(entry, tier)
			if fromForm == nil then return 0 end
			return have / fReq
		end
		table.sort(specs, function(a, b)
			local at, bt = a.t or 1, b.t or 1
			local ak, bk = a.n .. "|" .. at, b.n .. "|" .. bt
			local ae, be = invByKey[ak], invByKey[bk]
			-- Found planets always lead; unfound trail in EVERY sort.
			if (ae ~= nil) ~= (be ~= nil) then return ae ~= nil end
			if indexSort == "name" then
				if a.n ~= b.n then return a.n < b.n end
				return at < bt
			elseif indexSort == "owned" then
				local ao, bo = totalOwnedOf(ae), totalOwnedOf(be)
				if ao ~= bo then return ao > bo end
			elseif indexSort == "forge" then
				local af = canCombine(ae, at) and 1 or 0
				local bf = canCombine(be, bt) and 1 or 0
				if af ~= bf then return af > bf end
				local afr, bfr = forgeFracOf(ae, at), forgeFracOf(be, bt)
				if afr ~= bfr then return afr > bfr end
			elseif indexSort == "equipped" then
				local aq = ak == equippedKey and 1 or 0
				local bq = bk == equippedKey and 1 or 0
				if aq ~= bq then return aq > bq end
				local ao, bo = totalOwnedOf(ae), totalOwnedOf(be)
				if ao ~= bo then return ao > bo end
			end
			-- RAREST: found planets rarest-first (the trophies), unfound
			-- commonest-first (the next likely finds). Other sorts keep
			-- their commonest-first tiebreak.
			if at ~= bt then
				if indexSort == "rarity" and ae ~= nil then return at > bt end
				return at < bt
			end
			return a.n < b.n
		end)

		-- Card grid — ADAPTIVE columns (owner order: reflow, never shrink the
		-- cards). The panel's real design-px width picks the column count:
		-- 2 on phones, up to 6 on wide desktops. Cards carry ONLY the browse
		-- facts (name / rarity / OWNED: N / form / equipped / forge-ready);
		-- everything else lives in the detail panel. No shorthand.
		local sNow = math.max(hudScale.Scale, 0.01)
		local vpW = camera.ViewportSize.X / sNow
		local panelW = math.min(vpW * 0.94, 1380) - 28
		local cols = math.clamp(math.floor(panelW / 168), 2, 6)
		local CARD_H = 196
		-- Row plan. The default RAREST view (no search) splits the list
		-- into YOUR PLANETS / NOT FOUND YET, each under a section header
		-- on its own grid rows (the second grid never shares a row with
		-- the first). Other sorts and searches stay one flat grid. specs
		-- is already sorted found-first, so the split is a prefix.
		local gridRows = {}
		local function planRows(from, to, header, headerColor)
			if header then
				table.insert(gridRows, { header = header, color = headerColor })
			end
			for base = from, to, cols do
				local cards = {}
				for col = 0, cols - 1 do
					if base + col <= to then cards[col + 1] = specs[base + col] end
				end
				table.insert(gridRows, { cards = cards })
			end
		end
		if indexSort == "rarity" and searchLower == "" then
			local foundCount = 0
			for _, spec in ipairs(specs) do
				if invByKey[spec.n .. "|" .. (spec.t or 1)] then foundCount += 1 end
			end
			if foundCount > 0 then
				planRows(1, foundCount, ("YOUR PLANETS — %d"):format(foundCount), UI_GOLD)
			end
			if foundCount < #specs then
				planRows(foundCount + 1, #specs,
					("NOT FOUND YET — %d"):format(#specs - foundCount), UI_SUB)
			end
		else
			planRows(1, #specs, nil, nil)
		end
		if #specs == 0 then
			-- Empty state (OWNED ONLY + a rarity with nothing owned, or a
			-- search with no hits) — never a blank page for a kid.
			local emptyRow = makeRow(40)
			emptyRow.BackgroundTransparency = 1
			local emptyText = label(emptyRow, "NOTHING HERE YET — ROLL TO FIND PLANETS!",
				13, UI_SUB, Enum.Font.GothamBlack)
			emptyText.Size = UDim2.fromScale(1, 1)
			emptyText.ZIndex = 22
		end
		for _, planRow in ipairs(gridRows) do
			if planRow.header then
				local headRow = makeRow(30)
				headRow.BackgroundTransparency = 1
				local headText = label(headRow, planRow.header, 13, planRow.color,
					Enum.Font.GothamBlack)
				headText.Position = UDim2.new(0, 6, 0, 0)
				headText.Size = UDim2.new(1, -12, 1, 0)
				headText.TextXAlignment = Enum.TextXAlignment.Left
				headText.ZIndex = 22
				continue
			end
			local gridRow = makeRow(CARD_H)
			gridRow.BackgroundTransparency = 1
			for col = 0, cols - 1 do
				local spec = planRow.cards[col + 1]
				if spec then
					local tier = spec.t or 1
					local key = spec.n .. "|" .. tier
					local tierInfo = PusherMachine.Tiers[tier] or PusherMachine.Tiers[1]
					local entry = invByKey[key]
					local ec, ef1, ef2 = countsOf(entry)
					local bestForm = ef2 > 0 and 2 or (ef1 > 0 and 1 or 0)
					local card = Instance.new("TextButton")
					card.Position = UDim2.new(col / cols, 3, 0, 0)
					card.Size = UDim2.new(1 / cols, -6, 1, -6)
					card.Text = ""
					card.BackgroundTransparency = 1
					card.BorderSizePixel = 0
					card.ZIndex = 22
					card.Parent = gridRow
					-- Pixel-art card face: owned cards take a lift of their
					-- rarity colour, undiscovered stay neutral. The pixel plate
					-- carries the stepped corners + hard outline, so no
					-- UICorner/UIStroke here (they would round it off again).
					local cardFace = UI_ROW
					if entry and ec + ef1 + ef2 > 0 then
						cardFace = tierInfo.color:Lerp(UI_ROW, tier >= 2 and 0.7 or 0.82)
					end
					pixelPlate(card, cardFace, 21, "card", 3)
					pixelDither(card, 22, 0.35)
					local icon = makePlanetIcon(card, spec, 84, 23, entry and bestForm or 0)
					icon.Position = UDim2.new(0.5, -42, 0, 8)
					if not entry then
						-- Soft silhouette: dim tint, the shape still teases.
						for _, art in ipairs(icon:GetChildren()) do
							if art:IsA("ImageLabel") then
								art.ImageColor3 = Color3.fromRGB(52, 56, 78)
								art.ImageTransparency = 0.2
							end
						end
					end
					if key == equippedKey then
						local eqTag = Instance.new("Frame")
						eqTag.Position = UDim2.new(0, 5, 0, 5)
						eqTag.Size = UDim2.fromOffset(76, 18)
						eqTag.BackgroundColor3 = UI_GOLD
						eqTag.BorderSizePixel = 0
						eqTag.ZIndex = 24
						eqTag.Parent = card
						corner(eqTag, 9)
						local eqText = label(eqTag, "EQUIPPED", 10,
							Color3.fromRGB(70, 50, 12), Enum.Font.GothamBlack)
						eqText.Size = UDim2.fromScale(1, 1)
						eqText.ZIndex = 25
					end
					if entry and canCombine(entry, tier) then
						local forgeTag = Instance.new("Frame")
						forgeTag.AnchorPoint = Vector2.new(1, 0)
						forgeTag.Position = UDim2.new(1, -5, 0, 5)
						forgeTag.Size = UDim2.fromOffset(66, 18)
						forgeTag.BackgroundColor3 = Color3.fromRGB(30, 120, 56)
						forgeTag.BorderSizePixel = 0
						forgeTag.ZIndex = 24
						forgeTag.Parent = card
						corner(forgeTag, 9)
						local forgeText = label(forgeTag, "READY!", 11,
							Color3.new(1, 1, 1), Enum.Font.GothamBlack)
						forgeText.TextStrokeColor3 = Color3.fromRGB(16, 60, 30)
						forgeText.TextStrokeTransparency = 0.3
						forgeText.Size = UDim2.fromScale(1, 1)
						forgeText.ZIndex = 25
					end
					local cardName = label(card, entry and spec.n or "???", 14,
						entry and (tier >= 2 and tierInfo.color or UI_TEXT) or UI_SUB,
						Enum.Font.GothamBold)
					cardName.Position = UDim2.new(0, 6, 0, 96)
					cardName.Size = UDim2.new(1, -12, 0, 17)
					cardName.TextTruncate = Enum.TextTruncate.AtEnd
					cardName.ZIndex = 23
					local cardRarity = Instance.new("Frame")
					cardRarity.AnchorPoint = Vector2.new(0.5, 0)
					cardRarity.Position = UDim2.new(0.5, 0, 0, 117)
					cardRarity.Size = UDim2.fromOffset(100, 18)
					cardRarity.BackgroundColor3 = tierInfo.color:Lerp(UI_BG, 0.65)
					cardRarity.BorderSizePixel = 0
					cardRarity.ZIndex = 23
					cardRarity.Parent = card
					corner(cardRarity, 9)
					local cardRarityText = label(cardRarity, tierInfo.name, 12,
						tier >= 2 and tierInfo.color or UI_SUB, Enum.Font.GothamBlack)
					cardRarityText.Size = UDim2.fromScale(1, 1)
					cardRarityText.ZIndex = 24
					if entry then
						local ownLabel = label(card,
							("OWNED: %d"):format(ec + ef1 + ef2), 13,
							UI_GOLD, Enum.Font.GothamBlack)
						ownLabel.Position = UDim2.new(0, 6, 0, 140)
						ownLabel.Size = UDim2.new(1, -12, 0, 16)
						ownLabel.ZIndex = 23
						local formLine = label(card,
							bestForm > 0 and ("BEST FORM: " .. (formNames[bestForm + 1] or "?"))
								or "FORM: BASE",
							12, bestForm >= 2 and UI_GOLD
								or bestForm == 1 and Color3.fromRGB(210, 170, 255) or UI_SUB,
							Enum.Font.GothamBold)
						formLine.Position = UDim2.new(0, 6, 0, 160)
						formLine.Size = UDim2.new(1, -12, 0, 15)
						formLine.ZIndex = 23
					else
						-- Honest roll hint instead of a ? wall.
						local hintChance = chanceByKey[key]
						local hintText
						if spec.noRoll then
							hintText = "SPECIAL PRIZE"
						elseif hintChance then
							hintText = "ROLL CHANCE: 1 in "
								.. formatCommas(math.floor(hintChance.oneIn + 0.5))
						else
							hintText = "ROLL TO FIND IT"
						end
						local hintLabel = label(card, hintText, 12, UI_SUB, Enum.Font.GothamBold)
						hintLabel.Position = UDim2.new(0, 6, 0, 140)
						hintLabel.Size = UDim2.new(1, -12, 0, 34)
						hintLabel.TextWrapped = true
						hintLabel.ZIndex = 23
					end
					local cardKey, cardForm = key, entry and bestForm or 0
					card.MouseButton1Click:Connect(function()
						detailKey = cardKey
						detailForm = cardForm
						renderPage()
					end)
				end
			end
		end
	elseif openPage == "galaxy" or openPage == "rebirth" then
		-- Rebirth is deliberately its OWN sidebar button (owner call): it is
		-- the progression heartbeat, not a tab buried inside zones.
		panelTitle.Text = openPage == "galaxy" and "GALAXY" or "REBIRTH"
		if openPage == "galaxy" then
			local selected = remotes and remotes:GetAttribute("Zone") or 1
			for index, theme in ipairs(PusherMachine.Themes) do
				local row = makeRow(68)
				if index == selected then
					row.BackgroundColor3 = Color3.fromRGB(24, 42, 28)
					stroke(row, UI_GREEN, 1.8, 0.25)
				end

				-- Real render of the zone, straight from the theme lab.
				local thumb = Instance.new("ImageLabel")
				thumb.Image = ZONE_THUMBS[index] or ""
				thumb.BackgroundColor3 = UI_BG
				thumb.BorderSizePixel = 0
				thumb.Size = UDim2.fromOffset(76, 57)
				thumb.Position = UDim2.new(0, 8, 0.5, -28)
				thumb.ScaleType = Enum.ScaleType.Crop
				thumb.ZIndex = 22
				thumb.Parent = row
				corner(thumb, 8)
				stroke(thumb, theme.colTeal or CFG.colTeal, 1.6, 0.35)

				local nameLabel = label(row, theme.displayName or theme.id, 16)
				nameLabel.Position = UDim2.new(0, 96, 0, 12)
				nameLabel.Size = UDim2.new(1, -250, 0, 18)
				nameLabel.TextXAlignment = Enum.TextXAlignment.Left
				nameLabel.ZIndex = 22

				local multPill = Instance.new("Frame")
				multPill.Position = UDim2.new(0, 96, 0, 36)
				multPill.Size = UDim2.fromOffset(64, 20)
				multPill.BackgroundColor3 = Color3.fromRGB(52, 42, 18)
				multPill.BorderSizePixel = 0
				multPill.ZIndex = 22
				multPill.Parent = row
				corner(multPill, 10)
				local multLabel = label(multPill,
					"×" .. (GameConfig.Zones.mults[index] or 1) .. " TIX", 11, UI_GOLD, Enum.Font.GothamBold)
				multLabel.Size = UDim2.fromScale(1, 1)
				multLabel.ZIndex = 23

				local pick = Instance.new("TextButton")
				pick.Size = UDim2.fromOffset(120, 36)
				pick.AnchorPoint = Vector2.new(1, 0.5)
				pick.Position = UDim2.new(1, -12, 0.5, 0)
				pick.BorderSizePixel = 0
				pick.Font = Enum.Font.GothamBlack
				pick.TextSize = 14
				pick.ZIndex = 22
				local zoneReq = GameConfig.Zones.reqs[index] or 0
				local locked = (player:GetAttribute("Rebirth") or 0) < zoneReq
				if index == selected then
					pick.Text = "SELECTED"
					pick.BackgroundColor3 = UI_GREEN
					pick.TextColor3 = Color3.new(1, 1, 1)
				elseif locked then
					-- Contextual link (addendum §5): the locked row routes
					-- straight to the REBIRTH page.
					pick.Text = zoneReq .. " REBIRTHS >"
					pick.BackgroundColor3 = UI_BG
					pick.TextColor3 = UI_SUB
					row.BackgroundTransparency = 0.4
					thumb.ImageTransparency = 0.45
					nameLabel.TextTransparency = 0.35
					pick.MouseButton1Click:Connect(function()
						S.openPanelPage("rebirth")
					end)
				else
					pick.Text = "SELECT"
					pick.BackgroundColor3 = UI_BG
					pick.TextColor3 = UI_TEXT
					pick.MouseButton1Click:Connect(function()
						if zoneRemote then zoneRemote:FireServer(index) end
						panel.Visible = false
						openPage = nil
