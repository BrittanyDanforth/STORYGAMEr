local UI_BG = Color3.fromRGB(18, 19, 28)
local UI_PANEL = Color3.fromRGB(23, 24, 35)
local UI_ROW = Color3.fromRGB(33, 35, 50)
local UI_TEXT = Color3.fromRGB(240, 242, 250)
local UI_SUB = Color3.fromRGB(150, 155, 175)
local UI_GOLD = Color3.fromRGB(255, 200, 80)
local UI_GREEN = Color3.fromRGB(80, 190, 100)

local function corner(parent, radius)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, radius or 10)
	c.Parent = parent
	return c
end

local function stroke(parent, color, thickness, transparency)
	local s = Instance.new("UIStroke")
	-- Border, NEVER Contextual: on text objects Contextual outlines the
	-- GLYPHS in the border color (gold text + gold glyph halo = the mushy
	-- "AI slop" look the owner flagged). Borders belong on the pill; glyph
	-- outlines use TextStrokeColor3 in a DARK shade, never the text hue.
	s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	s.Color = color or Color3.new(0, 0, 0)
	s.Thickness = thickness or 2
	s.Transparency = transparency or 0.3
	s.Parent = parent
	return s
end

local function label(parent, text, size, color, font)
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1
	l.Text = text
	l.TextColor3 = color or UI_TEXT
	l.TextSize = size or 16
	l.Font = font or Enum.Font.GothamBold
	l.Parent = parent
	return l
end

