				corner(pick, 10)
				pick.Parent = row
			end
		else
			-- ======================= REBIRTH PAGE =======================
			-- Built like RANKS: pixel-brick plates, one pinned hero with a
			-- huge FredokaOne number, kid-word copy, one giant button.
			-- Every KEEP / RESET line mirrors ServerInit's rebirthRemote
			-- handler exactly: Tickets -> 0 (the whole balance), every tree
			-- node wiped except resetsOnRebirth = false ones (Outer Surge,
			-- Twin Surge, Cheaper Forge), Rebirth + 1, thrones re-checked
			-- (they only ever go UP). Planets, dust, forge forms, shop perks
			-- and streak are never touched there — so they are "kept".
			local rebirth = player:GetAttribute("Rebirth") or 0
			local cost = GameConfig.rebirthCost(rebirth) -- nil at MaxRebirth
			local tickets = player:GetAttribute("Tickets") or 0
			local maxed = cost == nil
			local RB_RED = Color3.fromRGB(210, 72, 98)
			local RB_PINK = Color3.fromRGB(255, 160, 180)
			local RB_INK = Color3.fromRGB(12, 13, 20)
			local RB_STAGE = Color3.fromRGB(16, 17, 26)
			local RB_MINT = Color3.fromRGB(120, 230, 140)
			local multNow = GameConfig.rebirthTicketMult(rebirth)
			local multNext = GameConfig.rebirthTicketMult(math.min(rebirth + 1, GameConfig.MaxRebirth))
			local function fmtMult(m)
				return ("%gx"):format(m)
			end

			-- Entrance fade (the RANKS pattern): plays on open and again
			-- after each rebirth (the number changed), never on the
			-- per-collect Tickets re-renders. Closing the panel clears the
			-- key so the next open fades again (hook connected once).
			if not S.rebirthFadeHook then
				S.rebirthFadeHook = true
				panel:GetPropertyChangedSignal("Visible"):Connect(function()
					if not panel.Visible then S.rebirthFadeKey = nil; S.rebirthArmedUntil = 0 end
				end)
				panelTitle:GetPropertyChangedSignal("Text"):Connect(function()
					if panelTitle.Text ~= "REBIRTH" then S.rebirthFadeKey = nil; S.rebirthArmedUntil = 0 end
				end)
			end
			local fadeKey = "rb" .. tostring(rebirth)
			local animateEntrance = S.rebirthFadeKey ~= fadeKey
			S.rebirthFadeKey = fadeKey
			local fadeOrder = 0
			local function fadeIn(block)
				if S.reducedMotion or not animateEntrance then return end
				local info = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out,
					0, false, fadeOrder * 0.03)
				fadeOrder = fadeOrder + 1
				local function fade(obj, prop)
					local target = obj[prop]
					if target >= 1 then return end
					obj[prop] = 1
					TweenService:Create(obj, info, { [prop] = target }):Play()
				end
				fade(block, "BackgroundTransparency")
				for _, obj in ipairs(block:GetDescendants()) do
					if obj:IsA("TextLabel") or obj:IsA("TextButton") then
						fade(obj, "TextTransparency")
						fade(obj, "TextStrokeTransparency")
						fade(obj, "BackgroundTransparency")
					elseif obj:IsA("ImageLabel") then
						fade(obj, "ImageTransparency")
						fade(obj, "BackgroundTransparency")
					elseif obj:IsA("Frame") then
						fade(obj, "BackgroundTransparency")
					elseif obj:IsA("UIStroke") then
						fade(obj, "Transparency")
					end
				end
			end

			-- Thin progress bar: dark track, coloured fill, frac 0..1.
			local function progressBar(parent, posU, sizeU, frac, color, zindex)
				local track = Instance.new("Frame")
				track.Position = posU
				track.Size = sizeU
				track.BackgroundColor3 = RB_STAGE
				track.BorderSizePixel = 0
				track.ZIndex = zindex
				track.Parent = parent
				corner(track, 3)
				stroke(track, Color3.new(0, 0, 0), 1, 0.6)
				local fill = Instance.new("Frame")
				fill.Size = UDim2.new(math.clamp(frac, 0, 1), 0, 1, 0)
				fill.BackgroundColor3 = color
				fill.BorderSizePixel = 0
				fill.ZIndex = zindex + 1
				fill.Parent = track
				corner(fill, 3)
				return track
			end

			-- Half-width pixel brick inside a transparent row (x = 0 or 0.5).
			local function halfBrick(row, x, face)
				local brick = Instance.new("Frame")
				brick.Position = UDim2.new(x, x > 0 and 4 or 0, 0, 0)
				brick.Size = UDim2.new(0.5, -4, 1, 0)
				brick.BackgroundTransparency = 1
				brick.ZIndex = 22
				brick.Parent = row
				pixelPlate(brick, face, 22, "card", 3)
				pixelDither(brick, 23, 0.5)
				return brick
			end

			-- ---- HERO: "REBIRTH 7 / 50 MAX" + the promise + the NOW chip ----
			do
				local hero = makeRow(116)
				hero.BackgroundTransparency = 1
				pixelPlate(hero, Color3.fromRGB(66, 22, 36), 21, "card", 3)
				pixelDither(hero, 22, 0.4)
				local eyebrow = label(hero, "REBIRTH", 12, RB_PINK, Enum.Font.GothamBlack)
				eyebrow.Position = UDim2.new(0, 14, 0, 10)
				eyebrow.Size = UDim2.new(1, -170, 0, 14)
				eyebrow.TextXAlignment = Enum.TextXAlignment.Left
				eyebrow.ZIndex = 23
				-- "7  / 50 MAX": the number sizes itself; the cap sits on its baseline.
				local numRow = Instance.new("Frame")
				numRow.BackgroundTransparency = 1
				numRow.Position = UDim2.new(0, 14, 0, 24)
				numRow.Size = UDim2.new(1, -170, 0, 54)
				numRow.ZIndex = 23
				numRow.Parent = hero
				local numLayout = Instance.new("UIListLayout")
				numLayout.FillDirection = Enum.FillDirection.Horizontal
				numLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
				numLayout.SortOrder = Enum.SortOrder.LayoutOrder
				numLayout.Padding = UDim.new(0, 8)
				numLayout.Parent = numRow
				local num = label(numRow, tostring(rebirth), 48, Color3.new(1, 1, 1), Enum.Font.FredokaOne)
				num.AutomaticSize = Enum.AutomaticSize.X
				num.Size = UDim2.new(0, 0, 1, 0)
				num.LayoutOrder = 1
				num.TextStrokeColor3 = RB_INK
				num.TextStrokeTransparency = 0.3
				num.ZIndex = 23
				local cap = label(numRow, "/ " .. GameConfig.MaxRebirth .. " MAX", 13, UI_SUB, Enum.Font.GothamBlack)
				cap.AutomaticSize = Enum.AutomaticSize.X
				cap.Size = UDim2.new(0, 0, 0, 26)
				cap.LayoutOrder = 2
				cap.ZIndex = 23
				-- NOW chip: the multiplier you already earn, on a red brick.
				local chip = Instance.new("Frame")
				chip.AnchorPoint = Vector2.new(1, 0)
				chip.Position = UDim2.new(1, -14, 0, 12)
				chip.Size = UDim2.fromOffset(140, 34)
				chip.BackgroundTransparency = 1
				chip.ZIndex = 23
				chip.Parent = hero
				pixelPlate(chip, RB_RED, 23, "btn", 2)
				local chipText = label(chip, "NOW: " .. fmtMult(multNow) .. " TIX", 15, Color3.new(1, 1, 1), Enum.Font.FredokaOne)
				chipText.Size = UDim2.new(1, 0, 1, -5)
				chipText.TextStrokeColor3 = Color3.fromRGB(90, 20, 36)
				chipText.TextStrokeTransparency = 0.2
				chipText.ZIndex = 24
				-- The promise, one line, next multiplier in the sentence.
				local promise = label(hero,
					maxed and ("YOU EARN " .. fmtMult(multNow) .. " TICKETS FOREVER — MAXED " .. STAR_GLYPH)
					or ("RESET TICKETS + UPGRADES → EARN " .. fmtMult(multNext) .. " TICKETS FOREVER"),
					13, UI_GOLD, Enum.Font.GothamBlack)
				promise.Position = UDim2.new(0, 14, 0, 86)
				promise.Size = UDim2.new(1, -28, 0, 18)
				promise.TextTruncate = Enum.TextTruncate.AtEnd
				promise.TextXAlignment = Enum.TextXAlignment.Left
				promise.ZIndex = 23
				fadeIn(hero)
			end

			-- ---- YOU KEEP / RESETS: two bricks, three kid-word lines each ----
			do
				local deal = makeRow(100)
				deal.BackgroundTransparency = 1
				local BULLET = utf8.char(8226) .. " "
				local function dealBrick(x, face, head, headColor, lines, lineColor)
					local brick = halfBrick(deal, x, face)
					local h = label(brick, head, 12, headColor, Enum.Font.GothamBlack)
					h.Position = UDim2.new(0, 12, 0, 8)
					h.Size = UDim2.new(1, -24, 0, 16)
					h.TextXAlignment = Enum.TextXAlignment.Left
					h.ZIndex = 24
					for i, line in ipairs(lines) do
						local dim = line:sub(1, 1) == "("
						local l = label(brick, BULLET .. line, dim and 11 or 12,
							dim and UI_SUB or lineColor, Enum.Font.GothamBold)
						l.Position = UDim2.new(0, 12, 0, 28 + (i - 1) * 21)
						l.Size = UDim2.new(1, -24, 0, 18)
						l.TextTruncate = Enum.TextTruncate.AtEnd
						l.TextXAlignment = Enum.TextXAlignment.Left
						l.ZIndex = 24
					end
				end
				dealBrick(0, Color3.fromRGB(22, 54, 34), "YOU KEEP", RB_MINT, {
					"EVERY PLANET YOU FOUND",
					"STAR DUST + FORGED FORMS",
					"THRONES + SHOP PERKS",
				}, UI_TEXT)
				dealBrick(0.5, Color3.fromRGB(66, 24, 32), "RESETS", RB_PINK, {
					"ALL TICKETS GO TO 0",
					"ALL UPGRADES GO TO 0",
					"(SURGE + FORGE NODES STAY)",
				}, Color3.fromRGB(255, 205, 214))
				fadeIn(deal)
			end

			-- ---- NEXT UNLOCKS: the zone and the throne this ladder reaches ----
			do
				-- First zone above you; when every zone is open, the deepest
				-- one wears UNLOCKED. Same rule for the centre-spine thrones.
				local zoneIdx, zoneReq = nil, nil
				for zi, req in ipairs(GameConfig.Zones.reqs) do
					if req > rebirth then
						zoneIdx, zoneReq = zi, req
						break
					end
				end
				if not zoneIdx then
					zoneIdx = #GameConfig.Zones.reqs
					zoneReq = GameConfig.Zones.reqs[zoneIdx] or 0
				end
				local throne = nil
				for _, t in ipairs(GameConfig.Spine) do
					if (t.gate and t.gate.rebirth or 0) > rebirth then
						throne = t
						break
					end
				end
				if not throne then throne = GameConfig.Spine[#GameConfig.Spine] end

				local unlocks = makeRow(104)
				unlocks.BackgroundTransparency = 1
				local function unlockBrick(x, tint, iconW, eyebrowText, name, perk, req)
					local brick = halfBrick(unlocks, x, RB_STAGE)
					local tx = 12 + iconW + (iconW > 0 and 8 or 0)
					local reached = rebirth >= req
					local nextOne = (not reached) and req == rebirth + 1
					local eb = label(brick, eyebrowText, 11, tint, Enum.Font.GothamBlack)
					eb.Position = UDim2.new(0, tx, 0, 8)
					eb.Size = UDim2.new(1, -tx - 10, 0, 14)
					eb.TextXAlignment = Enum.TextXAlignment.Left
					eb.ZIndex = 24
					local nm = label(brick, name, 13, UI_TEXT, Enum.Font.GothamBlack)
					nm.Position = UDim2.new(0, tx, 0, 23)
					nm.Size = UDim2.new(1, -tx - 10, 0, 16)
					nm.TextTruncate = Enum.TextTruncate.AtEnd
					nm.TextXAlignment = Enum.TextXAlignment.Left
					nm.ZIndex = 24
					-- Two lines: "5x TICKETS + 2x DUST FOREVER" is wider than
					-- a half brick beside a 40px icon.
					local pk = label(brick, perk, 12, UI_GOLD, Enum.Font.GothamBold)
					pk.Position = UDim2.new(0, tx, 0, 39)
					pk.Size = UDim2.new(1, -tx - 10, 0, 28)
					pk.TextWrapped = true
					pk.TextTruncate = Enum.TextTruncate.AtEnd
					pk.TextXAlignment = Enum.TextXAlignment.Left
					pk.TextYAlignment = Enum.TextYAlignment.Top
					pk.ZIndex = 24
					local st = label(brick,
						reached and "UNLOCKED " .. CHECK_GLYPH
						or nextOne and "THIS REBIRTH!"
						or ("AT REBIRTH " .. req),
						11, reached and UI_GREEN or nextOne and RB_MINT or RB_PINK, Enum.Font.GothamBlack)
					st.Position = UDim2.new(0, 12, 0, 68)
					st.Size = UDim2.new(1, -24, 0, 14)
					st.TextXAlignment = Enum.TextXAlignment.Left
					st.ZIndex = 24
					progressBar(brick, UDim2.new(0, 12, 0, 86), UDim2.new(1, -24, 0, 8),
						reached and 1 or rebirth / math.max(req, 1),
						reached and UI_GREEN or tint, 24)
					return brick
				end

				local zoneBrick = unlockBrick(0, Color3.fromRGB(90, 210, 200), 56, "NEXT ZONE",
					(PusherMachine.Themes[zoneIdx] and PusherMachine.Themes[zoneIdx].displayName)
						or ("ZONE " .. zoneIdx),
					"×" .. (GameConfig.Zones.mults[zoneIdx] or 1) .. " TICKETS THERE", zoneReq)
				local zThumb = Instance.new("ImageLabel")
				zThumb.Image = ZONE_THUMBS[zoneIdx] or ""
				zThumb.BackgroundColor3 = UI_BG
				zThumb.BorderSizePixel = 0
				zThumb.Size = UDim2.fromOffset(56, 42)
				zThumb.Position = UDim2.new(0, 12, 0, 12)
				zThumb.ScaleType = Enum.ScaleType.Crop
				zThumb.ZIndex = 24
				zThumb.Parent = zoneBrick
				corner(zThumb, 6)
				stroke(zThumb, Color3.fromRGB(90, 210, 200), 1.4, 0.4)

				if throne then
					local throneBrick = unlockBrick(0.5, UI_GOLD, 40, "NEXT THRONE",
						tostring(throne.name or "?"):upper(), tostring(throne.desc or ""),
						throne.gate and throne.gate.rebirth or 0)
					local crown = Instance.new("ImageLabel")
					crown.Image = ACH_ICONS.crown
					crown.BackgroundTransparency = 1
					crown.ImageColor3 = UI_GOLD
					crown.Size = UDim2.fromOffset(40, 40)
					crown.Position = UDim2.new(0, 12, 0, 13)
					crown.ZIndex = 24
					crown.Parent = throneBrick
				end
				fadeIn(unlocks)
			end

			-- ---- THE BUTTON: one full-width 60px brick, three looks ----
			do
				local affordable = (not maxed) and tickets >= cost
				local btnRow = makeRow((maxed or affordable) and 64 or 80)
				btnRow.BackgroundTransparency = 1
				local btn = Instance.new("TextButton")
				btn.Size = UDim2.new(1, 0, 0, 60)
				btn.BackgroundTransparency = 1
				btn.Text = ""
				btn.AutoButtonColor = false
				btn.ZIndex = 22
				btn.Parent = btnRow
				local face = pixelPlate(btn, UI_GREEN, 22, "btn", 3)
				local txt = label(btn, "", 21, Color3.new(1, 1, 1), Enum.Font.FredokaOne)
				txt.Position = UDim2.new(0, 8, 0, 0)
				txt.Size = UDim2.new(1, -16, 1, -8)
				txt.TextTruncate = Enum.TextTruncate.AtEnd
				txt.TextStrokeTransparency = 0.15
				txt.ZIndex = 23
				local look = { color = UI_GREEN, text = "", textColor = Color3.new(1, 1, 1), ink = RB_INK }
				local hovering = false
				local function paint()
					face.ImageColor3 = pixelTint(hovering
						and look.color:Lerp(Color3.new(1, 1, 1), 0.12) or look.color)
					txt.Text = look.text
					txt.TextColor3 = look.textColor
					txt.TextStrokeColor3 = look.ink
				end
				local function setLook(color, text, textColor, ink)
					look.color, look.text, look.textColor, look.ink = color, text, textColor, ink
					paint()
				end
				btn.MouseEnter:Connect(function()
					hovering = true
					paint()
				end)
				btn.MouseLeave:Connect(function()
					hovering = false
					paint()
				end)

				if maxed then
					setLook(UI_GOLD, "MAX REBIRTH " .. STAR_GLYPH, Color3.fromRGB(30, 26, 14), UI_GOLD)
					txt.TextStrokeTransparency = 1
				elseif affordable then
					-- 2-tap confirm: a reset is destructive for a kid. The
					-- armed stamp rides S so the per-collect re-render mid-
					-- confirm rebuilds the button still armed.
					-- Past a million the comma form no longer fits the brick
					-- at 21px ("1,090,000,000,000 TIX") — the short form reads.
					local costText = cost >= 1e6 and shortValue(cost) or formatCommas(cost)
					local function idleLook()
						setLook(UI_GREEN, "REBIRTH NOW — " .. costText .. " TIX",
							Color3.new(1, 1, 1), Color3.fromRGB(18, 74, 34))
					end
					local function armedLook()
						setLook(RB_RED, "TAP AGAIN TO CONFIRM", Color3.new(1, 1, 1), Color3.fromRGB(90, 20, 36))
					end
					local function disarmLater(secs)
						task.delay(secs, function()
							if btn.Parent and os.clock() >= (S.rebirthArmedUntil or 0) then idleLook() end
						end)
					end
					local left = (S.rebirthArmedUntil or 0) - os.clock()
					if left > 0 then
						armedLook()
						disarmLater(left + 0.05)
					else
						idleLook()
					end
					local pressScale = Instance.new("UIScale")
					pressScale.Parent = btn
					btn.MouseButton1Down:Connect(function()
						TweenService:Create(pressScale,
							TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
							{ Scale = 0.96 }):Play()
					end)
					btn.MouseButton1Up:Connect(function()
						TweenService:Create(pressScale,
							TweenInfo.new(0.07, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
							{ Scale = 1 }):Play()
					end)
					btn.MouseButton1Click:Connect(function()
						if os.clock() < (S.rebirthArmedUntil or 0) then
							S.rebirthArmedUntil = 0
							if rebirthRemote then rebirthRemote:FireServer() end
							return
						end
						S.rebirthArmedUntil = os.clock() + 3
						armedLook()
						disarmLater(3.05)
					end)
				else
					S.rebirthArmedUntil = 0
					local gap = cost - tickets
					setLook(Color3.fromRGB(104, 40, 54),
						"NEED " .. (gap >= 1e6 and shortValue(gap) or formatCommas(gap)) .. " MORE TIX",
						Color3.fromRGB(255, 176, 190), Color3.fromRGB(40, 10, 18))
					-- How close you are, under the brick.
					progressBar(btnRow, UDim2.new(0, 2, 0, 67), UDim2.new(1, -112, 0, 8),
						tickets / math.max(cost, 1), RB_RED, 22)
					local have = label(btnRow, shortValue(tickets) .. " / " .. shortValue(cost), 11, UI_SUB, Enum.Font.GothamBold)
					have.AnchorPoint = Vector2.new(1, 0)
					have.Position = UDim2.new(1, -2, 0, 63)
					have.Size = UDim2.fromOffset(104, 16)
					have.TextXAlignment = Enum.TextXAlignment.Right
					have.ZIndex = 22
				end
				fadeIn(btnRow)
			end

			-- ---- COST LADDER PEEK: the three rebirths after this one ----
			if not maxed then
				local peek = {}
				for k = 1, 3 do
					local c = GameConfig.rebirthCost(rebirth + k)
					if c then table.insert(peek, shortValue(c)) end
				end
				if #peek > 0 then
					local ladder = makeRow(22)
					ladder.BackgroundTransparency = 1
					local l = label(ladder, "NEXT COSTS: " .. table.concat(peek, " · "), 12, UI_SUB, Enum.Font.GothamBold)
					l.Position = UDim2.new(0, 4, 0, 0)
					l.Size = UDim2.new(1, -8, 1, 0)
					l.ZIndex = 22
					fadeIn(ladder)
				end
			end
		end
	elseif openPage == "shop" then
		panelTitle.Text = "SHOP"
		local tickets = player:GetAttribute("Tickets") or 0

		-- SHOP REBUILD (earn without pressure): built like RANKS / REBIRTH /
		-- DAILY — pixel-brick plates, FredokaOne display numbers, GothamBlack
		-- labels, kid-word benefit lines, and prices ONLY on the bricks.
		-- Sections run in ORDER OF VALUE: the starter hero, passes, the luck
		-- ladder, personal boosts, for everyone, ticket rewards, then the
		-- stacking footnote. Badges are honest and one per section (BEST
		-- VALUE / FOREVER / WHOLE SERVER) — no timers, no fake scarcity.
		-- Every purchase path is unchanged: S.promptProduct(key, btn) per
		-- product, BuyPerk / ClaimGroup with the same args, the
		-- PaidRandomRestricted hiding rule and the §4f GroupId gate exactly
		-- as before. Kid-readable floor is 12px — nothing below it here.

		-- ---- Entrance fade (the DAILY pattern), keyed "shop" on S: plays
		-- on arrival only. This page clear-rebuilds on every Tickets collect
		-- (refreshHudState re-renders the open panel) and a blink there reads
		-- as a glitch. Closing the panel, or leaving for another page (the
		-- title changes), clears the key so the next arrival fades again.
		-- Hooks connect once.
		if not S.shopFadeHook then
			S.shopFadeHook = true
			panel:GetPropertyChangedSignal("Visible"):Connect(function()
				if not panel.Visible then S.shopFadeKey = nil end
			end)
			panelTitle:GetPropertyChangedSignal("Text"):Connect(function()
				if panelTitle.Text ~= "SHOP" then S.shopFadeKey = nil end
			end)
			-- A product id landing mid-session (PId_<key> flips from 0)
			-- re-renders the open shop so its SOON brick goes live.
			if remotes then
				for _, prod in ipairs(GameConfig.Products) do
					if prod.key then
