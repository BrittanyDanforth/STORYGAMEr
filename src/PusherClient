-- Planet icon: shaded orb tinted the body color, wearing its catalog ring
-- color when the spec has one. These are PLANETS, not dots — every list
-- and reel icon routes through here. `form` (0/1/2) layers the cheap 2D
-- fusion dressing: extra crossed ring for ASCENDED, ring stack + white halo
-- for CELESTIAL, star badges bottom-right.
local function makePlanetIcon(parent, spec, size, zindex, form)
	form = form or 0
	local holder = Instance.new("Frame")
	holder.BackgroundTransparency = 1
	holder.Size = UDim2.fromOffset(size, size)
	holder.ZIndex = zindex
	holder.Parent = parent
	local bodyColor = spec and Color3.fromRGB(spec.b[1], spec.b[2], spec.b[3])
		or Color3.fromRGB(255, 200, 80)
	local ringColor = (spec and spec.rg)
		and Color3.fromRGB(spec.rg.c[1], spec.rg.c[2], spec.rg.c[3]) or bodyColor
	local orb = Instance.new("ImageLabel")
	orb.Image = UI_ORB
	orb.BackgroundTransparency = 1
	orb.Size = UDim2.fromScale(1, 1)
	orb.ImageColor3 = bodyColor
	orb.ZIndex = zindex + 1 -- sandwiched between ring halves
	orb.Parent = holder
	-- Split-ring rendering (owner order): a ring passes AROUND the sphere.
	-- One ellipse, TWO images — the darker back arc BEHIND the orb (the
	-- planet occludes its middle) and the bright front arc IN FRONT — same
	-- size/anchor/position, so they read as one continuous ring. NO Rotation
	-- on any half: rotated ImageLabels escape ClipsDescendants and would
	-- leak rings outside the reel window.
	local RING_ART = {
		band = { back = "rbxassetid://90697271070482", front = "rbxassetid://121078462008823" },
		thin = { back = "rbxassetid://77664043941322", front = "rbxassetid://104068446666060" },
	}
	local function addRing(style, tint, scale, transparency)
		local art = RING_ART[style] or RING_ART.band
		local w = math.floor(size * 1.9 * scale)
		local h = math.floor(size * 0.82 * scale)
		for _, half in ipairs({ { art.back, zindex }, { art.front, zindex + 2 } }) do
			local img = Instance.new("ImageLabel")
			img.Image = half[1]
			img.BackgroundTransparency = 1
			img.AnchorPoint = Vector2.new(0.5, 0.5)
			img.Position = UDim2.fromScale(0.5, 0.54)
			img.Size = UDim2.fromOffset(w, h)
			img.ImageColor3 = tint
			img.ImageTransparency = transparency or 0
			img.ZIndex = half[2]
			img.Parent = holder
		end
	end
	if spec and spec.rg then
		-- Honor the catalog's ring STYLE (it was ignored before): classic
		-- band, thin halo, moonlet orbit, or double ring with its c2 tint.
		local style = spec.rg.s
		if style == "double" then
			addRing("band", ringColor, 1)
			local c2 = spec.rg.c2
				and Color3.fromRGB(spec.rg.c2[1], spec.rg.c2[2], spec.rg.c2[3])
				or ringColor:Lerp(Color3.new(1, 1, 1), 0.4)
			addRing("thin", c2, 1.24)
		elseif style == "halo" then
			addRing("thin", ringColor, 1.08)
		elseif style == "orbit" then
			addRing("thin", ringColor, 1.15, 0.25)
			local moon = Instance.new("ImageLabel")
			moon.Image = UI_ORB
			moon.BackgroundTransparency = 1
			moon.AnchorPoint = Vector2.new(0.5, 0.5)
			moon.Position = UDim2.fromScale(0.88, 0.64) -- riding the front arc
			moon.Size = UDim2.fromOffset(math.max(5, math.floor(size * 0.18)),
				math.max(5, math.floor(size * 0.18)))
			moon.ImageColor3 = ringColor:Lerp(Color3.new(1, 1, 1), 0.3)
			moon.ZIndex = zindex + 2
			moon.Parent = holder
		else
			addRing("band", ringColor, 1)
		end
	end
	if form >= 1 then
		-- Fusion dressing, occlusion-correct: ASCENDED adds an outer orbit
		-- ring; CELESTIAL adds a wide white halo ring on top of that.
		addRing("thin", ringColor:Lerp(Color3.new(1, 1, 1), 0.35), 1.34)
		if form >= 2 then
			addRing("thin", Color3.new(1, 1, 1), 1.52, 0.35)
		end
		local starCount = form >= 2 and 3 or 1
		for si = 1, starCount do
			local badge = Instance.new("ImageLabel")
			badge.Image = PusherMachine.SpriteArt.star4
			badge.BackgroundTransparency = 1
			badge.AnchorPoint = Vector2.new(1, 1)
			badge.Position = UDim2.new(1, 2 - (si - 1) * math.floor(size * 0.24), 1, 2)
			badge.Size = UDim2.fromOffset(math.max(8, math.floor(size * 0.3)), math.max(8, math.floor(size * 0.3)))
			badge.ImageColor3 = UI_GOLD
			badge.ZIndex = zindex + 2
			badge.Parent = holder
		end
	end
	return holder
end

-- Real 3D planet thumbnail: the ACTUAL catalog ball — rings, cores,
-- caps, all of it — rendered live in a ViewportFrame. spin animates it
-- (reserved for the payoff moments). `form` (0/1/2) renders the fusion
-- dressing via spawnSpecimen's form parameter.
local function makePlanetView(parent, name, tier, size, zindex, spin, form)
	local viewport = Instance.new("ViewportFrame")
	viewport.Size = UDim2.fromOffset(size, size)
	viewport.BackgroundTransparency = 1
	viewport.Ambient = Color3.fromRGB(190, 195, 215)
	viewport.LightColor = Color3.fromRGB(255, 252, 240)
	viewport.LightDirection = Vector3.new(-0.4, -1, -0.6)
	viewport.ZIndex = zindex
	viewport.Parent = parent
	local world = Instance.new("WorldModel")
	world.Parent = viewport
	local vcam = Instance.new("Camera")
	-- Camera pulls back for fused forms: CELESTIAL dressing (1.9D aurora,
	-- 1.7D ring stack) cropped outside the frame at the base distance.
	local formDist = ({ [0] = 1, [1] = 1.35, [2] = 1.7 })[form or 0] or 1
	vcam.CFrame = CFrame.lookAt(Vector3.new(1.2, 0.75, 1.2) * formDist, Vector3.new(0, 0, 0))
	vcam.FieldOfView = 44
	vcam.Parent = viewport
	viewport.CurrentCamera = vcam
	task.spawn(function()
		local ok, ball = pcall(function()
			return PusherMachine.spawnSpecimen(name, tier,
				CFrame.Angles(math.rad(10), math.rad(40), 0), true, world, form or 0)
		end)
		if not (ok and ball) or not spin then return end
		local t0 = os.clock()
		while viewport.Parent do
			ball:PivotTo(CFrame.Angles(math.rad(10), math.rad(40) + (os.clock() - t0) * 0.8, 0))
			task.wait(0.05)
		end
	end)
	return viewport
end

