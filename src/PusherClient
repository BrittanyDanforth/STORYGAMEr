-- PIXEL-ART SURFACES (owner order: "the pixel thingy" — blocky, not smooth).
-- The sources are TINY on purpose (24x16 / 20x20 / 8x8, one bitmap pixel = one
-- art pixel, tools/gen_pixel_ui.ps1). ResampleMode.Pixelated + a large
-- SliceScale blows each pixel up into a hard block instead of smoothing it,
-- which is the whole look; the stepped corners and dither rows are baked in.
--------------------------------------------------------------------------------
local PX_BTN = "rbxassetid://129956892955824" -- 24x16 brick: highlight/face/lip
local PX_CARD = "rbxassetid://95352182439820" -- 20x20 flat card frame
local PX_DITHER = "rbxassetid://82107066087203" -- 8x8 tiling pixel-grid texture
local PX_BTN_SLICE = Rect.new(7, 7, 17, 9)
local PX_CARD_SLICE = Rect.new(5, 5, 15, 15)

-- The art's face band is grey 205, so a raw tint renders the face at 80% of
-- the colour asked for. Compensate so `faceColor` is what actually lands.
local function pixelTint(faceColor)
	local k = 255 / 205
	return Color3.new(
		math.min(faceColor.R * k, 1),
		math.min(faceColor.G * k, 1),
		math.min(faceColor.B * k, 1))
end

-- One pixel-art plate filling `parent`. `kind` "btn" (brick w/ bottom lip) or
-- "card" (flat frame). Returns the ImageLabel.
local function pixelPlate(parent, faceColor, zindex, kind, sliceScale)
	local plate = Instance.new("ImageLabel")
	plate.Image = kind == "card" and PX_CARD or PX_BTN
	plate.ScaleType = Enum.ScaleType.Slice
	plate.SliceCenter = kind == "card" and PX_CARD_SLICE or PX_BTN_SLICE
	plate.SliceScale = sliceScale or 4
	-- Property is ResampleMode, enum is ResamplerMode (they do NOT match).
	plate.ResampleMode = Enum.ResamplerMode.Pixelated
	plate.ImageColor3 = pixelTint(faceColor)
	plate.Size = UDim2.fromScale(1, 1)
	plate.BackgroundTransparency = 1
	plate.ZIndex = zindex or 10
	plate.Parent = parent
	return plate
end

-- Tiling pixel-grid texture over a surface (the reference panel's shimmer).
local function pixelDither(parent, zindex, transparency)
	local tex = Instance.new("ImageLabel")
	tex.Image = PX_DITHER
	tex.ScaleType = Enum.ScaleType.Tile
	tex.TileSize = UDim2.fromOffset(8, 8)
	tex.ResampleMode = Enum.ResamplerMode.Pixelated
	tex.Size = UDim2.fromScale(1, 1)
	tex.BackgroundTransparency = 1
	tex.ImageTransparency = transparency or 0.15
	tex.ZIndex = zindex or 10
	tex.Parent = parent
	return tex
end
