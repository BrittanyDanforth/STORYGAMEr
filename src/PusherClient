			rail.BackgroundTransparency = 1
			pixelPlate(rail, STAGE, 21, "card", 3)
			pixelDither(rail, 22, 0.5)
			local function centre(k)
				return k == 0 and 0 or (k - 0.5) / n
			end
			local function railFrac(secs)
				local k = 0
				for i = 1, n do
					if secs >= milestones[i] then k = i end
				end
				if k >= n then return centre(n) end
				local lo = k == 0 and 0 or milestones[k]
				local hi = milestones[k + 1]
				local part = math.clamp((secs - lo) / math.max(hi - lo, 1), 0, 1)
				return centre(k) + (centre(k + 1) - centre(k)) * part
			end
