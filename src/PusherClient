	end

	-- ---- rig factory + the four family rigs, prebuilt and hidden ----
	local function newRig()
		local rig = Instance.new("Frame")
		rig.AnchorPoint = Vector2.new(0.5, 0.5)
		rig.Position = RIG_BASE
		rig.Size = UDim2.fromOffset(100, 100)
		rig.BackgroundTransparency = 1
		rig.Visible = false
		rig.ZIndex = 41
		rig.Parent = featured
		local scale = Instance.new("UIScale")
		scale.Parent = rig
		return rig, scale
	end
	local function rigImg(parent, image, size, pos, zindex)
		local art = Instance.new("ImageLabel")
		art.Image = image
		art.BackgroundTransparency = 1
		art.AnchorPoint = Vector2.new(0.5, 0.5)
		art.Position = pos
		art.Size = UDim2.fromOffset(size, size)
		art.ZIndex = zindex
		art.Parent = parent
		return art
	end
	local CENTER = UDim2.fromScale(0.5, 0.5)

	-- 1. Glowing clover — luck offers; the starter pack reuses the layout
	-- with a crown swapped in and no 100X badge.
	local cloverRig, cloverScale = newRig()
	local cloverHalo = rigImg(cloverRig, UI_FRAME_GLOW, 96, CENTER, 41)
	cloverHalo.ImageColor3 = UI_GOLD
	cloverHalo.ImageTransparency = 0.25
	local cloverArt = rigImg(cloverRig, UI_CLOVER, 60, CENTER, 42)
	local cloverBadge = rigImg(cloverRig, UI_100X, 32, UDim2.new(0.5, 22, 0.5, 20), 43)
	cloverBadge.Rotation = 8

	-- 2. Golden ticket fan — ticket offers. The fixed -12/0/+12 fan angles
	-- ride the rig, which rocks as one (±3°).
	local ticketRig, ticketScale = newRig()
	local tixL = rigImg(ticketRig, ACH_ICONS.ticket, 52, UDim2.new(0.5, -11, 0.5, 3), 41)
	tixL.Rotation = -12
	tixL.ImageColor3 = Color3.fromRGB(205, 175, 120)
	local tixR = rigImg(ticketRig, ACH_ICONS.ticket, 52, UDim2.new(0.5, 11, 0.5, 3), 41)
	tixR.Rotation = 12
	tixR.ImageColor3 = Color3.fromRGB(205, 175, 120)
	local tixF = rigImg(ticketRig, ACH_ICONS.ticket, 56, CENTER, 42)
	local shimmer = Instance.new("UIGradient")
	shimmer.Rotation = 20
	shimmer.Color = ColorSequence.new(Color3.new(1, 1, 1))
	shimmer.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.42, 1),
		NumberSequenceKeypoint.new(0.5, 0.35), NumberSequenceKeypoint.new(0.58, 1),
		NumberSequenceKeypoint.new(1, 1),
	})
	shimmer.Parent = tixF

	-- 3. Radiant comet — instant rush. Trail runs up-left, head bottom-right:
	-- a comet streaking diagonally down.
	local cometRig, cometScale = newRig()
	local cometGlow = rigImg(cometRig, ORB_ART, 100, UDim2.new(0.5, 4, 0.5, 4), 41)
	cometGlow.ImageColor3 = Color3.fromRGB(255, 160, 70)
	cometGlow.ImageTransparency = 0.3
	for _, trail in ipairs({
		{ size = 16, x = -42, y = -36, tr = 0.85, rot = 70 },
		{ size = 26, x = -30, y = -26, tr = 0.7, rot = 40 },
		{ size = 40, x = -16, y = -14, tr = 0.45, rot = 15 },
	}) do
		local star = rigImg(cometRig, STAR_ART, trail.size,
			UDim2.new(0.5, trail.x, 0.5, trail.y), 42)
		star.ImageTransparency = trail.tr
		star.Rotation = trail.rot
	end
	local cometHead = rigImg(cometRig, STAR_ART, 62, UDim2.new(0.5, 4, 0.5, 4), 43)
	cometHead.ImageColor3 = Color3.fromRGB(255, 225, 150)

	-- 4. Mini ringed planet — server boosts, tinted per product. Occlusion-
	-- correct split ring: back arc behind the orb, front arc over it (the
	-- old single full-ellipse ring spun ON TOP of the planet — banned look).
	local planetRig, planetScale = newRig()
	local planetHalo = rigImg(planetRig, ORB_ART, 90, CENTER, 41)
	planetHalo.ImageTransparency = 0.4
	local planetRingBack = rigImg(planetRig, "rbxassetid://90697271070482", 92, CENTER, 41)
	planetRingBack.Size = UDim2.fromOffset(96, 41)
	local planetArt = rigImg(planetRig, UI_ORB, 56, CENTER, 42)
	local planetRing = rigImg(planetRig, "rbxassetid://121078462008823", 92, CENTER, 43)
	planetRing.Size = UDim2.fromOffset(96, 41)

	-- ---- per-key config: rig + display copy + idle-tween starters ----
	local OFFER_KEYS = { "Starter", "Tix2x15", "RushNow", "Luck100",
		"SrvLuck100", "SrvTix2x", "SrvRush" }
	local OFFER_FALLBACK = {
		Starter = { robux = 49 }, Tix2x15 = { robux = 39 },
		RushNow = { robux = 79 }, Luck100 = { robux = 99 },
		SrvLuck100 = { robux = 149 }, SrvTix2x = { robux = 129 },
		SrvRush = { robux = 99 },
	}
	local SRV_TINTS = {
		SrvLuck100 = Color3.fromRGB(80, 200, 220),
		SrvTix2x = Color3.fromRGB(255, 150, 70),
		SrvRush = UI_GOLD,
	}
	local OFFER_DEFS = {
		Starter = { rig = cloverRig, scale = cloverScale, name = "STARTER PACK",
			color = UI_GOLD },
		Luck100 = { rig = cloverRig, scale = cloverScale, name = "100X LUCK",
			color = UI_GOLD, timer = "90 SEC BOOST" },
		Tix2x15 = { rig = ticketRig, scale = ticketScale, name = "2X TICKETS",
			color = UI_GREEN, timer = "15 MIN" },
		RushNow = { rig = cometRig, scale = cometScale, name = "METEOR RAIN",
			color = Color3.fromRGB(255, 180, 90) },
		SrvLuck100 = { rig = planetRig, scale = planetScale, name = "SERVER LUCK",
			color = SRV_TINTS.SrvLuck100, timer = "90 SEC" },
		SrvTix2x = { rig = planetRig, scale = planetScale, name = "SERVER TICKETS",
			color = SRV_TINTS.SrvTix2x, timer = "10 MIN" },
		SrvRush = { rig = planetRig, scale = planetScale, name = "SERVER RAIN",
			color = SRV_TINTS.SrvRush },
	}

	local dismissed = false
	local offerIndex = 0
	local currentKey = nil
	local offerShown = false
	local currentSlot = "B" -- flips on first show, so the FIRST offer lands in A

	local function applySlot(slot)
		currentSlot = slot
		if slot == "B" then
			featured.AnchorPoint = SLOT_B_ANCHOR
			featured.Position = SLOT_B_POS
		else
			featured.AnchorPoint = SLOT_A_ANCHOR
			featured.Position = SLOT_A_POS
		end
	end

	local function eligible(key)
		if not S.productConfigured(key) then return false end
		if key == "Starter" and player:GetAttribute("StarterOwned") then return false end
		if (key == "Luck100" or key == "SrvLuck100")
			and player:GetAttribute("PaidRandomRestricted") then return false end
		return true
	end

	-- Ticket-fan shimmer sweep (TweenInfo has no inter-repeat delay: loop
	-- manually; the token + Visible/Parent re-check kill it on swap).
	local function startShimmer()
		local token = threadToken
		task.spawn(function()
			while token == threadToken and ticketRig.Visible and ticketRig.Parent do
				shimmer.Offset = Vector2.new(-1, 0)
				local sweep = TweenService:Create(shimmer,
					TweenInfo.new(1.2, Enum.EasingStyle.Linear), { Offset = Vector2.new(1, 0) })
				sweep:Play()
				sweep.Completed:Wait()
				if not (ticketRig.Visible and ticketRig.Parent) then break end
				task.wait(2.4)
			end
		end)
	end

	local function showRig(key)
		local def = OFFER_DEFS[key]
		local rig = def.rig
		if key == "Starter" or key == "Luck100" then
			cloverArt.Image = key == "Starter" and ACH_ICONS.crown or UI_CLOVER
			cloverBadge.Visible = key == "Luck100"
			cloverHalo.ImageTransparency = 0.25
			pushTween(TweenService:Create(cloverHalo,
				TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
				{ ImageTransparency = 0.45 }))
			startFloat(rig, cloverArt, 4)
		elseif key == "Tix2x15" then
			startFloat(rig, rig, 3) -- the whole fan rocks as one
			startShimmer()
		elseif key == "RushNow" then
			cometHead.ImageTransparency = 0
			pushTween(TweenService:Create(cometHead,
				TweenInfo.new(0.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
				{ ImageTransparency = 0.15 }))
			startFloat(rig, cometHead, 4, true) -- drifts along the streak axis
		else -- server planet, tinted per product
			local tint = SRV_TINTS[key] or UI_GOLD
			planetHalo.ImageColor3 = tint
			planetArt.ImageColor3 = tint
			-- A split ring can't spin (the halves encode the viewpoint), so
			-- the front arc shimmers instead.
			planetRingBack.ImageColor3 = tint:Lerp(Color3.new(1, 1, 1), 0.15)
			planetRing.ImageColor3 = tint:Lerp(Color3.new(1, 1, 1), 0.15)
			pushTween(TweenService:Create(planetRing,
				TweenInfo.new(1.4, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
				{ ImageTransparency = 0.45 }))
			startFloat(rig, planetArt, 4)
		end
		-- Entrance polish: grow 80% -> 100%.
		def.scale.Scale = 0.8
		pushTween(TweenService:Create(def.scale,
			TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Scale = 1 }))
		rig.Visible = true
	end

	local function hideOffer()
		stopFloats()
		cloverRig.Visible = false
		ticketRig.Visible = false
		cometRig.Visible = false
		planetRig.Visible = false
		featured.Visible = false
		offerShown = false
	end

	local function showNextOffer()
		if dismissed then
			hideOffer()
			return
		end
		for _ = 1, #OFFER_KEYS do
			offerIndex = offerIndex % #OFFER_KEYS + 1
			local key = OFFER_KEYS[offerIndex]
			if eligible(key) then
				hideOffer()
				currentKey = key
				local def = OFFER_DEFS[key]
				local prod = S.productInfo(key) or OFFER_FALLBACK[key]
				-- Short name only: durations live on the shop card, and the
				-- 130px pill truncated "2X TICKETS — 15 MIN" to "2X TICK..."
				-- on the live build.
				nameLabel.Text = (def.name:match("^(.-)%s+—") or def.name)
				nameLabel.TextColor3 = def.color
				pricePill.Text = "R$ " .. (prod.robux or 0)
				timerLabel.Text = def.timer or ""
				timerLabel.Visible = def.timer ~= nil
				-- Touch: Slot A ONLY (Slot B sits in the thumb zone under the
				-- roll popup). Desktop alternates A -> B -> A.
				applySlot((not touchDevice and currentSlot == "A") and "B" or "A")
				showRig(key)
				featured.Visible = true
				offerShown = true
				return
			end
		end
		hideOffer()
	end

	-- Contextual pitch: a big moment (jackpot fanfare, tier-4 pull) jumps the
	-- rotation straight to the offer that matches it. Respects dismissal +
	-- eligibility, and at most one contextual jump per 90s — hype, not spam.
	local lastContextPitch = 0
	function S.pitchOffer(key)
		if dismissed then return end
		if not eligible(key) then return end
		if os.clock() - lastContextPitch < 90 then return end
		local idx = table.find(OFFER_KEYS, key)
		if not idx then return end
		lastContextPitch = os.clock()
		offerIndex = idx - 1 -- showNextOffer advances first, so it lands on key
		showNextOffer()
	end

	local function buyCurrent()
		if currentKey then S.promptProduct(currentKey, pricePill) end
	end
	hitBtn.MouseButton1Click:Connect(buyCurrent)
	pricePill.MouseButton1Click:Connect(buyCurrent)
	closeBtn.MouseButton1Click:Connect(function()
		dismissed = true
		hideOffer()
	end)
	if touchDevice then
		closeBtn.Visible = true
	else
		closeBtn.Visible = false
		featured.MouseEnter:Connect(function() closeBtn.Visible = true end)
		featured.MouseLeave:Connect(function() closeBtn.Visible = false end)
	end

	-- Slot B safe-zone rule: hide while the roll reveal renders in its zone.
	task.spawn(function()
		while featured.Parent do
			if offerShown and currentSlot == "B" then
				featured.Visible = not (S.revealVisible and S.revealVisible())
			end
			task.wait(0.3)
		end
	end)

	task.spawn(function()
		-- Let a new player fall in love with the machine before the first
		-- pitch; conversion beats annoyance.
		task.wait(45)
		while not dismissed and featured.Parent do
			showNextOffer()
			task.wait(30)
		end
	end)
end)()

-- Re-render open panels + refresh badges/chips/tree when state changes. The
-- upgrades page is NOT in this rebuild path any more: the TreePage refreshes
-- in place via S.updateTreeStates (a rebuild would reset the pan).
;(function() -- section scope: own register budget (main chunk hit Luau's 200-local cap live)
	local function refreshHudState()
		if panel.Visible then renderPage() end
		-- Always: the badge counts read the tree node states, tree open or not.
		S.updateTreeStates()
		if S.updateBadges then S.updateBadges() end
	end

	invDirty.Event:Connect(function()
		if panel.Visible and openPage == "collection" then renderPage() end
		if S.updateBadges then S.updateBadges() end
	end)
	for _, attr in ipairs({
		"Tickets", "LuckBoostUntil", "EquippedBall", "GroupPerk", "TicketMult",
		"LuckMult", "TotalDrops", "TotalRolls", "TotalEarned", "BestTier",
		"Rebirth", "StarDust", "EquippedForm", "ThroneLevel", "TixBoostUntil",
		"DailyM1", "DailyM2", "DailyM3", "DailyStars",
		-- Connected-loop attrs: quest claims, streak, playtime, discovery —
		-- they re-render the open panel + drive the DAILY/FORGE badges.
		"DailyR1", "DailyR2", "DailyR3", "DailyR4",
		"DailyC1", "DailyC2", "DailyC3", "DailyC4",
		"StreakDay", "StreakReady", "PlaySecs", "PlayReady", "PlayClaimed",
		"IndexFound",
		-- Pass grants: the open shop's brick flips to OWNED the moment the
		-- receipt lands, so a second tap can't re-prompt the purchase.
		"Tickets2xOwned", "AutoDropOwned",
	}) do
		player:GetAttributeChangedSignal(attr):Connect(refreshHudState)
	end
	-- Every tree node level is its own attribute; watch them all for the tree
	-- states and the UPGRADES badge (renderPage no longer needs them).
	for _, node in ipairs(GameConfig.UpgradeTree) do
		player:GetAttributeChangedSignal(node.id):Connect(function()
			S.updateTreeStates()
			if S.updateBadges then S.updateBadges() end
		end)
	end
	if remotes then
		remotes:GetAttributeChangedSignal("Zone"):Connect(function()
			if panel.Visible and openPage == "galaxy" then renderPage() end
			S.updateTreeStates()
			if S.updateBadges then S.updateBadges() end
		end)
	end
end)()

