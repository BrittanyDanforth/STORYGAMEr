-- Right menu rail — single 1x8 COLUMN that fills the right edge to the
-- bottom of the screen (owner reference: chunky stacked candy buttons).
-- 184 wide, height computed per-viewport in layoutRail() (clamp 44..96,
-- 4px gaps, start y 78, 10px bottom margin). COLLECTION keeps its page
-- key; the button reads INDEX (the panel is the collection book).
--------------------------------------------------------------------------------

;(function() -- section scope: own register budget (main chunk hit Luau's 200-local cap live)
	local RAIL = {
		{ name = "INDEX", color = Color3.fromRGB(214, 86, 160), page = "collection" },
		{ name = "UPGRADES", color = Color3.fromRGB(64, 178, 84), page = "upgrades" },
		{ name = "GALAXY", color = Color3.fromRGB(48, 165, 158), page = "galaxy" },
		{ name = "REBIRTH", color = Color3.fromRGB(210, 72, 98), page = "rebirth" },
		{ name = "FORGE", color = Color3.fromRGB(226, 122, 44), page = "forge" },
		{ name = "DAILY", color = Color3.fromRGB(212, 160, 46), page = "daily" },
		{ name = "RANKS", color = Color3.fromRGB(92, 94, 214), page = "ranks" },
		{ name = "SHOP", color = Color3.fromRGB(154, 82, 210), page = "shop" },
	}
	-- Single column that FILLS the right edge to the bottom of the screen
	-- (owner reference: chunky stacked buttons, none side by side, tight
	-- gaps). Heights are computed per-viewport in layoutRail() below: the 8
	-- buttons share (designHeight - 78 top - 10 bottom - 7*4 gaps), clamped
	-- 44..96 so phones keep touch targets and monitors don't get bricks.
	local BTN_W = 184
	local railButtons = {} -- ordered: the 8 TextButtons, for layoutRail
	local railLabels = {} -- their pixel-plate captions (button.Text is unused)
	local railBadges = {} -- page -> {frame, text}
	local dailySubline = nil -- "REWARD READY" line on the DAILY button

	for index, item in ipairs(RAIL) do
		local button = Instance.new("TextButton")
		button.AnchorPoint = Vector2.new(1, 0)
		button.Position = UDim2.new(1, -12, 0, 78 + (index - 1) * 48)
		button.Size = UDim2.fromOffset(BTN_W, 44)
		railButtons[index] = button
		button.BackgroundTransparency = 1
		button.Text = ""
		button.ZIndex = 13
		button.Parent = gui
		-- PIXEL BRICK: one nine-sliced pixel-art plate, blown up with
		-- Pixelated resampling so the stepped corners, hard outline and
		-- dither rows stay as crisp blocks. The label is a child (not
		-- button.Text) so plate and text sink together on press.
		local plate = pixelPlate(button, item.color, 10, "btn", 4)
		if item.page == "forge" then
			S.forgeNavBtn = button -- tutorial coach target
		end
		local lbl = label(button, item.name, 13, Color3.new(1, 1, 1), Enum.Font.FredokaOne)
		lbl.Size = UDim2.new(1, -10, 1, -10)
		lbl.Position = UDim2.fromOffset(5, 3) -- optically centred on the face
		lbl.TextStrokeColor3 = item.color:Lerp(Color3.new(0, 0, 0), 0.8)
		lbl.TextStrokeTransparency = 0.1
		lbl.ZIndex = 12
		railLabels[index] = lbl
		-- Press: plate and label sink onto the baked lip together.
		button.MouseButton1Down:Connect(function()
			plate.Position = UDim2.fromOffset(0, 5)
			lbl.Position = UDim2.fromOffset(5, 8)
		end)
		local function faceUp()
			plate.Position = UDim2.fromOffset(0, 0)
			lbl.Position = UDim2.fromOffset(5, 3)
		end
		button.MouseButton1Up:Connect(faceUp)
		button.MouseLeave:Connect(faceUp)

		-- Notification badge (updateBadges drives text + visibility).
		local badge = Instance.new("Frame")
		badge.AnchorPoint = Vector2.new(1, 0)
		badge.Position = UDim2.new(1, 6, 0, -6)
		badge.Size = UDim2.fromOffset(20, 20)
		badge.BackgroundColor3 = Color3.fromRGB(226, 64, 64)
		badge.BorderSizePixel = 0
		badge.Visible = false
		badge.ZIndex = 12
		badge.Parent = button
		corner(badge, 10)
		stroke(badge, Color3.new(1, 1, 1), 1.5, 0.15)
		local badgeText = label(badge, "", 11, Color3.new(1, 1, 1), Enum.Font.GothamBlack)
		badgeText.Size = UDim2.fromScale(1, 1)
		badgeText.ZIndex = 13
		railBadges[item.page] = { frame = badge, text = badgeText }

		-- The QuestChip's replacement: DAILY carries a REWARD READY subline
		-- while anything is claimable (badge shows the count).
		if item.page == "daily" then
			-- White, not pale gold: this sits on the gold DAILY plate and
			-- gold-on-gold at 9px was mush (contrast audit finding).
			dailySubline = label(button, "REWARD READY", 9,
				Color3.new(1, 1, 1), Enum.Font.GothamBlack)
			dailySubline.AnchorPoint = Vector2.new(0.5, 1)
			dailySubline.Position = UDim2.new(0.5, 0, 1, -2)
			dailySubline.Size = UDim2.new(1, -4, 0, 12)
			dailySubline.TextStrokeColor3 = Color3.new(0, 0, 0)
			dailySubline.TextStrokeTransparency = 0.2
			dailySubline.Visible = false
			dailySubline.ZIndex = 12
		end

		button.MouseButton1Click:Connect(function()
			if item.page == "upgrades" then
				if S.forgePage then S.forgePage.Visible = false end
				S.toggleTreePage()
				return
			end
			if item.page == "forge" then
				S.toggleForgePage()
				return
			end
			S.treePage.Visible = false
			if S.forgePage then S.forgePage.Visible = false end
			if openPage == item.page and panel.Visible then
				panel.Visible = false
				openPage = nil
			else
				openPage = item.page
				panel.Visible = true
				renderPage()
			end
		end)
	end

	-- Fill-to-bottom layout. Recomputes the shared HudScale formula itself
	-- (instead of reading hudScale.Scale) so it never races the resize
	-- handler order on ViewportSize changes.
	local function layoutRail()
		local vp = camera.ViewportSize
		local s = math.clamp(math.min(vp.X / 1280, vp.Y / 720), 0.75, 1.1)
		local designH = vp.Y / s
		local top, bottomPad, gap = 78, 10, 4
		local h = math.floor((designH - top - bottomPad - 7 * gap) / 8)
		h = math.clamp(h, 44, 96)
		local textSize = math.clamp(math.floor(h * 0.30), 14, 20)
		for i, button in ipairs(railButtons) do
			button.Position = UDim2.new(1, -12, 0, top + (i - 1) * (h + gap))
			button.Size = UDim2.fromOffset(BTN_W, h)
			if railLabels[i] then railLabels[i].TextSize = textSize end
		end
		if dailySubline then
			dailySubline.TextSize = h >= 60 and 11 or 9
			dailySubline.Size = UDim2.new(1, -4, 0, h >= 60 and 14 or 12)
		end
	end
	camera:GetPropertyChangedSignal("ViewportSize"):Connect(layoutRail)
	layoutRail()

	-- Badge logic (addendum §1/§3): UPGRADES = affordable node count;
	-- GALAXY = deeper zone open; REBIRTH = affordable; FORGE = any planet
	-- forge-ready (moved off COLLECTION); DAILY = ready-unclaimed count
	-- across QUESTS/STREAK/PLAYTIME + the REWARD READY subline. INDEX and
	-- RANKS carry no badge (no nag).
	function S.updateBadges()
		local tickets = player:GetAttribute("Tickets") or 0
		local rebirth = player:GetAttribute("Rebirth") or 0

		local affordable = 0
		for _, def in ipairs(GameConfig.UpgradeTree) do
			local ui = S.treeNodes[def.id]
			if ui and ui.state == 4 then affordable = affordable + 1 end
		end
		local upBadge = railBadges["upgrades"]
		upBadge.frame.Visible = affordable > 0
		upBadge.text.Text = affordable > 9 and "9+" or tostring(affordable)

		local rebirthCost = GameConfig.rebirthCost(rebirth)
		local rbBadge = railBadges["rebirth"]
		rbBadge.frame.Visible = rebirthCost ~= nil and tickets >= rebirthCost
		rbBadge.text.Text = "!"
		local zoneNow = remotes and remotes:GetAttribute("Zone") or 1
		local deeperZoneOpen = false
		for zi, req in ipairs(GameConfig.Zones.reqs) do
			if zi > zoneNow and rebirth >= req then deeperZoneOpen = true end
		end
		local gxBadge = railBadges["galaxy"]
		gxBadge.frame.Visible = deeperZoneOpen
		gxBadge.text.Text = "!"

		-- FORGE badge: any planet has a forge affordable.
		local fgBadge = railBadges["forge"]
		fgBadge.frame.Visible = S.anyForgeReady()
		fgBadge.text.Text = "!"

		-- DAILY badge: ready-unclaimed count across all three tabs.
		local readyCount = S.dailyReadyCount()
		local dyBadge = railBadges["daily"]
		dyBadge.frame.Visible = readyCount > 0
		dyBadge.text.Text = readyCount > 9 and "9+" or tostring(readyCount)
		if dailySubline then dailySubline.Visible = readyCount > 0 end
	end
	S.updateBadges()
end)()

