		-- §4b 2-COL CARD GRID, 158px cards: small family icon + scaled name,
		-- 2-line benefit, scope caption + duration pill on one band, a
		-- full-width price brick. Owned durables dim to the gold plate.
		local CARD_H, GAP = 158, 8
		local function grid2(defs, face)
			local rowsN = math.ceil(#defs / 2)
			local grid = makeRow(rowsN * CARD_H + math.max(0, rowsN - 1) * GAP)
			grid.BackgroundTransparency = 1
			for i, def in ipairs(defs) do
				local col, rowI = (i - 1) % 2, math.floor((i - 1) / 2)
				local cf = Instance.new("Frame")
				cf.Position = UDim2.new(col * 0.5, col * (GAP / 2), 0, rowI * (CARD_H + GAP))
				cf.Size = UDim2.new(0.5, -GAP / 2, 0, CARD_H)
				cf.BackgroundTransparency = 1
				cf.ZIndex = 22
				cf.Parent = grid
				local owned = def.ownedAttr ~= nil and player:GetAttribute(def.ownedAttr) == true
				pixelPlate(cf, owned and GOLD_DIM or face, 22, "card", 3)
				pixelDither(cf, 23, 0.55)
				local icon = famIcon(cf, def.key, 28, 10, 9, def.iconTint, 24)
				if owned then icon.ImageTransparency = 0.4 end
				nameLabel(cf, NAMES[def.key], UDim2.new(0, 44, 0, 8), UDim2.new(1, -54, 0, 30),
					owned and UI_SUB or UI_TEXT, 24)
				local benefit = line(cf, BENEFIT[def.key] or "", 12, owned and UI_SUB or UI_TEXT,
					Enum.Font.GothamBold, UDim2.new(0, 10, 0, 42), UDim2.new(1, -20, 0, 30), 24)
				benefit.TextWrapped = true
				benefit.TextYAlignment = Enum.TextYAlignment.Top
				line(cf, prodScope(def.key, def.scope), 12, def.scopeTint or PALE_GOLD,
					Enum.Font.GothamBlack, UDim2.new(0, 10, 0, 74), UDim2.new(1, -96, 0, 26), 24)
				durationPill(cf, prodPill(def.key), UI_GOLD, UDim2.new(1, -10, 0, 73), 24)
				priceBrick(cf, def.key, UDim2.new(1, -20, 0, 44), UDim2.new(0, 10, 0, 106), 24, owned)
			end
			fadeIn(grid)
			return grid
		end

