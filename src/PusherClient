		{ text = "25X", color = Color3.fromRGB(255, 150, 70) },
		{ text = "10X", color = Color3.fromRGB(255, 79, 216) },
		{ text = "3X", color = Color3.fromRGB(54, 232, 214) },
	}
	local PAYOUT_DARK = Color3.fromRGB(24, 25, 38)
	local payoutSegs = {}
	for laneIndex, laneSpec in ipairs(PAYOUT_LANES) do
		local seg = Instance.new("Frame")
		seg.BackgroundColor3 = laneSpec.jackpot and laneSpec.color or PAYOUT_DARK
		seg.BorderSizePixel = 0
		seg.Visible = false
		seg.ZIndex = 8
		seg.Parent = payoutGui
		corner(seg, 4)
		stroke(seg, laneSpec.color, 1.5, 0.1)
		local segText = Instance.new("TextLabel")
		segText.Size = UDim2.new(1, -4, 1, -4)
		segText.Position = UDim2.new(0, 2, 0, 2)
		segText.BackgroundTransparency = 1
		segText.Font = Enum.Font.GothamBlack
		segText.TextScaled = true
		segText.Text = laneSpec.text
		segText.TextColor3 = laneSpec.jackpot and Color3.fromRGB(56, 40, 8) or laneSpec.color
		segText.ZIndex = 9
		segText.Parent = seg
		payoutSegs[laneIndex] = seg
	end
	local payoutJackLabel = Instance.new("TextLabel")
	payoutJackLabel.BackgroundTransparency = 1
	payoutJackLabel.Font = Enum.Font.GothamBlack
	payoutJackLabel.Text = "JACKPOT"
	payoutJackLabel.TextColor3 = Color3.fromRGB(255, 226, 140)
	payoutJackLabel.TextScaled = true
	payoutJackLabel.Visible = false
	payoutJackLabel.ZIndex = 9
	payoutJackLabel.Parent = payoutGui
	stroke(payoutJackLabel, Color3.fromRGB(40, 26, 4), 1.2, 0)
	local payoutBarShown = false
	local function setPayoutBarShown(shown)
		if payoutBarShown == shown then return end
		payoutBarShown = shown
		for laneIndex = 1, 7 do
			payoutSegs[laneIndex].Visible = shown
		end
		payoutJackLabel.Visible = shown
	end
	RunService.RenderStepped:Connect(function()
		-- OWNER RULING: the screen-space bar is DEAD at every viewport size —
		-- the machine's built-in lane signs are the one and only payout UI.
		-- The gui skeleton stays only so SlotHit's guarded seg references
		-- resolve to invisible frames.
		setPayoutBarShown(false)
		if true then return end
		local cam = workspace.CurrentCamera
		local viewH = cam.ViewportSize.Y
		local barH = math.clamp(math.floor(viewH * 0.075), 15, 30)
		local jackH = math.clamp(math.floor(viewH * 0.05), 10, 18)
		local xs, mouthTop = {}, 0
		for k, edgeX in ipairs(PAYOUT_EDGES) do
			local v = cam:WorldToViewportPoint(Vector3.new(edgeX, 2.9, -5.45))
			xs[k] = v.X
			if k == 4 or k == 5 then mouthTop = math.max(mouthTop, v.Y) end
		end
		local topY = mouthTop + 2
		topY = math.min(topY, viewH - barH - 4)
		-- Duck above the DROP cluster (fever pill + button) so the bar never
		-- covers it on short viewports — the old bar's duck, reborn.
		local cluster = S.dropCluster
		if cluster then
			topY = math.min(topY, cluster.AbsolutePosition.Y - barH - 12)
		end
		for laneIndex = 1, 7 do
			local a, b = xs[laneIndex], xs[laneIndex + 1]
			local x0, x1 = math.min(a, b), math.max(a, b)
			local jackpot = laneIndex == 4
			payoutSegs[laneIndex].Position = UDim2.fromOffset(
				math.floor(x0) + 1, math.floor(jackpot and topY - 6 or topY))
			payoutSegs[laneIndex].Size = UDim2.fromOffset(
				math.floor(x1 - x0) - 2, jackpot and barH + 6 or barH)
		end
		local centerX = (xs[4] + xs[5]) / 2
		local jackW = math.max(64, math.floor(math.abs(xs[1] - xs[8]) * 0.36))
		payoutJackLabel.Position = UDim2.fromOffset(
			math.floor(centerX - jackW / 2), math.floor(topY - 6 - jackH - 3))
		payoutJackLabel.Size = UDim2.fromOffset(jackW, jackH)
	end)
	-- Session per-lane hit tally, mirrored onto the header CountLabels (lane 4's
	-- CountLabel is the jackpot mini-odometer instead, written by the cosmetic
	-- loop).
	local laneHits = { 0, 0, 0, 0, 0, 0, 0 }
	local function laneHitText(count)
		if count > 9999 then return "9999+" end
		-- "N HITS", never "×N" — next to the lane signs a "×" tally read as a
		-- payout multiplier.
		return count .. " HITS"
	end

	-- Payout floaters: "x12" pops off the drop cluster on every slot hit —
	-- the one moment a surged lane's LIVE multiplier (the server sends it)
	-- is actually shown on screen. Pooled, max 6 in flight.
	local FLOATER_MAX = 6
	local floaterPool = {}
	local floaterNext = 0
	local function spawnPayoutFloater(laneSpec, isJackpot, mult)
		floaterNext = floaterNext % FLOATER_MAX + 1
		local entry = floaterPool[floaterNext]
		if not entry then
			local float = Instance.new("TextLabel")
			float.BackgroundTransparency = 1
			float.Font = Enum.Font.GothamBlack
			float.AnchorPoint = Vector2.new(0.5, 1)
			float.Size = UDim2.fromOffset(320, 52)
			float.TextStrokeColor3 = Color3.new(0, 0, 0)
			float.TextStrokeTransparency = 0.25
			float.Visible = false
			float.ZIndex = 41
			float.Parent = gui
			local floatScale = Instance.new("UIScale")
			floatScale.Parent = float
			entry = { label = float, scale = floatScale }
			floaterPool[floaterNext] = entry
		end
		local float = entry.label
		-- Surged mult when the server sent one; a 0 (overload-window hit)
		-- falls back to the lane's printed sign.
		local multText = (mult and mult > 0) and ("x" .. mult) or laneSpec.text
		if isJackpot then
			float.Text = (mult and mult > 0) and ("JACKPOT x" .. mult) or "JACKPOT"
			float.TextSize = 42
			float.TextColor3 = Color3.fromRGB(255, 226, 140)
		else
			float.Text = multText
			float.TextSize = 30
			float.TextColor3 = laneSpec.color
		end
		-- AbsolutePosition is post-HudScale screen pixels; offsets in gui are
		-- pre-scale, so divide back out (goldBurst's idiom).
		local s = math.max(hudScale.Scale, 0.01)
		local cluster = S.dropCluster
		local cx, cy
		if cluster then
			cx = (cluster.AbsolutePosition.X + cluster.AbsoluteSize.X / 2) / s
			cy = cluster.AbsolutePosition.Y / s - 10
		else
			cx = camera.ViewportSize.X / 2 / s
			cy = camera.ViewportSize.Y * 0.7 / s
		end
		cx += math.random(-36, 36)
		float.Position = UDim2.fromOffset(cx, cy)
		float.Rotation = math.random(-7, 7)
		float.TextTransparency = 0
		float.TextStrokeTransparency = 0.2
		entry.scale.Scale = 0.35
		float.Visible = true
		-- Big pop, then a long drifting rise that straightens out as it fades
		-- — reads as a chunky prize tag, not a debug print. A new tween on the
		-- same property cancels the old one, so a reused pooled label just
		-- restarts cleanly.
		TweenService:Create(entry.scale,
			TweenInfo.new(0.22, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Scale = isJackpot and 1.15 or 1 }):Play()
		if not S.reducedMotion then
			TweenService:Create(float,
				TweenInfo.new(1.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ Position = UDim2.fromOffset(cx + math.random(-30, 30), cy - 96),
					Rotation = 0 }):Play()
		end
		TweenService:Create(float,
			TweenInfo.new(1.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
	end

	-- Flash a header part to its FlashColor attr (fallback: the lane color) and
	-- revert to BaseColor.
	local function flashHeaderPart(part, laneColor)
		if not (part and part.Parent) then return end
		local base = part:GetAttribute("BaseColor") or part.Color
		part.Color = part:GetAttribute("FlashColor") or laneColor
		task.delay(0.3, function()
			if part.Parent then
				TweenService:Create(part, TweenInfo.new(0.25), { Color = base }):Play()
			end
		end)
	end

	if slotHitRemote then
		slotHitRemote.OnClientEvent:Connect(function(lane, isJackpot, mult, ownerId)
			local laneSpec = PAYOUT_LANES[lane]
			if not laneSpec then return end

			-- The cabinet is shared: lane flashes are for everyone, but the
			-- payout floater is personal — only the piece's owner floats it,
			-- and only for the BIG moments (10X+, surges, jackpots). Floating
			-- every 3X collect buried the highs in constant small popups.
			if ownerId == player.UserId
				and (isJackpot or (tonumber(mult) or 0) >= 10) then
				spawnPayoutFloater(laneSpec, isJackpot, mult)
			end

			-- (a) Mobile-fallback screen segment flash (only while the bar shows).
			local seg = payoutSegs[lane]
			if seg and payoutBarShown then
				local segText = seg:FindFirstChildOfClass("TextLabel")
				seg.BackgroundColor3 = laneSpec.color
				if segText then segText.TextColor3 = Color3.fromRGB(20, 20, 30) end
				task.delay(0.3, function()
					if not seg.Parent then return end
					TweenService:Create(seg, TweenInfo.new(0.35), {
						BackgroundColor3 = laneSpec.jackpot and laneSpec.color or PAYOUT_DARK,
					}):Play()
					if segText then
						segText.TextColor3 = laneSpec.jackpot and Color3.fromRGB(56, 40, 8) or laneSpec.color
					end
				end)
				if isJackpot then
					payoutJackLabel.TextColor3 = Color3.new(1, 1, 1)
					task.delay(0.4, function()
						payoutJackLabel.TextColor3 = Color3.fromRGB(255, 226, 140)
					end)
				end
			end

			-- (b) In-world lane strip flash (unchanged behavior).
			local machine = workspace:FindFirstChild("CoinPusher")
			local cab = machine and machine:FindFirstChild("Cabinet")
			local strip = cab and cab:FindFirstChild("LaneStrip" .. tostring(lane))
			if strip then
				local base = strip:GetAttribute("BaseColor") or strip.Color
				strip.Color = strip:GetAttribute("FlashColor") or strip.Color
				local light = Instance.new("PointLight")
				light.Color = strip.Color
				light.Brightness = isJackpot and 7 or 4
				light.Range = isJackpot and 10 or 6
				light.Parent = strip
				TweenService:Create(light, TweenInfo.new(0.5), { Brightness = 0 }):Play()
				task.delay(0.3, function()
					if strip.Parent then
						TweenService:Create(strip, TweenInfo.new(0.4), { Color = base }):Play()
					end
				end)
				task.delay(0.65, function() light:Destroy() end)
			end

			-- (c) Header wall: frame strips + LED flash, HeaderLight bloom.
			for _, framePart in ipairs(bound.headerFrames[lane] or {}) do
				flashHeaderPart(framePart, laneSpec.color)
			end
			flashHeaderPart(bound.laneLeds[lane], laneSpec.color)
			local plateInfo = bound.headerPlates[lane]
			if plateInfo and plateInfo.light and plateInfo.light.Parent then
				local headerLight = plateInfo.light
				local baseRange = headerLight.Range
				headerLight.Range = isJackpot and 8 or baseRange
				TweenService:Create(headerLight,
					TweenInfo.new(0.175, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true),
					{ Brightness = isJackpot and 9 or 6 }):Play()
				task.delay(0.4, function()
					if headerLight.Parent then
						headerLight.Brightness = 0
						headerLight.Range = baseRange
					end
				end)
			end

			-- (d) Absorb film pierce beat, 0.15s after the hit lands.
			local film = bound.laneFilms[lane]
			if film then
				task.delay(0.15, function()
					if not film.Parent then return end
					local baseColor = film:GetAttribute("BaseColor") or film.Color
					film.Color = film:GetAttribute("FlashColor") or laneSpec.color
					local snapIn = TweenService:Create(film, TweenInfo.new(0.15,
						Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = 0.15 })
					snapIn:Play()
					snapIn.Completed:Wait()
					if not film.Parent then return end
					local fadeOut = TweenService:Create(film, TweenInfo.new(0.3,
						Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Transparency = 0.7 })
					fadeOut:Play()
					fadeOut.Completed:Wait()
					if film.Parent then film.Color = baseColor end
				end)
			end

			-- (e) Pool beats: colored burst + glow swell.
			if bound.payBurst and bound.payBurst.Parent then
				bound.payBurst.Color = ColorSequence.new(laneSpec.color)
				bound.payBurst:Emit(isJackpot and 40 or 10)
			end
			if bound.poolGlow and bound.poolGlow.Parent then
				TweenService:Create(bound.poolGlow,
					TweenInfo.new(0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, 0, true),
					{ Brightness = 4 }):Play()
			end

			-- (f) CountLabel tally. Lane 4 has NO CountLabel any more (§B: the
			-- core assembly replaced the plate face) — the nil guard keeps the
			-- session tally from erroring there, and the pot lives on PotLabel.
			if lane ~= 4 then
				laneHits[lane] = laneHits[lane] + 1
				if plateInfo and plateInfo.countLabel and plateInfo.countLabel.Parent then
					plateInfo.countLabel.Text = laneHitText(laneHits[lane])
				end
			end

			-- (g) JACKPOT CORE celebration (§B) — real jackpot hits only; a
			-- lockout-window center hit (pays 25X) stays an ordinary lane flash.
			if lane == 4 and isJackpot then
				-- Hold off the anticipation breathing so the flash owns the orb.
				S.coreFlashUntil = os.clock() + 0.9
				if S.stopCoreAnticipation then S.stopCoreAnticipation() end
				-- Orb flash white + CoreLight 1.5 -> 9 -> 1.5 over 0.8s.
				local orb = bound.coreOrb
				if orb and orb.Parent then
					local orbBase = (S.coreOrbBase and S.coreOrbBase())
						or orb:GetAttribute("BaseColor") or orb.Color
					orb.Color = Color3.new(1, 1, 1)
					TweenService:Create(orb,
						TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
						{ Color = orbBase }):Play()
				end
				local coreLight = bound.coreLight
				if coreLight and coreLight.Parent then
					coreLight.Brightness = 1.5
					local up = TweenService:Create(coreLight,
						TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
						{ Brightness = 9 })
					up:Play()
					up.Completed:Connect(function()
						if coreLight.Parent then
							TweenService:Create(coreLight,
								TweenInfo.new(0.55, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
								{ Brightness = 1.5 }):Play()
						end
					end)
				end
				-- CoreRing: one fast 360 spin about its axis (client-only CFrame
				-- tween, 0.6s). Three chained 120° legs — a single 360 tween
				-- would shortest-path to zero. (Bind revived by the Supernova
				-- Saturn rebuild: the builder's ring is finally NAMED CoreRing.
				-- The moonlet orbit reads the RingCF stamp, never this CFrame,
				-- so the spin can't corrupt the orbit plane.)
				local ring = bound.coreRing
				if ring and ring.Parent then
					task.spawn(function()
						local baseCF = ring.CFrame
						for leg = 1, 3 do
							if not ring.Parent then return end
							local spin = TweenService:Create(ring,
								TweenInfo.new(0.2, Enum.EasingStyle.Linear),
								{ CFrame = baseCF * CFrame.Angles(math.rad(120 * leg), 0, 0) })
							spin:Play()
							spin.Completed:Wait()
						end
						if ring.Parent then ring.CFrame = baseCF end
					end)
				end
				-- SUPERNOVA SATURN payoff (polish-final), all fire-and-forget:
				-- (1) supernova pop — the orb swells to a 1.00 ball (0.50 |x|,
				-- top 3.78 — audited legal) then Back-Out settles home.
				if orb and orb.Parent then
					local popSize = orb:GetAttribute("BaseSize")
					if popSize then
						local popOrb = orb
						local popUp = TweenService:Create(popOrb,
							TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
							{ Size = popSize * 1.28 })
						popUp:Play()
						popUp.Completed:Connect(function()
							if popOrb.Parent then
								TweenService:Create(popOrb,
									TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
									{ Size = popSize }):Play()
							end
						end)
					end
				end
				-- (2) ring transparency flash under the spin: 0.25 -> 0.02 -> 0.25.
				if ring and ring.Parent then
					local flashRing = ring
					local flashIn = TweenService:Create(flashRing,
						TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
						{ Transparency = 0.02 })
					flashIn:Play()
					flashIn.Completed:Connect(function()
						if flashRing.Parent then
							TweenService:Create(flashRing,
								TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
								{ Transparency = 0.25 }):Play()
						end
					end)
				end
				-- (3) moon dive along ring-local -z — the constraint-legal fling
				-- (pitch about x has ZERO x component); owned by the orbit loop.
				if S.moonDive then S.moonDive() end
				-- (4) ember eruption from the crest vent.
				if bound.emberEmit and bound.emberEmit.Parent then bound.emberEmit:Emit(30) end
				if bound.dustEmit and bound.dustEmit.Parent then bound.dustEmit:Emit(12) end
				-- (5) every pip flashes white; the 0.1s cadence repaints them
				-- to the reset pot within a tick.
				for pi = 1, 8 do
					local pipSeg = bound.chargeSegs[pi]
					if pipSeg and pipSeg.Parent then
						pipSeg.Material = Enum.Material.Neon
						pipSeg.Color = Color3.new(1, 1, 1)
						pipSeg.Transparency = 0
					end
				end
				-- EVERY header light pulses, both chase LED columns jump to
				-- full for 0.8s (the Heartbeat chase loop reads the stamp).
				for hi = 1, 7 do
					local info = bound.headerPlates[hi]
					if info and info.light and info.light.Parent then
						local pulse = TweenService:Create(info.light,
							TweenInfo.new(0.2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, 1, true),
							{ Brightness = 6 })
						pulse:Play()
						local pulsedLight = info.light
						task.delay(0.85, function()
							if pulsedLight.Parent then pulsedLight.Brightness = 0 end
						end)
					end
				end
				S.chaseFullUntil = os.clock() + 0.8
				-- Camera shake: the locked-camera RenderStep reads this stamp.
				S.shakeUntil = os.clock() + 0.4
			end
		end)
	end

	-- Core drop path. The sweep is deterministic from server time, so the
	-- client samples the SAME position the carriage draw and the server's
	-- validation clamp compute — dropping is pure timing.
	local function requestDrop()
		local now = os.clock()
		-- Same formula the server enforces — Drop Speed tree nodes change the
		-- real manual rate. Quick Charge mirror: the server halves inside the
		-- post-big-hit window; the client can't see that stamp, so an owner of
		-- the perk gets the halved gate always — early sends outside the real
		-- window are silently absorbed by the server's own cooldown gate.
		local cooldown = GameConfig.dropCooldown(attrGet)
		if GameConfig.statTotal(attrGet, "quickChargeSec") > 0 then
			cooldown = cooldown * 0.5
		end
		if now - lastDrop < cooldown then return end
		lastDrop = now

		local xOffset = GameConfig.sweepX(workspace:GetServerTimeNow(),
			player:GetAttribute("SweepQuick") == true)

		if dropRemote then
			dropRemote:FireServer(xOffset)
		end
		mouthPulseAt = now

		local dome = bound.dome
		if dome and dome.Parent then
			local baseSize = dome:GetAttribute("BaseSize") or dome.Size
			dome.Size = baseSize * 0.82
			task.delay(0.09, function()
				if dome and dome.Parent then dome.Size = baseSize end
			end)
		end

		if not hintFaded then
			hintFaded = true
			TweenService:Create(hintText, TweenInfo.new(0.8), { TextTransparency = 1 }):Play()
			TweenService:Create(hintIcon, TweenInfo.new(0.8), { ImageTransparency = 1 }):Play()
		end
	end

	-- THE one deliberate drop gesture (owner order): the DROP button's own
	-- Activated signal — it covers mouse click, touch tap, and gamepad A on
	-- the selected button, with no click-anywhere path, no global gamepad
	-- bind, and no fullscreen catcher. Clicks on the world, on modals, on
	-- close buttons, or on empty screen space reach NOTHING that drops.
	local function fireDrop()
		S.dropButtonPunch()
		requestDrop()
	end
	dropButton.Activated:Connect(fireDrop)
	S.fireDrop = fireDrop -- shared with nothing today; kept for the button only

	-- HOLD = rapid fire: while the button or Space is held, a task loop
	-- attempts a drop every ~0.05s — the cooldown gate inside requestDrop
	-- paces it to the player's real rate (Drop Speed nodes genuinely speed
	-- this up). The button punch is throttled to ~4x/sec so the cluster
	-- doesn't vibrate at max rate. The loop kills itself on release, when
	-- any page/panel opens (same guards as Space), and when the gui dies.
	local holdActive = false
	local function stopHold()
		holdActive = false
	end
	local function startHold()
		if holdActive then return end
		holdActive = true
		task.spawn(function()
			local lastPunch = 0
			while holdActive and gui.Parent do
				if S.welcomeUp then break end
				if S.treePage.Visible then break end
				if S.forgePage and S.forgePage.Visible then break end
				if panel.Visible then break end
				requestDrop()
				local now = os.clock()
				if now - lastPunch >= 0.25 then
					lastPunch = now
					S.dropButtonPunch()
				end
				task.wait(0.05)
			end
			holdActive = false
		end)
	end
	dropButton.MouseButton1Down:Connect(startHold)
	dropButton.MouseButton1Up:Connect(stopHold)
	dropButton.MouseLeave:Connect(stopHold)

	-- SPACE stays as a deliberate keyboard accelerator for the button — never
	-- while typing, never while any page/panel is open (no drops underneath
	-- another interface). Holding it rapid-fires like holding the button.
	UserInputService.InputBegan:Connect(function(input, gameProcessed)
		if gameProcessed then return end
		if input.KeyCode ~= Enum.KeyCode.Space then return end
		if UserInputService:GetFocusedTextBox() ~= nil then return end
		if S.welcomeUp then return end -- the welcome brick's scrim can't catch keys
		if S.treePage.Visible then return end
		if S.forgePage and S.forgePage.Visible then return end
		if panel.Visible then return end
		fireDrop()
		startHold()
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.KeyCode == Enum.KeyCode.Space then stopHold() end
	end)
end)()

if paidRemote then
	paidRemote.OnClientEvent:Connect(function() end) -- pops come from the attribute
end

