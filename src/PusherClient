			if burstExtra + 1 > shownCount then
				shownCount += 1
				counterLine.Visible = true
				counterLine.Text = ("%s CREATED: %d"):format(
					(GameConfig.FormNames[newForm + 1] or "NEW FORM"):upper(), shownCount)
				-- Mini burst pop per counted copy.
				local mini = fxImage(overlay, FX.BURST, 40, 49, ringColor:Lerp(WHITE, 0.4), 0.1)
				mini.Position = UDim2.fromOffset(
