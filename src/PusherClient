-- THE roll-luck formula (tree + pity heat + throne + perks). Paid boosts
-- are NOT in here any more: they are a tier-scoped magnitude B passed as
-- planetChances' second argument — shared with the server via GameConfig,
-- so the odds you see are the odds you roll.
local function currentLuck()
	-- feverOn mirrors the server's feverActive() — Fever Fortune counts
	-- only while METEOR RAIN runs, in the display AND the roll.
	local feverOn = remotes
		and (remotes:GetAttribute("FeverUntil") or 0) > workspace:GetServerTimeNow()
	return GameConfig.computeRollLuck(attrGet, feverOn)
end

-- DEEP LUCK weight mods, built from the same attrs + inventory mirror the
-- server reads — shown odds ARE rolled odds, by construction.
local function currentMods()
	local magnet = GameConfig.statTotal(attrGet, "rareMagnetPct")
	local deep = GameConfig.statTotal(attrGet, "deepResonancePct")
	local scout = GameConfig.statTotal(attrGet, "scoutPct")
	if magnet <= 0 and deep <= 0 and scout <= 0 then return nil end
	local owned = nil
	if scout > 0 then
		owned = {}
		for k in pairs(invByKey) do
			owned[k] = true
		end
	end
	return { magnet = magnet, deep = deep, scout = scout, owned = owned }
end

-- The live paid-boost magnitude B (100/1000/3500, 0 = none). Personal vs
-- server luck never multiply: the strongest wins (§2 stacking rules), so
-- every odds display uses the same max the server rolls with.
local function currentBoostMag()
	local now = workspace:GetServerTimeNow()
	local mag = GameConfig.boostMagOf(attrGet) or 0
	if remotes and (remotes:GetAttribute("SrvLuckUntil") or 0) > now then
		mag = math.max(mag, remotes:GetAttribute("SrvLuckMag") or 0)
	end
	return mag
end

-- Cumulative "1 in N" for tier >= minTier out of a planetChances list —
-- the honest ULTRA+ / LEGENDARY+ / SECRET rows on every luck disclosure.
local function tierPlusOneIn(chances, minTier)
	local p = 0
	for _, chance in ipairs(chances) do
		if chance.tier >= minTier and chance.oneIn and chance.oneIn > 0 then
			p = p + 1 / chance.oneIn
		end
	end
	if p <= 0 then return nil end
	return math.max(1, math.floor(1 / p + 0.5))
end

-- The three mandatory disclosure rows (current boost -> product boost).
-- Returns COLORABLE triples {label, color, before, after} — the shop respec
-- renders each tier in its own catalog color instead of grey fine print;
-- the legally-required numbers are identical to the old string rows.
local function boostDisclosureLines(mag)
	local luck = currentLuck()
	-- Legally load-bearing: this disclosure must match the server's roll
	-- table EXACTLY — DEEP LUCK weight mods included, both columns.
	local mods = currentMods()
	local base = PusherMachine.planetChances(luck, currentBoostMag(), mods)
	local boosted = PusherMachine.planetChances(luck, mag, mods)
	local rows = {}
	for _, row in ipairs({ { 3, "ULTRA+" }, { 4, "LEGENDARY+" }, { 5, "SECRET" } }) do
		local before = tierPlusOneIn(base, row[1])
		local after = tierPlusOneIn(boosted, row[1])
		if before and after then
			local tierInfo = PusherMachine.Tiers[row[1]]
			table.insert(rows, {
				label = row[2],
				color = (tierInfo and tierInfo.color) or UI_SUB,
				before = before, after = after,
			})
		end
	end
	return rows
end

