			end
		end
		stageWait(0.5)

		-- ===== STAGE 7 — CRACK-OPEN (stage 2 only, 0.50s, Z48): crack
		-- flicker + constellation backdrop + second shockwave + sparkles.
		if stage2 and not skipRequested then
			local constel = fxImage(overlay, FX.CONSTELLATION, 620, 46, WHITE, 1)
			constel.Position = UDim2.fromOffset(cx, cy)
