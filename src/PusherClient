			trackFill.Size = UDim2.new(railFrac(playSecs), 0, 1, 0)
			trackFill.BackgroundColor3 = UI_GOLD
			trackFill.BorderSizePixel = 0
			trackFill.ZIndex = 24
			trackFill.Parent = track
			corner(trackFill, 3)
			bindTicker(trackFill, function(f)
				f.Size = UDim2.new(railFrac(liveSecs()), 0, 1, 0)
			end, 1)
			for i, ms in ipairs(milestones) do
				local isClaimed = maskBit(playClaimedMask, i)
				local isReady = maskBit(playReadyMask, i) and not isClaimed
				local isNext = i == nextFutureIdx
				local station = Instance.new("Frame")
				station.AnchorPoint = Vector2.new(0.5, 0.5)
				station.Position = UDim2.new((i - 0.5) / n, 0, 0, 39)
				station.Size = UDim2.fromOffset(40, 40)
				station.BackgroundTransparency = 1
				station.ZIndex = 25
				station.Parent = rail
				if isReady then
					glow(station, UI_GREEN, 24)
					if not S.reducedMotion then
						local pulse = Instance.new("UIScale")
						pulse.Parent = station
						TweenService:Create(pulse,
							TweenInfo.new(0.55, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
							{ Scale = 1.1 }):Play()
					end
				end
				pixelPlate(station, isClaimed and UI_GOLD or isReady and UI_GREEN or LOCKED, 25, "btn", 2)
				local mark = label(station, isClaimed and CHECK_GLYPH or fmtShortTime(ms), 13,
					isClaimed and DARK_TEXT or isReady and Color3.new(1, 1, 1) or UI_SUB, Enum.Font.GothamBlack)
				mark.Size = UDim2.new(1, 0, 1, -4)
				mark.TextStrokeColor3 = isReady and GREEN_INK or INK
				mark.TextStrokeTransparency = isReady and 0.2 or 1
				mark.ZIndex = 26
				-- A sixth of the rail is ~45px: the amount alone (short
				-- form past 10K), no "IN" / "TIX" — colour and place say it.
				local stationTix = scaledTix(PLAY_CFG.tickets[i])
				local tixText = "+" .. (stationTix >= 10000 and shortValue(stationTix) or formatCommas(stationTix))
				local under = label(rail, "", 12, UI_SUB, Enum.Font.GothamBlack)
				under.AnchorPoint = Vector2.new(0.5, 0)
				under.Position = UDim2.new((i - 0.5) / n, 0, 0, 66)
				under.Size = UDim2.new(1 / n, -2, 0, 14)
				under.TextTruncate = Enum.TextTruncate.AtEnd
				under.ZIndex = 23
				if isClaimed then
					under.Text = "DONE"
				elseif isReady then
					under.Text = tixText
					under.TextColor3 = MINT
				elseif isNext then
					under.TextColor3 = PALE_GOLD
					local stationIdx = i
					bindTicker(under, function(lbl)
						local left = milestones[stationIdx] - liveSecs()
						lbl.Text = left > 0 and fmtClock(left) or "READY!"
					end, 1)
				else
					under.Text = tixText
				end
			end
			fadeIn(rail)
		end

		-- ---- One big CLAIM for the first ready station; countdown otherwise.
		do
			local claimRow = makeRow(60)
			claimRow.BackgroundTransparency = 1
			local claim = brickButton(claimRow, UDim2.new(1, 0, 0, 56), UDim2.new(0, 0, 0, 0), 22, 19)
			if nextReadyIdx then
				claim.setState("ready", ("CLAIM +%s TIX · +%d DUST"):format(
					formatCommas(scaledTix(PLAY_CFG.tickets[nextReadyIdx])),
					PLAY_CFG.dust[nextReadyIdx] or 0))
				local idx = nextReadyIdx
				claim.btn.MouseButton1Click:Connect(function()
					if claimPlaytimeRemote then
						claimPlaytimeRemote:FireServer(idx)
						claim.setState("disabled", "CLAIMING...")
					end
				end)
			elseif nextFutureIdx then
				claim.setState("disabled", "")
				bindTicker(claim.txt, function(lbl)
					local left = playLeft()
					lbl.Text = left > 0 and ("NEXT PRIZE IN %s — KEEP PLAYING!"):format(fmtClock(left))
						or "NEXT PRIZE ANY SECOND..."
				end, 1)
			else
				claim.setState("claimed", ("ALL %d PLAY PRIZES CLAIMED %s"):format(n, CHECK_GLYPH))
			end
			fadeIn(claimRow)
		end
	end
end

-- ============================ RANKS PAGE ================================

local RANK_BOARD_DEFS = {
	{ id = "earned", label = "EARNED", attr = "TotalEarned" },
	{ id = "rebirth", label = "REBIRTHS", attr = "Rebirth" },
	{ id = "found", label = "FOUND", attr = "IndexFound" },
}

local thumbCache = {} -- userId -> content url (session-permanent)
local function setHeadshot(img, userId)
	if not userId then return end
	if thumbCache[userId] then
		img.Image = thumbCache[userId]
		return
	end
	task.spawn(function()
		local ok, url = pcall(function()
			return Players:GetUserThumbnailAsync(userId,
				Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size100x100)
		end)
		if ok and url and url ~= "" then
			thumbCache[userId] = url
			if img.Parent then img.Image = url end
		end
	end)
end

-- Friend ids: page-1 GetFriendsAsync once, pcall'd (loop-leaderboard §2).
local friendIds = nil
local friendFetching = false
local function ensureFriendIds()
	if friendIds or friendFetching then return end
	friendFetching = true
	task.spawn(function()
		local ids = {}
		pcall(function()
			local pages = Players:GetFriendsAsync(player.UserId)
			for _, fr in ipairs(pages:GetCurrentPage()) do
				ids[fr.Id] = true
			end
		end)
		friendIds = ids
		friendFetching = false
		if panel.Visible and openPage == "ranks" then renderPage() end
	end)
end

local function renderRanksPage()
	panelTitle.Text = "TOP PLAYERS"
	pillTabBar({
		{ id = "global", label = "GLOBAL" },
		{ id = "server", label = "SERVER" },
		{ id = "friends", label = "FRIENDS" },
	}, ranksTab, function(id)
		ranksTab = id
		renderPage()
	end)
	local boardTabs = {}
	for _, def in ipairs(RANK_BOARD_DEFS) do
		table.insert(boardTabs, { id = def.id, label = def.label })
	end
	local boardBar = pillTabBar(boardTabs, ranksBoard, function(id)
		ranksBoard = id -- remembered across opens (state local)
		renderPage()
	end)
	local boardDef = RANK_BOARD_DEFS[1]
	for _, def in ipairs(RANK_BOARD_DEFS) do
		if def.id == ranksBoard then boardDef = def end
	end

	-- Board identity: every value on the page wears the picked board's
	-- colour (EARNED gold / REBIRTHS rebirth-red / FOUND index-pink) so a
	-- screenshot says which board it is without reading the chips.
	local BOARD_TINT = {
		earned = UI_GOLD,
		rebirth = Color3.fromRGB(210, 72, 98),
		found = Color3.fromRGB(214, 86, 160),
	}
	local tint = BOARD_TINT[boardDef.id] or UI_GOLD
	local INK = Color3.fromRGB(12, 13, 20) -- the one glyph-stroke colour here
	local STAGE = Color3.fromRGB(16, 17, 26) -- dark brick behind podium/CTA
	local tabLabel = ranksTab == "server" and "SERVER"
		or ranksTab == "friends" and "FRIENDS" or "GLOBAL"
	-- The shared pillTabBar paints the active pill gold; only the active
	-- BOARD chip is recoloured here so the strip carries the identity too.
	for _, pill in ipairs(boardBar:GetChildren()) do
		if pill:IsA("TextButton") and pill.Text == boardDef.label then
			pill.TextColor3 = tint
			pill.BackgroundColor3 = tint:Lerp(UI_BG, 0.8)
			local pillStroke = pill:FindFirstChildOfClass("UIStroke")
			if pillStroke then pillStroke.Color = tint end
		end
	end

	-- Entrance: each block fades in (text / plate / stroke transparency
	-- 1 -> settled over 0.18s), staggered 0.02s per block, via the tween's
	-- own delay so nothing yields. S.reducedMotion renders settled.
	local fadeOrder = 0
	-- Only animate when the VIEW changed (tab/board pick): the ~90s
	-- LeaderboardSync and the friends fetch re-render under the reader,
	-- and a full blink-to-transparent there reads as a glitch.
	local fadeKey = tostring(ranksTab) .. "|" .. tostring(ranksBoard)
	local animateEntrance = S.ranksFadeKey ~= fadeKey
	S.ranksFadeKey = fadeKey
	local function fadeIn(block)
		if S.reducedMotion or not animateEntrance then return end
		local info = TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out,
			0, false, fadeOrder * 0.02)
		fadeOrder = fadeOrder + 1
		local function fade(obj, prop)
			local target = obj[prop]
			if target >= 1 then return end
			obj[prop] = 1
			TweenService:Create(obj, info, { [prop] = target }):Play()
		end
		fade(block, "BackgroundTransparency")
		for _, obj in ipairs(block:GetDescendants()) do
			if obj:IsA("TextLabel") or obj:IsA("TextButton") then
				fade(obj, "TextTransparency")
				fade(obj, "TextStrokeTransparency")
				fade(obj, "BackgroundTransparency")
			elseif obj:IsA("ImageLabel") then
				fade(obj, "ImageTransparency")
				fade(obj, "BackgroundTransparency")
			elseif obj:IsA("Frame") then
				fade(obj, "BackgroundTransparency")
			elseif obj:IsA("UIStroke") then
				fade(obj, "Transparency")
			end
		end
	end

	-- Round headshot on a dark disc with a coloured pixel-frame stroke.
	local function headshot(parent, userId, size, x, y, color, thick, alpha)
		local head = Instance.new("ImageLabel")
		head.BackgroundColor3 = UI_BG
		head.Position = UDim2.new(0, x, 0, y)
		head.Size = UDim2.fromOffset(size, size)
		head.BorderSizePixel = 0
		head.ZIndex = 23
		head.Parent = parent
		corner(head, math.floor(size / 2))
		stroke(head, color, thick, alpha)
		setHeadshot(head, userId)
		return head
	end

	-- FRIENDS retention lever: a pixel-brick INVITE FRIENDS button on a
	-- dark stage — shown whenever the friends board has nobody but you.
	local function inviteBlock(headline)
		local cta = makeRow(132)
		cta.BackgroundTransparency = 1
		pixelPlate(cta, STAGE, 21, "card", 3)
		pixelDither(cta, 22, 0.45)
		local head = label(cta, headline, 16, UI_TEXT, Enum.Font.FredokaOne)
		head.Position = UDim2.new(0, 12, 0, 12)
		head.Size = UDim2.new(1, -24, 0, 22)
		head.ZIndex = 23
		local inv = Instance.new("TextButton")
		inv.AnchorPoint = Vector2.new(0.5, 0)
		inv.Position = UDim2.new(0.5, 0, 0, 42)
		inv.Size = UDim2.fromOffset(240, 50)
		inv.BackgroundTransparency = 1
		inv.Text = ""
		inv.AutoButtonColor = false
		inv.ZIndex = 23
		inv.Parent = cta
		local invFace = pixelPlate(inv, UI_GREEN, 23, "btn", 3)
		local invLbl = label(inv, "INVITE FRIENDS", 20, Color3.new(1, 1, 1), Enum.Font.FredokaOne)
		invLbl.Size = UDim2.new(1, 0, 1, -8)
		invLbl.TextStrokeColor3 = Color3.fromRGB(18, 74, 34)
		invLbl.TextStrokeTransparency = 0.1
		invLbl.ZIndex = 24
		inv.MouseEnter:Connect(function()
			invFace.ImageColor3 = pixelTint(Color3.fromRGB(104, 214, 124))
		end)
		inv.MouseLeave:Connect(function()
			invFace.ImageColor3 = pixelTint(UI_GREEN)
		end)
		inv.MouseButton1Click:Connect(function()
			pcall(function()
				game:GetService("SocialService"):PromptGameInvite(player)
			end)
		end)
		local sub = label(cta, "PLAY WITH FRIENDS, RACE THE BOARD!", 12, UI_GOLD, Enum.Font.GothamBlack)
		sub.Position = UDim2.new(0, 12, 0, 102)
		sub.Size = UDim2.new(1, -24, 0, 16)
		sub.ZIndex = 23
		fadeIn(cta)
	end

	-- Assemble the row list for the active tab.
	local rows = nil
	if ranksTab == "server" then
		rows = {}
		for _, plr in ipairs(Players:GetPlayers()) do
			table.insert(rows, {
				name = plr.DisplayName,
				value = plr:GetAttribute(boardDef.attr) or 0,
				userId = plr.UserId,
			})
		end
		table.sort(rows, function(a, b) return a.value > b.value end)
	else
		local boards = S.lbBoards
		local list = boards and boards[ranksBoard] or nil
		if ranksTab == "friends" then
			ensureFriendIds()
			if list and friendIds then
				rows = {}
				for _, entry in ipairs(list) do
					if friendIds[entry.userId] or entry.userId == player.UserId then
						table.insert(rows, entry)
					end
				end
			end
		else
			rows = list
		end
	end

	-- Your rank on THIS list (nil = not in the cached top-50 -> "50+"),
	-- and how many friends actually share the friends board with you.
	local myValue = player:GetAttribute(boardDef.attr) or 0
	local myRank = nil
	local friendsOnBoard = 0
	if rows then
		for i, entry in ipairs(rows) do
			if entry.userId == player.UserId then
				if not myRank then myRank = i end
			else
				friendsOnBoard = friendsOnBoard + 1
			end
		end
	end

	-- ---- YOUR CARD, pinned FIRST: the number a kid screenshots ----
	do
		local card = makeRow(84)
		card.BackgroundTransparency = 1
		pixelPlate(card, Color3.fromRGB(58, 46, 18), 21, "card", 3)
		pixelDither(card, 22, 0.4)
		headshot(card, player.UserId, 56, 14, 14, UI_GOLD, 2.4, 0.05)
		local eyebrow = label(card, "YOU", 11, UI_GOLD, Enum.Font.GothamBlack)
		eyebrow.Position = UDim2.new(0, 82, 0, 10)
		eyebrow.Size = UDim2.new(1, -290, 0, 14)
		eyebrow.TextXAlignment = Enum.TextXAlignment.Left
		eyebrow.ZIndex = 23
		local nm = label(card, player.DisplayName, 18, UI_TEXT, Enum.Font.GothamBlack)
		nm.Position = UDim2.new(0, 82, 0, 24)
		nm.Size = UDim2.new(1, -290, 0, 22)
		nm.TextTruncate = Enum.TextTruncate.AtEnd
		nm.TextXAlignment = Enum.TextXAlignment.Left
		nm.ZIndex = 23
		-- Motivator: the gap to the entry above you, from the same rows.
		local motiv
		if myRank == 1 then
			motiv = "YOU'RE #1 — DEFEND IT!"
		elseif myRank then
			local above = rows[myRank - 1]
			local need = math.floor((above.value or 0) - myValue + 1)
			if need > 0 then
				motiv = ("+%s TO PASS #%d"):format(formatCommas(need), myRank - 1)
			else
				motiv = ("PASSING #%d — BOARD UPDATING!"):format(myRank - 1)
			end
		elseif ranksTab == "friends" and not friendIds then
			motiv = "FINDING YOUR FRIENDS..."
		else
			motiv = "REACH THE TOP 25!"
		end
		local mv = label(card, motiv, 12, Color3.fromRGB(255, 226, 150), Enum.Font.GothamBold)
		mv.Position = UDim2.new(0, 82, 0, 50)
		mv.Size = UDim2.new(1, -290, 0, 16)
		mv.TextTruncate = Enum.TextTruncate.AtEnd
		mv.TextXAlignment = Enum.TextXAlignment.Left
		mv.ZIndex = 23
		local rk = label(card, myRank and ("#" .. myRank)
			or ((ranksTab == "friends" and not friendIds) and "..." or "50+"),
			32, UI_GOLD, Enum.Font.FredokaOne)
		rk.AnchorPoint = Vector2.new(1, 0)
		rk.Position = UDim2.new(1, -14, 0, 6)
		rk.Size = UDim2.fromOffset(200, 40)
		rk.TextXAlignment = Enum.TextXAlignment.Right
		rk.TextStrokeColor3 = INK
		rk.TextStrokeTransparency = 0.4
		rk.ZIndex = 23
		local val = label(card, formatCommas(myValue) .. " " .. boardDef.label, 13, UI_TEXT, Enum.Font.GothamBlack)
		val.AnchorPoint = Vector2.new(1, 0)
		val.Position = UDim2.new(1, -14, 0, 50)
		val.Size = UDim2.fromOffset(200, 16)
		val.TextTruncate = Enum.TextTruncate.AtEnd
		val.TextXAlignment = Enum.TextXAlignment.Right
		val.ZIndex = 23
		fadeIn(card)
	end

	if not rows or #rows == 0 then
		if ranksTab == "friends" then
			inviteBlock(friendIds and "NO FRIENDS ON THE BOARD YET" or "FINDING YOUR FRIENDS...")
		else
			-- Studio / empty fallback: ghost rows + an honest line.
			for _ = 1, 3 do
				local row = makeRow(44)
				row.BackgroundTransparency = 0.4
				local dash = label(row, "—", 14, UI_SUB, Enum.Font.GothamBold)
				dash.Size = UDim2.fromScale(1, 1)
				dash.ZIndex = 22
			end
			local msgRow = makeRow(34)
			msgRow.BackgroundTransparency = 1
			local msg = label(msgRow, "PUBLISH TO SEE GLOBAL RANKS", 13, UI_SUB, Enum.Font.GothamBlack)
			msg.Size = UDim2.new(1, -8, 1, 0)
			msg.Position = UDim2.new(0, 4, 0, 0)
			msg.ZIndex = 22
		end
	else
		-- ---- PODIUM: a stage. Dark brick behind, three pixel pedestals
		-- (1st tallest, centre) in gold/silver/bronze, heads on the tier
		-- stroke, name + EXACT value stacked above each pedestal. ----
		local PODIUM = {
			{ rank = 1, x = 0.5, size = 72, pedH = 62, tag = "1ST", tint = Color3.fromRGB(255, 200, 80) },
			{ rank = 2, x = 0.17, size = 58, pedH = 44, tag = "2ND", tint = Color3.fromRGB(200, 204, 214) },
			{ rank = 3, x = 0.83, size = 58, pedH = 32, tag = "3RD", tint = Color3.fromRGB(205, 127, 50) },
		}
		local stage = makeRow(206)
		stage.BackgroundTransparency = 1
		pixelPlate(stage, STAGE, 21, "card", 3)
		pixelDither(stage, 22, 0.45)
		local cap = label(stage, tabLabel .. " TOP 3 · " .. boardDef.label, 11, tint, Enum.Font.GothamBlack)
		cap.Position = UDim2.new(0, 14, 0, 8)
		cap.Size = UDim2.new(1, -28, 0, 14)
		cap.TextXAlignment = Enum.TextXAlignment.Left
		cap.ZIndex = 23
		for _, pd in ipairs(PODIUM) do
			local entry = rows[pd.rank]
			local isYou = entry ~= nil and entry.userId == player.UserId
			local ped = Instance.new("Frame")
			ped.AnchorPoint = Vector2.new(0.5, 1)
			ped.Position = UDim2.new(pd.x, 0, 1, -10)
			ped.Size = UDim2.new(0.28, 0, 0, pd.pedH)
			ped.BackgroundTransparency = 1
			ped.ZIndex = 23
			ped.Parent = stage
			pixelPlate(ped, entry and pd.tint or pd.tint:Lerp(STAGE, 0.6), 23, "btn", 2)
			local tag = label(ped, pd.tag, 14, entry and Color3.fromRGB(30, 26, 14) or UI_SUB,
				Enum.Font.GothamBlack)
			tag.Position = UDim2.new(0, 0, 0, 3)
			tag.Size = UDim2.new(1, 0, 0, 22)
			tag.ZIndex = 24
			-- Stack grows upward off the pedestal top: value, name, head.
			local baseY = -10 - pd.pedH
			local nm = label(stage, entry and tostring(entry.name or "?") or "OPEN",
				pd.rank == 1 and 14 or 12,
				isYou and UI_GOLD or entry and UI_TEXT or UI_SUB,
				isYou and Enum.Font.GothamBlack or Enum.Font.GothamBold)
			nm.AnchorPoint = Vector2.new(0.5, 1)
			nm.Position = UDim2.new(pd.x, 0, 1, baseY - 18)
			nm.Size = UDim2.fromOffset(124, 16)
			nm.TextTruncate = Enum.TextTruncate.AtEnd
			nm.ZIndex = 23
			if entry then
				local val = label(stage, formatCommas(entry.value or 0),
					pd.rank == 1 and 15 or 13, tint, Enum.Font.GothamBlack)
				val.AnchorPoint = Vector2.new(0.5, 1)
				val.Position = UDim2.new(pd.x, 0, 1, baseY - 2)
				val.Size = UDim2.fromOffset(136, 16)
				val.ZIndex = 23
				local head = headshot(stage, entry.userId, pd.size, 0, 0, pd.tint,
					pd.rank == 1 and 3 or 2, 0.05)
				head.AnchorPoint = Vector2.new(0.5, 1)
				head.Position = UDim2.new(pd.x, 0, 1, baseY - 36)
			end
		end
		fadeIn(stage)

		-- ---- ROWS 4-25: pixel-brick rows, rank plate by band, headshot,
		-- name, EXACT value in the board colour. Your row stays gold. ----
		for i = 4, math.min(#rows, 25) do
			local entry = rows[i]
			local isYou = entry.userId == player.UserId
			local row = makeRow(44)
			row.BackgroundTransparency = 1
			local face = UI_ROW
			if isYou then
				face = Color3.fromRGB(64, 52, 20)
			elseif i % 2 == 1 then
				face = UI_ROW:Lerp(Color3.new(1, 1, 1), 0.05)
			end
			pixelPlate(row, face, 21, "btn", 2)
			local rkPlate = Instance.new("Frame")
			rkPlate.Position = UDim2.new(0, 6, 0, 3)
			rkPlate.Size = UDim2.fromOffset(34, 34)
			rkPlate.BackgroundTransparency = 1
			rkPlate.ZIndex = 22
			rkPlate.Parent = row
			pixelPlate(rkPlate, isYou and UI_GOLD
				or i <= 10 and UI_GOLD:Lerp(UI_ROW, 0.6)
				or Color3.fromRGB(70, 74, 94), 22, "btn", 2)
			local rk = label(rkPlate, "#" .. i, 13, isYou and INK or Color3.new(1, 1, 1), Enum.Font.GothamBlack)
			rk.Size = UDim2.new(1, 0, 1, -5)
			rk.TextStrokeColor3 = INK
			rk.TextStrokeTransparency = isYou and 1 or 0.3
			rk.ZIndex = 23
			headshot(row, entry.userId, 30, 48, 5,
				isYou and UI_GOLD or Color3.fromRGB(60, 62, 80), 1.4, isYou and 0.1 or 0.4)
			local nm = label(row, tostring(entry.name or "?"), 14,
				isYou and UI_GOLD or UI_TEXT, isYou and Enum.Font.GothamBlack or Enum.Font.GothamBold)
			nm.Position = UDim2.new(0, 88, 0, 0)
			nm.Size = UDim2.new(1, -236, 1, -5)
			nm.TextTruncate = Enum.TextTruncate.AtEnd
			nm.TextXAlignment = Enum.TextXAlignment.Left
			nm.ZIndex = 22
			local val = label(row, formatCommas(entry.value or 0), 14, tint, Enum.Font.GothamBlack)
			val.AnchorPoint = Vector2.new(1, 0)
			val.Position = UDim2.new(1, -12, 0, 0)
			val.Size = UDim2.new(0, 140, 1, -5)
			val.TextXAlignment = Enum.TextXAlignment.Right
			val.ZIndex = 22
			fadeIn(row)
		end

		if ranksTab == "friends" and friendsOnBoard == 0 then
			inviteBlock("IT'S JUST YOU UP THERE!")
		end
	end

	-- Cadence honesty footer (loop-leaderboard §5; 12px floor).
	local footRow = makeRow(24)
	footRow.BackgroundTransparency = 1
	local foot = label(footRow, "UPDATES EVERY MINUTE OR TWO", 12, UI_SUB, Enum.Font.Gotham)
	foot.Size = UDim2.new(1, -8, 1, 0)
	foot.Position = UDim2.new(0, 4, 0, 0)
