-- Top-center toast rail: one UIListLayout stack, so burst claims (claim-all
-- sprees, mission+star+chest landing together) queue instead of overlapping.
;(function() -- section scope: own register budget (main chunk hit Luau's 200-local cap live)
	local toastRail = Instance.new("Frame")
	toastRail.Name = "ToastRail"
	toastRail.AnchorPoint = Vector2.new(0.5, 0)
	toastRail.Position = UDim2.new(0.5, 0, 0, 208)
	toastRail.Size = UDim2.fromOffset(360, 0)
	toastRail.AutomaticSize = Enum.AutomaticSize.Y
	toastRail.BackgroundTransparency = 1
	toastRail.ZIndex = 42
	toastRail.Parent = gui
	local railLayout = Instance.new("UIListLayout")
	railLayout.FillDirection = Enum.FillDirection.Vertical
	railLayout.Padding = UDim.new(0, 6)
	railLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	railLayout.SortOrder = Enum.SortOrder.LayoutOrder
	railLayout.Parent = toastRail

	-- Live-plate registry, oldest first. Each entry owns its own deadline so
	-- coalescing merges can extend a plate's life without a global timer.
	local liveToasts = {}
	local toastOrder = 0

	local function killToast(entry, quick)
		if entry.dying then return end
		entry.dying = true
		for i, e in ipairs(liveToasts) do
			if e == entry then table.remove(liveToasts, i) break end
		end
		local dur = quick and 0.15 or 0.4
		-- The rail's layout owns the holder; the plate slides inside it.
		if not quick and not S.reducedMotion then
			TweenService:Create(entry.plate, TweenInfo.new(dur, Enum.EasingStyle.Quad),
				{ Position = UDim2.new(0.5, 0, 0, -20), BackgroundTransparency = 1 }):Play()
		else
			TweenService:Create(entry.plate, TweenInfo.new(dur), { BackgroundTransparency = 1 }):Play()
		end
		TweenService:Create(entry.textLabel, TweenInfo.new(dur), { TextTransparency = 1 }):Play()
		task.delay(dur + 0.1, function() entry.holder:Destroy() end)
	end

	local function armToast(entry)
		local gen = entry.gen
		task.delay(entry.deadline - os.clock(), function()
			if entry.gen == gen and not entry.dying then killToast(entry, false) end
		end)
	end

	-- opts = { text, accent, key, tickets, dust }. Same-key plates younger
	-- than 1.6s absorb the new claim instead of spawning a sibling.
	local function pushToast(opts)
		local now = os.clock()
		if opts.key then
			for _, entry in ipairs(liveToasts) do
				if entry.key == opts.key and not entry.dying and now - entry.born < 1.6 then
					entry.claims += 1
					entry.tickets += opts.tickets or 0
					entry.dust += opts.dust or 0
					entry.textLabel.Text = ("%d REWARDS CLAIMED  +%s TIX  +%s DUST")
						:format(entry.claims, shortValue(entry.tickets), shortValue(entry.dust))
					entry.scale.Scale = 0.92
					TweenService:Create(entry.scale, TweenInfo.new(0.25, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
						{ Scale = 1 }):Play()
					entry.deadline = now + 2.6
					entry.gen += 1
					armToast(entry)
					return
				end
			end
		end
		-- Cap at 3 live plates: a 4th evicts the oldest with a quick fade.
		if #liveToasts >= 3 then
			killToast(liveToasts[1], true)
		end
		toastOrder += 1
		local holder = Instance.new("Frame")
		holder.Size = UDim2.fromOffset(340, 40)
		holder.BackgroundTransparency = 1
		holder.LayoutOrder = toastOrder
		holder.ZIndex = 42
		holder.Parent = toastRail
		local accent = opts.accent or UI_GOLD
		local toast = Instance.new("Frame")
		toast.AnchorPoint = Vector2.new(0.5, 0)
		toast.Position = UDim2.new(0.5, 0, 0, 0)
		toast.Size = UDim2.fromScale(1, 1)
		toast.BackgroundColor3 = UI_BG
		toast.BackgroundTransparency = 0.08
		toast.BorderSizePixel = 0
		toast.ZIndex = 42
		toast.Parent = holder
		corner(toast, 12)
		stroke(toast, accent, 1.6, 0.25)
		local plateScale = Instance.new("UIScale")
		plateScale.Parent = toast
		local toastText = label(toast, opts.text, 14, accent, Enum.Font.GothamBlack)
		toastText.Size = UDim2.new(1, -16, 1, 0)
		toastText.Position = UDim2.new(0, 8, 0, 0)
		toastText.ZIndex = 43
		local entry = {
			holder = holder, plate = toast, textLabel = toastText, scale = plateScale,
			key = opts.key, born = now, deadline = now + 2.6, gen = 0, dying = false,
			claims = 1, tickets = opts.tickets or 0, dust = opts.dust or 0,
		}
		table.insert(liveToasts, entry)
		if not S.reducedMotion then
			toast.Position = UDim2.new(0.5, 0, 0, -20)
			TweenService:Create(toast, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
				{ Position = UDim2.new(0.5, 0, 0, 0) }):Play()
		end
		armToast(entry)
	end

	-- Legacy signature, kept for every existing caller (S.showToast included).
	local function showToast(text, accentColor)
		pushToast{ text = text, accent = accentColor }
	end

	-- Jackpot-banner-pattern celebration plate for the bigger moments.
	local function playCelebration(titleText, subText)
		local banner = Instance.new("ImageLabel")
		banner.Image = UI_PLATE
		banner.ScaleType = Enum.ScaleType.Slice
		banner.SliceCenter = PLATE_SLICE
		banner.BackgroundTransparency = 1
		banner.ImageColor3 = Color3.fromRGB(255, 226, 150)
		banner.AnchorPoint = Vector2.new(0.5, 0)
		banner.Position = UDim2.new(0.5, 0, 0, 130)
		banner.Size = UDim2.fromOffset(400, 70)
		banner.ZIndex = 42
		banner.Parent = gui
		local badge = Instance.new("ImageLabel")
		badge.Image = UI_100X
		badge.BackgroundTransparency = 1
		badge.Size = UDim2.fromOffset(46, 46)
		badge.Position = UDim2.new(0, 10, 0.5, -23)
		badge.ZIndex = 43
		badge.Parent = banner
		local bTitle = label(banner, titleText, 16, Color3.fromRGB(70, 50, 12), Enum.Font.GothamBlack)
		bTitle.Position = UDim2.new(0, 62, 0, subText and 10 or 0)
		bTitle.Size = UDim2.new(1, -70, 0, subText and 22 or 70)
		bTitle.TextXAlignment = Enum.TextXAlignment.Left
		bTitle.ZIndex = 43
		local bSub = nil
		if subText then
			bSub = label(banner, subText, 12, Color3.fromRGB(96, 70, 20), Enum.Font.GothamBold)
			bSub.Position = UDim2.new(0, 62, 0, 36)
			bSub.Size = UDim2.new(1, -70, 0, 18)
			bSub.TextXAlignment = Enum.TextXAlignment.Left
			bSub.ZIndex = 43
		end
		TweenService:Create(banner, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
			{ Position = UDim2.new(0.5, 0, 0, 150) }):Play()
		task.delay(3, function()
			TweenService:Create(banner, TweenInfo.new(0.5, Enum.EasingStyle.Quad),
				{ Position = UDim2.new(0.5, 0, 0, 110), ImageTransparency = 1 }):Play()
			TweenService:Create(bTitle, TweenInfo.new(0.5), { TextTransparency = 1 }):Play()
			if bSub then TweenService:Create(bSub, TweenInfo.new(0.5), { TextTransparency = 1 }):Play() end
			TweenService:Create(badge, TweenInfo.new(0.5), { ImageTransparency = 1 }):Play()
			task.delay(0.6, function() banner:Destroy() end)
		end)
	end

	-- Celebration FIFO: one banner at a time. Queue caps at 3 (drop-newest
	-- beyond that); an exact back-to-back duplicate is skipped outright.
	local celebrationBusy = false
	local celebrationCurrent = nil
	local celebrationQueue = {}
	local function showCelebration(titleText, subText)
		if celebrationBusy then
			local prev = celebrationQueue[#celebrationQueue] or celebrationCurrent
			if prev and prev[1] == titleText and prev[2] == subText then return end
			if #celebrationQueue >= 3 then return end
			table.insert(celebrationQueue, { titleText, subText })
			return
		end
		celebrationBusy = true
		celebrationCurrent = { titleText, subText }
		playCelebration(titleText, subText)
		task.delay(3.55, function() -- 0.35 in + 3 hold + fade-out overlap
			celebrationBusy = false
			celebrationCurrent = nil
			local nextUp = table.remove(celebrationQueue, 1)
			if nextUp then showCelebration(nextUp[1], nextUp[2]) end
		end)
	end

	if feverBlastRemote then
		feverBlastRemote.OnClientEvent:Connect(function(byName)
			-- Full banner + flash only for the player who set it off; everyone
			-- else gets a toast — the serverwide announcement was firing the
			-- big celebration at the whole server every few minutes.
			if byName == player.Name then
				goldFlash()
				showCelebration("METEOR RAIN!", "You set it off — x2 for everyone!")
			else
				pushToast{
					text = ((byName or "Someone") .. " STARTED METEOR RAIN — x2 FOR EVERYONE!"),
					accent = Color3.fromRGB(255, 170, 80),
				}
			end
		end)
	end

	-- Server-wide boost purchases announce like a fever blast (§2).
	if boostAnnounceRemote then
		boostAnnounceRemote.OnClientEvent:Connect(function(byName, boostLabel)
			showCelebration((boostLabel or "SERVER BOOST!"):upper(),
				(byName or "Someone") .. " bought it for everyone here!")
		end)
	end

	if chestRemote then
		chestRemote.OnClientEvent:Connect(function(tickets, dust)
			goldFlash()
			showCelebration("GALAXY CHEST!",
				("+%d TIX  ·  +%d DUST"):format(tickets or 0, dust or 0))
		end)
	end

	-- The claim family shares key="claim": a claim-all spree coalesces into
	-- one growing "N REWARDS CLAIMED" plate instead of a stack of plates.
	if dailyToastRemote then
		dailyToastRemote.OnClientEvent:Connect(function(kind, tickets, dust, extra)
			if kind == "mission" then
				pushToast{ key = "claim", tickets = tickets or 0, dust = dust or 0,
					text = ("MISSION COMPLETE!  +%d TIX  +%d DUST"):format(tickets or 0, dust or 0) }
			elseif kind == "star" then
				pushToast{ key = "claim", text = "DAILY STAR EARNED!  +1 " .. STAR_GLYPH }
			elseif kind == "prize" then
				if (dust or 0) > 0 then
					showToast(("CONSTELLATION COMPLETE!  +%d DUST"):format(dust),
						Color3.fromRGB(210, 170, 255))
				else
					showCelebration("CONSTELLATION COMPLETE!",
						GameConfig.Daily.rewardName .. " UNLOCKED!")
				end
			elseif kind == "chest" then
				pushToast{ key = "claim", tickets = tickets or 0, dust = dust or 0,
					accent = Color3.fromRGB(196, 130, 255),
					-- "BONUS CHEST", matching the daily page's own row label —
					-- "GALAXY CHEST" is the fever chest's celebration name.
					text = ("BONUS CHEST!  +%d TIX  +%d DUST"):format(tickets or 0, dust or 0) }
			elseif kind == "playtime" then
				pushToast{ key = "claim", tickets = tickets or 0, dust = dust or 0,
					text = ("PLAYTIME REWARD!  +%d TIX  +%d DUST"):format(tickets or 0, dust or 0) }
			elseif kind == "gift" then
				-- Tutorial starter gift: the server topped the first-rolled
				-- ball up to a full forge recipe (extra = "+N NAME").
				goldFlash()
				showCelebration("STARTER GIFT!",
					((extra and tostring(extra)) or "") .. "  —  ENOUGH TO FORGE!")
			elseif kind == "product" then
				goldFlash()
				showCelebration("PURCHASE ACTIVE!",
