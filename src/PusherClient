		-- Plain left-aligned line (truncates; callers flip TextWrapped).
		local function line(parent, text, size, color, font, posU, sizeU, zindex)
			local l = label(parent, text, size, color, font)
			l.Position = posU
			l.Size = sizeU
			l.TextXAlignment = Enum.TextXAlignment.Left
			l.TextTruncate = Enum.TextTruncate.AtEnd
			l.ZIndex = zindex
			return l
		end
		-- Product name: 15px GothamBlack, scaled with a 12px floor so the
		-- long names still fit the 2-col cards on phones.
		local function nameLabel(parent, text, posU, sizeU, color, zindex)
			local l = line(parent, text, 15, color, Enum.Font.GothamBlack, posU, sizeU, zindex)
			l.TextScaled = true
			local fit = Instance.new("UITextSizeConstraint")
			fit.MinTextSize = 12
			fit.MaxTextSize = 15
			fit.Parent = l
			return l
		end
		-- Stamp chip (not a button): FredokaOne text on a small brick.
		-- anchorX 1 = right-aligned (default), 0 = left, 0.5 = centred.
		local function chip(parent, posU, w, face, text, textColor, ink, zindex, anchorX)
			local c = Instance.new("Frame")
			c.AnchorPoint = Vector2.new(anchorX or 1, 0)
			c.Position = posU
			c.Size = UDim2.fromOffset(w, 28)
			c.BackgroundTransparency = 1
			c.ZIndex = zindex
			c.Parent = parent
			pixelPlate(c, face, zindex, "btn", 2)
			local t = label(c, text, 13, textColor, Enum.Font.FredokaOne)
			t.Position = UDim2.new(0, 4, 0, 0)
			t.Size = UDim2.new(1, -8, 1, -5)
			t.TextTruncate = Enum.TextTruncate.AtEnd
			if ink then
				t.TextStrokeColor3 = ink
				t.TextStrokeTransparency = 0.2
			end
			t.ZIndex = zindex + 1
			return c
		end
		-- §3b duration pill: a dark chip in the family tint (top-right of a
		-- card unless the caller places it).
		local function durationPill(parent, text, tint, posU, zindex, anchorX)
			if not text then return nil end
			return chip(parent, posU or UDim2.new(1, -10, 0, 10), 76, tint:Lerp(UI_BG, 0.7),
				text, tint, nil, zindex or 23, anchorX)
