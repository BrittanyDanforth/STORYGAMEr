						elseif i <= lit then
							seg.Material = Enum.Material.Neon
							local fill = seg:GetAttribute("FillColor")
							if fill then seg.Color = fill end
						else
							seg.Material = Enum.Material.SmoothPlastic
							local base = seg:GetAttribute("BaseColor")
							if base then seg.Color = base end
						end
					end
				end
			end
			feverPrevLit = lit

			-- Fever comet rides the fill: the builder welds it at the tube top
			-- forever. No RO/rest stamp exists for this part, so lerp along
			-- the tube part's own axis (its Size.Y spans bottom -> top through
			-- its CFrame), with a small lead so the comet heads the column.
			-- An active fever window parks it at the top while the tube
			-- strobes full.
			local comet = bound.feverComet
			if comet and comet.Parent then
				if not (feverTubePart and feverTubePart.Parent == comet.Parent) then
					feverTubePart = comet.Parent:FindFirstChild("FeverTube")
				end
				if feverTubePart then
					local frac = feverOn and 1 or lit / 20
					comet.CFrame = feverTubePart.CFrame
						* CFrame.new(0, feverTubePart.Size.Y * (frac - 0.5) + 0.34, 0)
				end
			end
		end
	end)
end)()
