			stroke(card, UI_GOLD, 4, 0)
			local firstLine = label(overlay, "FIRST DISCOVERY!", 16, UI_GOLD, Enum.Font.GothamBlack)
			firstLine.AnchorPoint = Vector2.new(0.5, 0)
			firstLine.Position = UDim2.new(0.5, 0, 0, 78)
			firstLine.Size = UDim2.new(1, 0, 0, 20)
			firstLine.TextStrokeColor3 = GOLD_TEXT_STROKE
			firstLine.TextStrokeTransparency = 0.15
			firstLine.ZIndex = 49
		end
		local title = label(card,
			((GameConfig.FormNames[newForm + 1] or "") .. " " .. name):upper(), 18,
