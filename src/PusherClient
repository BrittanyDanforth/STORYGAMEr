--------------------------------------------------------------------------------
-- Machine binding (survives zone-switch rebuilds)
--------------------------------------------------------------------------------

local bound = {
	machine = nil, origin = nil,
	chaseL = {}, chaseR = {}, trayLeds = {}, bulbs = {}, winLine = nil,
	letters = {}, jackpotValue = nil, jackpotLabel = nil,
	carriage = nil, carriageRest = nil, mouthPart = nil, mouthBaseSize = nil,
	pusherGroups = {}, dome = nil,
	headerPlates = {}, headerFrames = {}, laneLeds = {}, laneFilms = {},
	feverSegs = {}, poolGlow = nil, feverComet = nil, payBurst = nil,
	coreOrb = nil, coreLight = nil, coreRing = nil, chargeSegs = {},
	moonlets = {}, emberVent = nil, emberEmit = nil, dustEmit = nil,
	potLabel = nil, coreTitle = nil,
}
local firstBind = true

local function bindMachine(machine)
	-- Rebind the palette FIRST so everything a bind caches derives from the
	-- zone's theme — CFG stayed the raw zone-1 DEFAULTS and repainted themed
	-- cabinets in zone 1's ambers.
	CFG = PusherMachine.themedConfigFor((remotes and remotes:GetAttribute("Zone")) or 1)
	local state = {
		machine = machine,
		chaseL = {}, chaseR = {}, trayLeds = {}, bulbs = {},
		winLine = nil, letters = {}, jackpotValue = nil, jackpotLabel = nil,
		carriage = nil, carriageRest = nil, mouthPart = nil, mouthBaseSize = nil,
		pusherGroups = {}, dome = nil,
		headerPlates = {}, headerFrames = {}, laneLeds = {}, laneFilms = {},
		feverSegs = {}, poolGlow = nil, feverComet = nil, payBurst = nil,
		coreOrb = nil, coreLight = nil, coreRing = nil, chargeSegs = {},
		moonlets = {}, emberVent = nil, emberEmit = nil, dustEmit = nil,
		potLabel = nil, coreTitle = nil,
	}

	local cabinet = machine:WaitForChild("Cabinet", 10)
	local playfield = machine:WaitForChild("Playfield", 10)
	local fx = machine:WaitForChild("FX", 10)
	if not (cabinet and playfield and fx) then return end

	local body = cabinet:WaitForChild("Body", 5)
	if not body then return end
	state.origin = body.CFrame * CFrame.new(0, -2.745, -1.85)
	state.dome = cabinet:FindFirstChild("DropButton")

	-- Stadium Steps header wall + basin dressing. Explicit 1..N loops, never
	-- ipairs over a possibly-sparse scan: streaming can leave holes.
	for i = 1, 7 do
		local plate = cabinet:FindFirstChild("LaneHeader" .. i)
		if plate then
			local hgui = plate:FindFirstChild("HeaderGui")
			state.headerPlates[i] = {
				plate = plate,
				light = plate:FindFirstChild("HeaderLight"),
				tierLabel = hgui and hgui:FindFirstChild("TierLabel"),
				countLabel = hgui and hgui:FindFirstChild("CountLabel"),
			}
		end
		local frames = {}
		for _, edge in ipairs({ "T", "B", "L", "R" }) do
			local strip = cabinet:FindFirstChild("HeaderFrame" .. edge .. i)
			if strip then table.insert(frames, strip) end
		end
		state.headerFrames[i] = frames
		state.laneLeds[i] = cabinet:FindFirstChild("LaneLED" .. i)
		state.laneFilms[i] = cabinet:FindFirstChild("AbsorbFilm" .. i)
	end
	-- SUPERNOVA SATURN centerpiece (polish-final): orb + light + tilted
	-- CoreRing + 8-seg charge arc on the ring + orbiting moonlets + ember
	-- vent + live pot label + title plate, all cabinet children like the
	-- headers. CoreRing carries the build-stamped RingCF attr the moonlet
	-- orbit reads (never the live CFrame — the celebration spin moves that).
	state.coreOrb = cabinet:FindFirstChild("CoreOrb")
	state.coreLight = state.coreOrb and state.coreOrb:FindFirstChild("CoreLight")
	state.coreRing = cabinet:FindFirstChild("CoreRing")
	for i = 1, 8 do
		state.chargeSegs[i] = cabinet:FindFirstChild("ChargeSeg" .. i)
	end
	for i = 1, 2 do
		state.moonlets[i] = cabinet:FindFirstChild("Moonlet" .. i)
	end
	state.emberVent = cabinet:FindFirstChild("EmberVent")
	state.emberEmit = state.emberVent and state.emberVent:FindFirstChild("EmberEmit")
	state.dustEmit = state.emberVent and state.emberVent:FindFirstChild("DustEmit")
	do
		local potPlate = cabinet:FindFirstChild("PotPlate")
		local potGui = potPlate and potPlate:FindFirstChild("PotGui")
		state.potLabel = potGui and potGui:FindFirstChild("PotLabel")
	end
	state.coreTitle = cabinet:FindFirstChild("CoreTitle")
	for i = 1, 20 do
		state.feverSegs[i] = fx:FindFirstChild("FeverSeg" .. i)
	end
	local poolHost = cabinet:FindFirstChild("PoolLightHost")
	state.poolGlow = poolHost and poolHost:FindFirstChild("PoolGlow")
	state.feverComet = fx:FindFirstChild("FeverComet")
	local burstHost = fx:FindFirstChild("PayBurstHost")
	state.payBurst = burstHost
		and (burstHost:FindFirstChild("PayBurst") or burstHost:FindFirstChildOfClass("ParticleEmitter"))

	for _, item in ipairs(fx:GetChildren()) do
		local name = item.Name
		if name:sub(1, 6) == "ChaseL" then
			state.chaseL[tonumber(name:sub(7)) + 1] = item
		elseif name:sub(1, 6) == "ChaseR" then
			state.chaseR[tonumber(name:sub(7)) + 1] = item
		elseif name == "TrayLed" then
			table.insert(state.trayLeds, item)
		elseif name:sub(1, 4) == "Bulb" then
			state.bulbs[tonumber(name:sub(5)) + 1] = item
		elseif name == "WinLine" then
			state.winLine = item
		elseif name == "DropperCarriage" then
			state.carriage = item
		end
	end

	if state.carriage then
		-- Rest pose is stamped by the builder: immune to mid-motion binds.
		state.carriageRest = state.carriage:GetAttribute("RestCF")
		state.mouthPart = state.carriage:FindFirstChild("DropperMouth")
		-- Base size from the build stamp, NEVER the live part: a retry bind
		-- can land mid-pulse and would capture an inflated size as the base.
		state.mouthBaseSize = state.mouthPart
			and (state.mouthPart:GetAttribute("BaseSize") or state.mouthPart.Size) or nil
	end

	local marquee = cabinet:FindFirstChild("Marquee")
	if marquee then
		local gui = marquee:FindFirstChild("MarqueeGui")
		if gui then
			for _, label in ipairs(gui:GetChildren()) do
				if label:IsA("TextLabel") then
					state.letters[tonumber(label.Name:sub(2))] = label
				end
			end
		end
	end
	state.jackpotValue = machine:FindFirstChild("JackpotValue")
	local screen = cabinet:FindFirstChild("JackpotScreen")
	if screen then
		local gui = screen:FindFirstChild("JackpotGui")
		if gui then state.jackpotLabel = gui:FindFirstChild("Value") end
	end

	-- Twin press rigs: rest poses + per-part offsets stamped by the builder.
	for _, press in ipairs(playfield:GetChildren()) do
		if press:IsA("Model") and press.Name:sub(1, 5) == "Press" then
			local rest = press:GetAttribute("RestCF")
			if rest then
				local stamp = nil
				for _, part in ipairs(press:GetChildren()) do
					if part.Name:sub(1, 11) == "PusherStamp" then stamp = part end
				end
				table.insert(state.pusherGroups, {
					model = press,
					rest = rest,
					shift = press:GetAttribute("PhaseShift") or 0,
					stamp = stamp,
					stampSize = stamp and (stamp:GetAttribute("BaseSize") or stamp.Size) or nil,
				})
			end
		end
	end

	-- Fixed key list, NOT pairs(state): nil fields must overwrite stale
	-- references from the previous machine, and pairs() skips nils.
	for _, key in ipairs({
		"machine", "origin", "chaseL", "chaseR", "trayLeds", "bulbs", "winLine",
		"letters", "jackpotValue", "jackpotLabel", "carriage", "carriageRest",
		"mouthPart", "mouthBaseSize", "pusherGroups", "dome",
		"headerPlates", "headerFrames", "laneLeds", "laneFilms",
		"feverSegs", "poolGlow", "feverComet", "payBurst",
		"coreOrb", "coreLight", "coreRing", "chargeSegs",
		"moonlets", "emberVent", "emberEmit", "dustEmit",
		"potLabel", "coreTitle",
	}) do
		bound[key] = state[key]
	end

	-- Completeness: replication is not atomic — folders can arrive before
	-- their children, so a bind can catch a half-streamed machine. A rig is
	-- complete only when EVERY part the builder stamped has streamed in
	-- (the old ">= 5 children" guess let a bind start one part early).
	local function rigComplete(rig)
		if not rig then return false end
		local expected = rig:GetAttribute("PartCount")
		if not expected then return false end
		local have = 0
		for _, piece in ipairs(rig:GetChildren()) do
			if piece:GetAttribute("RO") then have = have + 1 end
		end
		return have >= expected
	end
	-- Chase segments land at name-derived indices, so streaming can leave
	-- holes mid-array; # on a sparse table is unreliable, count explicitly.
	local function ledFull(list)
		for i = 1, 10 do
			if not list[i] then return false end
		end
		return true
	end
	local complete = state.carriageRest ~= nil and rigComplete(state.carriage)
		and #state.pusherGroups == 2
		and rigComplete(state.pusherGroups[1].model)
		and rigComplete(state.pusherGroups[2].model)
		and ledFull(state.chaseL) and ledFull(state.chaseR)
	player:SetAttribute("BoundGroups", #state.pusherGroups)
	player:SetAttribute("BoundDropper", state.carriage ~= nil)
	return complete
end

-- Bind (and re-bind after zone switches) with a retry loop: keep re-scanning
-- until the machine has fully streamed in. This is what keeps the dropper
-- tracking and the press mirror frame-smooth after a zone rebuild. The loop
-- never gives up while the machine exists (a giving-up bind froze whatever
-- cosmetic FX had streamed by then); it fast-polls first, then relaxes.
local bindingMachine = nil

local function bindWhenComplete(machine)
	local tries = 0
	while machine.Parent and bindingMachine == machine do
		if bindMachine(machine) then return end
		tries = tries + 1
		task.wait(tries > 24 and 1 or 0.25)
	end
end

-- Single entry point for both the join-time machine and zone rebuilds. On
-- join, WaitForChild resolving and ChildAdded firing for the SAME instance
-- is a normal race — the bindingMachine token makes whichever lands second
-- a no-op, and the intro sweep is only cancelled when a machine was already
-- bound before (a real zone switch), never on first arrival.
task.spawn(function()
	local machine = workspace:WaitForChild("CoinPusher", 30)
	if machine and bindingMachine ~= machine then
		bindingMachine = machine
		bindWhenComplete(machine)
	end
end)
workspace.ChildAdded:Connect(function(child)
	if child.Name == "CoinPusher" and bindingMachine ~= child then
		if bindingMachine ~= nil then firstBind = false end
		bindingMachine = child
		task.spawn(bindWhenComplete, child)
	end
end)

--------------------------------------------------------------------------------
-- Camera
--------------------------------------------------------------------------------

do
	local introStart = os.clock()
	local INTRO_SECONDS = 2.2
	local introDone = false
	local parallax = Vector2.zero

	local function easeOutCubic(alpha)
		return 1 - (1 - alpha) ^ 3
	end

	RunService:BindToRenderStep("PusherCamera", Enum.RenderPriority.Camera.Value + 1, function(dt)
		local origin = bound.origin
		if not origin then return end
		camera.CameraType = Enum.CameraType.Scriptable
		camera.FieldOfView = CFG.camFov

		local now = os.clock()
		local viewport = camera.ViewportSize
		local mouse = UserInputService:GetMouseLocation()
		local ndcX = math.clamp((mouse.X / math.max(viewport.X, 1)) * 2 - 1, -1, 1)
		local ndcY = math.clamp((mouse.Y / math.max(viewport.Y, 1)) * 2 - 1, -1, 1)
		parallax = parallax:Lerp(Vector2.new(ndcX * 1.1, -ndcY * 0.5), 1 - math.exp(-dt * 5))
		local bob = math.sin(now * 0.45) * 0.05

		local eyeBase = origin * CFrame.new(CFG.camEye)
		local lookTarget = (origin * CFrame.new(CFG.camLook)).Position
		local eyePos = (eyeBase * CFrame.new(parallax.X, parallax.Y + bob, 0)).Position
		local goal = CFrame.lookAt(eyePos, lookTarget)

		-- Jackpot celebration shake (§B): 0.4s decaying jitter, ~0.18 studs,
		-- armed by the SlotHit(4, jackpot) handler via the shakeUntil stamp.
		-- S.shakeAmp (optional) lets callers pick a softer amplitude — the
		-- forge cinematic slams at 0.14; jackpot keeps the 0.18 default.
		-- S.reducedMotion (default false, settable later) kills the shake.
		local shakeUntil = (not S.reducedMotion) and (S.shakeUntil or 0) or 0
		if now < shakeUntil then
			local falloff = math.clamp((shakeUntil - now) / 0.4, 0, 1)
			local amp = (S.shakeAmp or 0.18) * falloff
			goal = goal * CFrame.new(
				(math.random() - 0.5) * 2 * amp,
				(math.random() - 0.5) * 2 * amp, 0)
		end

		if not introDone and firstBind then
			local alpha = math.clamp((now - introStart) / INTRO_SECONDS, 0, 1)
			if alpha >= 1 then
				introDone = true
				camera.CFrame = goal
			else
				local from = CFrame.lookAt((origin * CFrame.new(-16, 8.5, -17)).Position,
					origin.Position + Vector3.new(0, 7, 0))
				camera.CFrame = from:Lerp(goal, easeOutCubic(alpha))
			end
		else
			camera.CFrame = goal
		end
	end)
end

--------------------------------------------------------------------------------
-- Hide + park the local character
--------------------------------------------------------------------------------

do
	local function tameCharacter(character)
		local humanoid = character:WaitForChild("Humanoid", 5)
		if humanoid then
			humanoid.WalkSpeed = 0
			humanoid.JumpHeight = 0
			humanoid.JumpPower = 0
			humanoid.AutoRotate = false
			humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
		end
	end

	local hiddenParts = {}
	local function cacheCharacterParts(character)
		table.clear(hiddenParts)
		if not character then return end
		for _, descendant in ipairs(character:GetDescendants()) do
			if descendant:IsA("BasePart") or descendant:IsA("Decal") then
				table.insert(hiddenParts, descendant)
			end
		end
	end
	local function watchCharacter(character)
		tameCharacter(character)
		cacheCharacterParts(character)
		character.DescendantAdded:Connect(function()
			task.defer(cacheCharacterParts, character)
		end)
	end
	if player.Character then watchCharacter(player.Character) end
	player.CharacterAdded:Connect(watchCharacter)

	RunService.RenderStepped:Connect(function()
		for index = #hiddenParts, 1, -1 do
			local item = hiddenParts[index]
			if item.Parent then
				item.LocalTransparencyModifier = 1
			else
				table.remove(hiddenParts, index)
			end
		end
	end)
end

