-- Reel window height in DESIGN units. MANDATORY: AbsoluteSize is post-UIScale
-- SCREEN pixels, but reelStack.Position is an unscaled OFFSET — mixing them
-- put the landing row (1 - scale) * height / 2 off. At the 0.75 floor that is
-- ~57px against an 84px tile, so the win band highlighted the card NEXT to the
-- planet the server actually awarded (owner bug report: "it gives another like
-- above it"). Every win-line calculation goes through this.
local function reelWindowH()
	local s = math.max(hudScale.Scale, 0.01)
	local h = reelWindow.AbsoluteSize.Y / s
	-- Pre-layout (AbsoluteSize 0) fall back to the design formula so a roll
	-- fired on the first frame still lands centered. MUST match the
	-- reelWindow Size Y offset above.
	if h < TILE_H then
		h = math.max(camera.ViewportSize.Y / s - 224, TILE_H * 3)
	end
	return h
end

