				TweenService:Create(mini,
					TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
					{ Size = UDim2.fromOffset(110, 110), ImageTransparency = 1 }):Play()
				task.delay(0.4, function() mini:Destroy() end)
				forgeClink.PlaybackSpeed = 1 + math.min(shownCount, 12) * 0.04
				forgeClink:Play()
				held = math.max(held - 0.3, 0) -- counting extends the hold a beat
			end
		end
		breath:Cancel()

		-- ===== STAGE 10 — CLEANUP (0.25s): fade + Destroy; dequeue.
		TweenService:Create(dim, TweenInfo.new(0.25), { BackgroundTransparency = 1 }):Play()
		TweenService:Create(cardBloom, TweenInfo.new(0.25), { ImageTransparency = 1 }):Play()
		TweenService:Create(cardScale,
			TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In),
			{ Scale = 0.05 }):Play()
		task.wait(0.25)
		overlay:Destroy()
		celebrating = false
		currentRecipe = nil
		if queuedCombine then
			local nextUp = queuedCombine
			queuedCombine = nil
			task.spawn(runCelebration, nextUp[1], nextUp[2], nextUp[3], nextUp[4])
		elseif S.pokeRollQueue then
			-- Release any auto roll that queued behind the cinematic.
			S.pokeRollQueue()
		end
	end

	if combineDoneRemote then
		combineDoneRemote.OnClientEvent:Connect(function(name, tier, newForm, newPayout)
			tier = tier or 1
			newForm = newForm or 1
			if celebrating then
				local recipe = name .. "|" .. tier .. "|" .. newForm
				if recipe == currentRecipe and tier < 4 then
					-- FORGE MAX collapse: same-recipe repeats feed the
					-- counter (the full run already played once).
					burstExtra += 1
				else
					queuedCombine = { name, tier, newForm, newPayout or 0 } -- newest wins
				end
			else
				task.spawn(runCelebration, name, tier, newForm, newPayout or 0)
			end
		end)
	end
end)()

