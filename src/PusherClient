		-- Copy alignment with GameConfig.Products: the price reads the
		-- product's `robux`, the scope caption its `label` ("WHOLE SERVER")
		-- and timed pills derive from its `duration`, so a config edit lands
		-- here with no client change; the tables above stay as the fallback.
		local function prodPrice(key, fallback)
			local prod = S.productInfo(key)
			return "R$ " .. ((prod and prod.robux) or fallback)
		end
		local function prodScope(key, fallback)
			local prod = S.productInfo(key)
			return (prod and prod.label) or fallback
		end
		local function prodPill(key)
			local prod = S.productInfo(key)
			local secs = prod and prod.duration
			if secs then
				if secs >= 120 and secs % 60 == 0 then
					return ("%d MIN"):format(secs / 60)
				end
				return ("%d SEC"):format(secs)
			end
			return PILLS[key]
		end

		-- ---- Small builders (all local to this page).
		-- Pixel card row: plate + dither on a transparent row.
		local function pixelRow(height, face, dither)
			local row = makeRow(height)
			row.BackgroundTransparency = 1
			pixelPlate(row, face, 21, "card", 3)
			pixelDither(row, 22, dither or 0.5)
			return row
