-- Rebuilt per roll: random rollable catalog balls + the WON ball at the
-- target slot. Odds are computed ONCE per build from planetChances at the
-- CURRENT luck + paid-boost magnitude. Pass wonName = nil for idle fill.
local function buildReelTiles(wonName, wonTier)
	reelStack:ClearAllChildren()
	wonCardPulse = nil
	local oneInByKey = {}
	pcall(function()
		for _, chance in ipairs(PusherMachine.planetChances(currentLuck(), currentBoostMag(), currentMods())) do
			oneInByKey[chance.name .. "|" .. chance.tier] = chance.oneIn
		end
	end)
	for i = 1, REEL_TILES do
		local spec
		if i == ROLL_TARGET and wonName then
			-- The WON slot must NEVER fall back to random filler: the server's
			-- result is the single source of truth for what the reel stops on.
			spec = planetLookup[wonName .. "|" .. wonTier]
				or PusherMachine.findSpec(wonName, tonumber(wonTier))
			if not spec then
				warn("[Roller] won spec missing from catalog: " .. tostring(wonName) .. "|" .. tostring(wonTier))
				-- Degrade, don't error: catalog-shaped stand-in (b is a
				-- 1-based RGB array like every Planets entry, no rg) so
				-- makePlanetIcon renders a plain grey orb.
				spec = { n = tostring(wonName), t = tonumber(wonTier) or 1, b = { 200, 200, 210 } }
			end
		end
		if not spec then
			spec = rollablePlanets[math.random(#rollablePlanets)]
		end
		local tier = spec.t or 1
		local key = spec.n .. "|" .. tier
		local tierInfo = PusherMachine.Tiers[tier] or PusherMachine.Tiers[1]
		local entry = invByKey[key]
		-- Instrument Deck card: pixel plate + 52px occlusion-correct planet
		-- + 14px name + 12px rarity pill + 12px honest odds. All one unit.
