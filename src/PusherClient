		if ui and (ui.state == 3 or ui.state == 4) and buyRemote then
			buyRemote:FireServer(def.id)
		end
	end)

	function S.updateTreeStates()
		local tickets = player:GetAttribute("Tickets") or 0
		local rebirth = player:GetAttribute("Rebirth") or 0
		local zone = remotes and remotes:GetAttribute("Zone") or 1
		local affordable = 0
		local cheapest, cheapestCost = nil, math.huge
		local fallback, fallbackCost = nil, math.huge
		for _, def in ipairs(GameConfig.UpgradeTree) do
			local ui = treeNodes[def.id]
			local lv = player:GetAttribute(def.id) or 0
			local maxed = lv >= def.maxLv
			local cost = maxed and 0 or GameConfig.treeCost(def, lv)
			local requiresMet = true
			local parentStarted = #def.requires == 0
			local reqName = nil
			for _, req in ipairs(def.requires) do
				local plv = player:GetAttribute(req.id) or 0
				if plv >= 1 then parentStarted = true end
				if plv < req.lv then
					requiresMet = false
					if not reqName then
						local from = GameConfig.TreeById[req.id]
						reqName = from and from.name or req.id
					end
				end
			end
			local gateMet, gateText = true, nil
			if def.gate then
				if def.gate.rebirth and rebirth < def.gate.rebirth then
					gateMet = false
					gateText = "REACHES AT REBIRTH " .. def.gate.rebirth
				elseif def.gate.zone and zone < def.gate.zone then
					gateMet = false
					gateText = "REACHES AT ZONE " .. def.gate.zone
				end
			end
			-- States: 1 locked-hidden "?", 2 locked-visible, 3 unaffordable,
			-- 4 affordable (glow), 5 maxed.
			local state
			if lv <= 0 and not parentStarted then
				state = 1
			elseif not (requiresMet and gateMet) then
				state = 2
			elseif maxed then
				state = 5
			elseif tickets >= cost then
				state = 4
			else
				state = 3
			end
			ui.state = state
			local mystery = state == 1
			ui.qLabel.Visible = mystery
			ui.nameLabel.Visible = not mystery
			ui.lvLabel.Visible = not mystery and state ~= 2
			ui.costPill.Visible = state == 3 or state == 4
			ui.maxBadge.Visible = state == 5
			ui.gateLabel.Visible = state == 2
			ui.hexStroke.Transparency = state == 5 and 0.2 or 1
			if mystery then
				ui.hex.ImageColor3 = LOCKED_TINT
			elseif state == 2 then
				ui.hex.ImageColor3 = ui.color:Lerp(LOCKED_TINT, 0.65)
			else
				ui.hex.ImageColor3 = ui.color
			end
			-- Lit hexes (states 3-5) are tinted the branch color, so the
			-- labels flip DARK there — but ONLY when the tile is actually
			-- BRIGHT. Branch colors like deep green are dark tiles: dark
			-- text on them was unreadable (owner screenshot). Luminance
			-- decides; dark tiles get WHITE text with a black glyph stroke.
			-- The HEX bitmap is dark art (~55% brightness), so even a gold
			-- tint renders as a mid-dark tile: WHITE with a black glyph
			-- stroke is the one combination readable on EVERY lit tint
			-- (verified against green/rust/gold live).
			local lit = state >= 3
			ui.nameLabel.TextColor3 = lit and Color3.new(1, 1, 1) or ui.color
			ui.nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
			ui.nameLabel.TextStrokeTransparency = lit and 0.3 or 1
			ui.lvLabel.TextColor3 = lit and Color3.new(1, 1, 1) or UI_TEXT
			ui.lvLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
			ui.lvLabel.TextStrokeTransparency = lit and 0.3 or 1
			ui.glow.Visible = state == 4
			if not mystery then
				ui.lvLabel.Text = "Lv " .. lv .. "/" .. def.maxLv
			end
			if state == 2 then
				ui.gateLabel.Text = gateText or ("REQUIRES " .. (reqName or "?"):upper())
			end
			if state == 3 or state == 4 then
				ui.costText.Text = tostring(cost)
				ui.costText.TextColor3 = state == 4 and UI_GOLD or Color3.fromRGB(235, 120, 120)
			end
			if state == 4 then
				affordable = affordable + 1
				if cost < cheapestCost then cheapest, cheapestCost = def, cost end
			elseif state == 3 and cost < fallbackCost then
				fallback, fallbackCost = def, cost
			end
		end
		cheapestNode = cheapest or fallback
		affordLabel.Text = affordable .. " AFFORDABLE"
		affordLabel.TextColor3 = affordable > 0 and UI_GREEN or UI_SUB
		treeBalLabel.Text = tostring(tickets)
		for _, linkInfo in ipairs(treeLinks) do
			local owned
			if linkInfo.throneLv ~= nil then
				owned = (player:GetAttribute("ThroneLevel") or 0) >= linkInfo.throneLv
			elseif linkInfo.fromId then
				owned = (player:GetAttribute(linkInfo.fromId) or 0) >= 1
			else
				owned = true
			end
			linkInfo.frame.BackgroundColor3 = owned and UI_GOLD or Color3.fromRGB(70, 74, 100)
		end
		local throneLevel = player:GetAttribute("ThroneLevel") or 0
		for _, tn in ipairs(throneNodes) do
			local ownedThrone = throneLevel >= tn.throne.level
			local gateHit = rebirth >= tn.throne.gate.rebirth
			tn.hex.ImageColor3 = ownedThrone and UI_GOLD
				or (gateHit and Color3.fromRGB(210, 180, 110) or LOCKED_TINT)
			tn.gateLabel.Visible = not ownedThrone
			-- White + black stroke on tinted hexes (the dark hex bitmap
			-- renders every tint mid-dark; dark text was unreadable live).
			local tinted = ownedThrone or gateHit
			tn.nameLabel.TextColor3 = tinted and Color3.new(1, 1, 1) or UI_GOLD
			tn.nameLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
			tn.nameLabel.TextStrokeTransparency = tinted and 0.3 or 1
			tn.descLabel.TextColor3 = tinted and Color3.new(1, 1, 1) or UI_TEXT
			tn.descLabel.TextStrokeColor3 = Color3.new(0, 0, 0)
			tn.descLabel.TextStrokeTransparency = tinted and 0.3 or 1
		end
		refreshNodeCard()
	end

	-- Pan (drag + touch-drag, clamped). Deltas and clip sizes are converted back
	-- to pre-HudScale offset units.
	local function clampCanvas(x, y)
		local scaleNow = math.max(hudScale.Scale, 0.01)
		local clipW = canvasClip.AbsoluteSize.X / scaleNow
		local clipH = canvasClip.AbsoluteSize.Y / scaleNow
		x = math.clamp(x, math.min(0, clipW - GameConfig.TreeCanvas.w * treeZoom), 0)
		-- 90px band reserved for the docked node card: the lowest nodes must
		-- be able to scroll clear of it at any zoom.
		y = math.clamp(y, math.min(0, clipH - 90 - GameConfig.TreeCanvas.h * treeZoom), 0)
		return x, y
	end

	-- ROTATED frames escape ClipsDescendants, so the link lines painted
	-- outside the panel while panning. Cull instead of clip: a line renders
	-- only while its segment's box overlaps the visible window (+margin so
	-- ends never pop mid-screen). ~85 links, cheap enough to run per pan step.
	local function updateLineCulling()
		local scaleNow = math.max(hudScale.Scale, 0.01)
		local clipW = canvasClip.AbsoluteSize.X / scaleNow
		local clipH = canvasClip.AbsoluteSize.Y / scaleNow
		local px = treeCanvas.Position.X.Offset
		local py = treeCanvas.Position.Y.Offset
		local margin = 60
		for _, link in ipairs(treeLinks) do
			local x0 = math.min(link.ax, link.bx) * treeZoom + px
			local x1 = math.max(link.ax, link.bx) * treeZoom + px
			local y0 = math.min(link.ay, link.by) * treeZoom + py
			local y1 = math.max(link.ay, link.by) * treeZoom + py
			link.frame.Visible = x1 > -margin and x0 < clipW + margin
				and y1 > -margin and y0 < clipH + margin
		end
	end
	-- One hook covers drags, zooms, centering AND tweens mid-flight.
	treeCanvas:GetPropertyChangedSignal("Position"):Connect(updateLineCulling)
	canvasClip:GetPropertyChangedSignal("AbsoluteSize"):Connect(updateLineCulling)

	-- Zoom about the clip center so the view doesn't lurch.
	local function setTreeZoom(newZoom)
		newZoom = math.clamp(newZoom, 0.55, 1.25)
		if newZoom == treeZoom then return end
		local scaleNow = math.max(hudScale.Scale, 0.01)
		local clipW = canvasClip.AbsoluteSize.X / scaleNow
		local clipH = canvasClip.AbsoluteSize.Y / scaleNow
		local cx = (clipW / 2 - treeCanvas.Position.X.Offset) / treeZoom
		local cy = (clipH / 2 - treeCanvas.Position.Y.Offset) / treeZoom
		treeZoom = newZoom
		treeZoomInst.Scale = newZoom
		local x, y = clampCanvas(clipW / 2 - cx * newZoom, clipH / 2 - cy * newZoom)
		treeCanvas.Position = UDim2.fromOffset(x, y)
		-- Direct call: a zoom at a clamp corner can leave Position unchanged,
		-- so the Position signal alone would miss the wider visible window.
		updateLineCulling()
	end

	local treeDragging = false
	local dragOrigin = nil
	local canvasOrigin = nil
	canvasClip.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			treeDragging = true
			nodeDidPan = false
			dragOrigin = input.Position
			canvasOrigin = treeCanvas.Position
		end
	end)
	UserInputService.InputChanged:Connect(function(input)
		if not treeDragging then return end
		if input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch then
			local delta = input.Position - dragOrigin
			if delta.Magnitude > 6 then nodeDidPan = true end
			local scaleNow = math.max(hudScale.Scale, 0.01)
			local x, y = clampCanvas(
				canvasOrigin.X.Offset + delta.X / scaleNow,
				canvasOrigin.Y.Offset + delta.Y / scaleNow)
			treeCanvas.Position = UDim2.fromOffset(x, y)
		end
	end)
	canvasClip.InputChanged:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseWheel then
			setTreeZoom(treeZoom + input.Position.Z * 0.1)
		end
	end)
	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			treeDragging = false
			-- Cleared a beat later so the suppressed click sees the flag.
			task.delay(0.05, function()
				if not treeDragging then nodeDidPan = false end
			end)
		end
	end)

	local function centerCanvasOn(x, y, animate)
		local scaleNow = math.max(hudScale.Scale, 0.01)
		local clipW = canvasClip.AbsoluteSize.X / scaleNow
		local clipH = canvasClip.AbsoluteSize.Y / scaleNow
		local cx, cy = clampCanvas(clipW / 2 - x * treeZoom, clipH / 2 - y * treeZoom)
		if animate then
			TweenService:Create(treeCanvas,
				TweenInfo.new(0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
				{ Position = UDim2.fromOffset(cx, cy) }):Play()
		else
			treeCanvas.Position = UDim2.fromOffset(cx, cy)
		end
	end

	cheapestBtn.MouseButton1Click:Connect(function()
		local def = cheapestNode
		if not def then return end
		centerCanvasOn(def.pos.x, def.pos.y, true)
		if showNodeCard then showNodeCard(def) end
		local ui = treeNodes[def.id]
		if ui then
			task.spawn(function()
				for _ = 1, 2 do
					local up = TweenService:Create(ui.pulseScale,
						TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1.18 })
					up:Play()
					up.Completed:Wait()
					local down = TweenService:Create(ui.pulseScale,
						TweenInfo.new(0.18, Enum.EasingStyle.Quad, Enum.EasingDirection.In), { Scale = 1 })
					down:Play()
					down.Completed:Wait()
				end
			end)
		end
	end)

	local treeCentered = false
