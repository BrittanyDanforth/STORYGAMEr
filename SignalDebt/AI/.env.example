# Documentation only: relay.py reads process environment, not this file.
# Set values in your shell; do not package a real key with the Unity project.
OPENAI_API_KEY=your_api_key_here
SIGNAL_DEBT_AI_MODEL=gpt-6-luna
SIGNAL_DEBT_AI_REASONING=none
SIGNAL_DEBT_AI_PORT=8765
SIGNAL_DEBT_AI_TIMEOUT=6
SIGNAL_DEBT_AI_CALL_LIMIT=100
SIGNAL_DEBT_AI_REQUESTS_PER_MINUTE=20
SIGNAL_DEBT_AI_ENABLE_ESCALATION=0
SIGNAL_DEBT_AI_ESCALATION_MODEL=gpt-6.1-sol
